---
import { getCollection } from "astro:content";
import Logo from "@/components/Logo.astro";
import TrainingMegaMenuDesktop from "@/components/TrainingMegaMenuDesktop.astro";
import TrainingMegaMenuMobile from "@/components/TrainingMegaMenuMobile.astro";
import { resolveLocale, useTranslations } from "@/i18n/utils";
import { localeOfId } from "@/lib/i18n";
import { mobileNavIcons } from "@/data/mobileNavIcons";

interface Props {
  /** Same shape as BaseLayout's own prop -- passed straight through so the
   * language switcher can link to the exact equivalent page rather than
   * just the other language's homepage. Absent on pages with no German
   * counterpart, where the switcher falls back to the current page itself. */
  translations?: Partial<Record<"en" | "de", string>>;
}

const { translations } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const prefix = locale === "de" ? "/de" : "";

const navLinks = [
  // mobileOnly since the logo already covers "go home" on desktop; only
  // the mobile drawer needs an explicit row for it.
  { href: "/", label: t("breadcrumb.home"), translated: true, mobileOnly: true, icon: "home" as const },
  { href: "/services", label: t("nav.services"), translated: true, icon: "services" as const },
  { href: "/training", label: t("nav.training"), mega: true, translated: true, icon: "training" as const },
  { href: "/insights", label: t("nav.insights"), translated: true, icon: "insights" as const },
  { href: "/about", label: t("nav.about"), translated: true, icon: "about" as const },
  // Desktop already has the lime "Contact us" button; keep this entry only
  // for the mobile menu, where that button is hidden below the sm breakpoint.
  { href: "/contact", label: t("nav.contact"), translated: true, mobileOnly: true, icon: "contact" as const },
];

const currentPath = Astro.url.pathname;

const categories = (await getCollection("training-categories", (c) => localeOfId(c.id) === locale)).sort(
  (a, b) => a.data.order - b.data.order
);
const allCourses = await getCollection("training-courses", (c) => localeOfId(c.id) === locale);
const categoriesWithCourses = categories.map((category) => ({
  category,
  courses: allCourses
    .filter((c) => c.data.category.id === category.id)
    .sort((a, b) => (a.data.sortOrder ?? 99) - (b.data.sortOrder ?? 99)),
}));

// Falls back to the current page itself when this locale's counterpart is
// missing (translations prop omitted, e.g. an Insights article with no
// German translation yet) -- same "no translation yet? stay on what
// exists" idiom as localizedArticle() elsewhere, rather than dropping the
// visitor at the homepage and losing their place. The EN link in
// particular should never need a fallback at all on an English page (we're
// already on it), which the old "/" default got wrong.
const enHref = translations?.en ?? currentPath;
const deHref = translations?.de ?? currentPath;
---

<header class="sticky top-0 z-50 border-b border-neutral-200 bg-surface/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-6 py-4">
    <a href={prefix || "/"}>
      <Logo size="medium" />
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-8 md:flex">
      {
        navLinks
          .filter((link) => !link.mobileOnly)
          .map((link) => {
            const href = link.translated ? `${prefix}${link.href}` : link.href;
            const isActive = href === "/" ? currentPath === "/" : currentPath.startsWith(href);
            const linkClass = `flex items-center gap-1 border-b-2 pb-1 text-sm font-medium transition-colors hover:text-ink ${
              isActive ? "border-lime text-ink" : "border-transparent text-neutral-600"
            }`;

            if (link.mega) {
              return (
                <div class="group relative">
                  <a href={href} class={linkClass} aria-current={isActive ? "page" : undefined}>
                    {link.label}
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      class="h-3.5 w-3.5 shrink-0 transition-transform group-hover:rotate-180"
                    >
                      <path d="m6 9 6 6 6-6" />
                    </svg>
                  </a>
                  <TrainingMegaMenuDesktop categoriesWithCourses={categoriesWithCourses} />
                </div>
              );
            }

            return (
              <a href={href} class={linkClass} aria-current={isActive ? "page" : undefined}>
                {link.label}
              </a>
            );
          })
      }
    </nav>

    <div class="flex items-center gap-3">
      <div
        class="hidden items-center gap-0.5 rounded-[var(--radius-pill)] border border-neutral-300 p-0.5 text-xs font-semibold sm:flex"
        aria-label={t("nav.langSwitcherLabel")}
      >
        <a
          href={enHref}
          aria-current={locale === "en" ? "true" : undefined}
          class={`rounded-[var(--radius-pill)] px-2.5 py-1 transition-colors ${
            locale === "en" ? "bg-ink text-surface" : "text-neutral-600 hover:text-ink"
          }`}
        >
          EN
        </a>
        <a
          href={deHref}
          aria-current={locale === "de" ? "true" : undefined}
          class={`rounded-[var(--radius-pill)] px-2.5 py-1 transition-colors ${
            locale === "de" ? "bg-ink text-surface" : "text-neutral-600 hover:text-ink"
          }`}
        >
          DE
        </a>
      </div>

      <a
        href={`${prefix}/contact`}
        class="hidden items-center gap-1.5 rounded-[var(--radius-pill)] bg-lime px-5 py-2.5 text-sm font-semibold text-ink transition-colors hover:bg-lime/85 sm:inline-flex"
      >
        {t("nav.contactCta")}
        <span aria-hidden="true">→</span>
      </a>

      <details class="md:hidden">
        <summary
          class="cursor-pointer list-none rounded-[var(--radius-control)] border border-neutral-300 px-3 py-2 text-sm font-medium transition-colors hover:bg-mist-light"
        >
          {t("nav.menu")}
        </summary>
        <nav
          aria-label="Primary mobile"
          class="absolute inset-x-0 top-full flex flex-col gap-1 border-b border-neutral-200 bg-surface px-6 py-4 shadow-card"
        >
          {
            navLinks.map((link) => {
              const href = link.translated ? `${prefix}${link.href}` : link.href;
              return link.mega ? (
                <TrainingMegaMenuMobile categoriesWithCourses={categoriesWithCourses} icon={mobileNavIcons[link.icon]} />
              ) : (
                <a href={href} class="flex items-center gap-2.5 py-2 text-sm font-medium text-neutral-700">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="h-4 w-4 shrink-0 text-neutral-500"
                    set:html={mobileNavIcons[link.icon]}
                  />
                  {link.label}
                </a>
              );
            })
          }
          <div class="mt-2 flex items-center gap-0.5 self-start rounded-[var(--radius-pill)] border border-neutral-300 p-0.5 text-xs font-semibold">
            <a
              href={enHref}
              class={`rounded-[var(--radius-pill)] px-2.5 py-1 ${locale === "en" ? "bg-ink text-surface" : "text-neutral-600"}`}
            >
              EN
            </a>
            <a
              href={deHref}
              class={`rounded-[var(--radius-pill)] px-2.5 py-1 ${locale === "de" ? "bg-ink text-surface" : "text-neutral-600"}`}
            >
              DE
            </a>
          </div>
        </nav>
      </details>
    </div>
  </div>
</header>
