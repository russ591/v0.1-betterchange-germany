---
// FAQ accordion for course pages, driven entirely by src/content/course-faqs
// (one YAML file per locale; the text there is Russ's approved wording and
// must stay verbatim). Which questions show is decided by the data file's
// own rules plus three facts about the page:
//   - general questions only when at least one upcoming date is booked
//     through this site (internal registration, self-paced included),
//   - the course-family block for whichever family lists this course,
//   - the partner note when at least one upcoming date is external.
// Renders nothing when none of those apply. Emits FAQPage structured data
// for the questions actually shown.
import type { CollectionEntry } from "astro:content";
import { getEntry } from "astro:content";
import Section from "@/components/Section.astro";
import { baseSlug } from "@/lib/i18n";
import { resolveLocale } from "@/i18n/utils";

interface Props {
  course: CollectionEntry<"training-courses">;
  category: CollectionEntry<"training-categories">;
  upcoming: CollectionEntry<"training-schedules">[];
}

type Question = CollectionEntry<"course-faqs">["data"]["general"][number];

const { course, category, upcoming } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const faq = (await getEntry("course-faqs", locale))!.data;

const courseId = baseSlug(course.id);
const categoryId = baseSlug(category.id);
const formats = course.data.formats;
const hasInternalDates = upcoming.some((s) => !s.data.isExternal);
const hasExternalDates = upcoming.some((s) => s.data.isExternal);

const applies = (q: Question) =>
  (!q.formats || q.formats.some((f) => formats.includes(f))) &&
  (!q.onlyCategories || q.onlyCategories.includes(categoryId)) &&
  (!q.excludeCategories || !q.excludeCategories.includes(categoryId)) &&
  (!q.onlyCourses || q.onlyCourses.includes(courseId));

const general = hasInternalDates ? faq.general.filter(applies) : [];
const family = faq.families.find((f) => f.courses.includes(courseId));
const familyQuestions = family ? family.questions.filter(applies) : [];
const items = [...general, ...familyQuestions];
const show = items.length > 0 || hasExternalDates;

const structuredData = items.length
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: items.map((q) => ({
        "@type": "Question",
        name: q.question,
        acceptedAnswer: { "@type": "Answer", text: q.answer },
      })),
    }
  : null;
---

{
  show && (
    <Section heading={faq.heading} id="faq" class="border-t border-neutral-200">
      {items.length > 0 && (
        <div class="max-w-3xl divide-y divide-neutral-200 border-y border-neutral-200">
          {items.map((q) => (
            <details class="group py-4">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-[length:var(--text-body)] font-semibold text-ink [&::-webkit-details-marker]:hidden">
                <span>{q.question}</span>
                <span aria-hidden="true" class="shrink-0 text-xl leading-none text-neutral-400 transition-transform group-open:rotate-45">
                  +
                </span>
              </summary>
              <p class="mt-3 max-w-2xl text-[length:var(--text-small)] leading-relaxed text-neutral-600">{q.answer}</p>
            </details>
          ))}
        </div>
      )}
      {hasExternalDates && <p class="mt-6 max-w-3xl text-[length:var(--text-small)] leading-relaxed text-neutral-500">{faq.partnerNote}</p>}
      {structuredData && <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />}
    </Section>
  )
}
