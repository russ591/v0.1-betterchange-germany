---
import { formatIcons } from "@/data/formatDetails";

interface Props {
  format: "in-person" | "live-online" | "self-paced";
  class?: string;
}

const { format, class: className = "" } = Astro.props;

const labels: Record<Props["format"], string> = {
  "in-person": "In-person",
  "live-online": "Live online",
  "self-paced": "Self-paced",
};

// In-person gets the lime tint -- lime is already the site's interactive/
// primary color elsewhere (filter buttons, CTAs). Live online stays the
// original neutral pill. Self-paced gets a gold tint -- de-gold was
// previously only a decorative flag-stripe color, so this is a deliberate,
// small extension of its use to a second, still-schedule-related context.
// The icons are the same ones already used in the course-detail "How to
// take this course" sections (see ../data/formatDetails.ts).
const styles: Record<Props["format"], string> = {
  "in-person": "border-lime/60 bg-lime/20 text-ink",
  "live-online": "border-neutral-300 bg-neutral-50 text-neutral-700",
  "self-paced": "border-de-gold/50 bg-de-gold/15 text-neutral-800",
};
---

<span
  class={`inline-flex items-center gap-1.5 whitespace-nowrap rounded-[var(--radius-pill)] border px-3 py-1 text-[var(--text-caption)] font-medium [&_svg]:h-3.5 [&_svg]:w-3.5 [&_svg]:shrink-0 ${styles[format]} ${className}`}
>
  <span set:html={formatIcons[format]} />
  {labels[format]}
</span>
