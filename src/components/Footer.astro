---
import { getCollection } from "astro:content";
import Logo from "@/components/Logo.astro";
import { resolveLocale, useTranslations } from "@/i18n/utils";
import { localeOfId, baseSlug } from "@/lib/i18n";

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const prefix = locale === "de" ? "/de" : "";

const categories = (await getCollection("training-categories", (c) => localeOfId(c.id) === locale)).sort(
  (a, b) => a.data.order - b.data.order
);

const year = new Date().getFullYear();
---

<footer class="bg-ink">
  <div class="mx-auto max-w-6xl px-6 py-16">
    <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-2">
        <a href={prefix || "/"}>
          <Logo tone="light" />
        </a>
        <p class="mt-4 max-w-sm text-[length:var(--text-small)] text-neutral-400">{t("footer.tagline")}</p>
      </div>

      <div>
        <p class="eyebrow text-lime">{t("footer.trainingHeading")}</p>
        <ul class="mt-4 space-y-2 text-[length:var(--text-small)]">
          {
            categories.map((category) => (
              <li>
                <a href={`${prefix}/training/${baseSlug(category.id)}`} class="text-neutral-400 hover:text-surface">
                  {category.data.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="eyebrow text-lime">{t("footer.companyHeading")}</p>
        <ul class="mt-4 space-y-2 text-[length:var(--text-small)]">
          <li><a href={`${prefix}/services`} class="text-neutral-400 hover:text-surface">{t("nav.services")}</a></li>
          <li><a href={`${prefix}/about`} class="text-neutral-400 hover:text-surface">{t("nav.about")}</a></li>
          <li><a href="/insights" class="text-neutral-400 hover:text-surface">{t("nav.insights")}</a></li>
          <li><a href={`${prefix}/contact`} class="text-neutral-400 hover:text-surface">{t("nav.contact")}</a></li>
        </ul>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col gap-4 border-t border-neutral-800 pt-8 text-[length:var(--text-caption)] text-neutral-400 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {year} Better Change. {t("footer.rights")}</p>
      <div class="flex gap-6">
        <a href="/impressum" class="hover:text-surface">Impressum</a>
        <a href="/datenschutz" class="hover:text-surface">Datenschutz</a>
        <a href="/agb" class="hover:text-surface">AGB</a>
      </div>
    </div>
  </div>
</footer>
