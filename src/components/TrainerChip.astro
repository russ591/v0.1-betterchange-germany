---
import { toPathSegment } from "@/lib/urlSlug";
import type { TrainerEntry } from "@/lib/trainers";

// Compact avatar+name chip -- used wherever a trainer needs to be
// mentioned inline rather than as a full TeamCard (the course page's
// per-session trainer line, the registration page's "Your trainer" block).
// A profile-backed trainer links out the same way TeamCard does by
// default (its own page if it has one, otherwise LinkedIn); the rare
// plain-name fallback (no migrated profile at all) renders as unlinked
// text with no avatar.
//
// density controls the visual style only: "chip" is the bordered pill,
// "plain" is bare avatar+text. linkable is separate because the course
// page nests this inside a session row that's itself an <a> -- nesting an
// <a> there would be invalid HTML, so that caller passes linkable={false}
// even though it wants the "plain" look; the registration page wants the
// same plain look but stays linkable since it isn't inside another link.
// linkedinFallback governs only the sub-case of a linkable, profile-backed
// trainer with no full profile page: the schedule listings (training hub,
// full schedule) pass linkedinFallback={false} there so a browsing table
// never sends a visitor off-site to a personal LinkedIn profile -- it
// falls back to unlinked plain text instead, same as the no-profile-at-all
// case. Other callers (TeamCard-adjacent contexts) keep the LinkedIn
// fallback since linking out is the whole point there.
interface Props {
  trainer: TrainerEntry;
  density?: "chip" | "plain";
  linkable?: boolean;
  showLabel?: boolean;
  linkedinFallback?: boolean;
}

const { trainer, density = "chip", linkable = true, showLabel = false, linkedinFallback = true } = Astro.props;

const href =
  linkable && trainer.kind === "profile"
    ? trainer.profile.data.hasFullProfile
      ? `/about/${toPathSegment(trainer.profile.data.urlSlug ?? trainer.profile.id)}`
      : linkedinFallback
        ? trainer.profile.data.linkedinUrl
        : undefined
    : undefined;
const isExternal = trainer.kind === "profile" && !trainer.profile.data.hasFullProfile && Boolean(trainer.profile.data.linkedinUrl);
const Wrapper = href ? "a" : "span";

const initials =
  trainer.kind === "profile"
    ? (() => {
        const parts = trainer.profile.data.name.split(" ");
        return parts.length > 1 ? parts[0][0] + parts[parts.length - 1][0] : parts[0].slice(0, 2);
      })()
    : "";
---

{
  trainer.kind === "profile" ? (
    <Wrapper
      href={href}
      target={isExternal ? "_blank" : undefined}
      rel={isExternal ? "noopener noreferrer" : undefined}
      class={
        density === "chip"
          ? "inline-flex items-center gap-2 rounded-[var(--radius-pill)] border border-neutral-200 bg-surface py-1 pl-1 pr-3 text-[length:var(--text-caption)] font-semibold text-ink transition-colors hover:border-ink"
          : `inline-flex items-center gap-1.5 text-[length:var(--text-caption)] text-neutral-600 ${href ? "hover:text-ink hover:underline" : ""}`
      }
    >
      {trainer.profile.data.photo ? (
        <span class={`relative block shrink-0 overflow-hidden rounded-full ${density === "chip" ? "h-6 w-6" : "h-[18px] w-[18px]"}`}>
          <img
            src={trainer.profile.data.photo}
            alt=""
            class="absolute inset-0 h-full w-full object-cover"
            loading="lazy"
            onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"
          />
          <span
            aria-hidden="true"
            style="display:none"
            class={`absolute inset-0 items-center justify-center rounded-full border border-lime font-bold ${density === "chip" ? "text-[10px]" : "text-[8px]"}`}
          >
            {initials}
          </span>
        </span>
      ) : (
        <span
          aria-hidden="true"
          class={`flex shrink-0 items-center justify-center rounded-full border border-lime font-bold ${
            density === "chip" ? "h-6 w-6 text-[10px]" : "h-[18px] w-[18px] text-[8px]"
          }`}
        >
          {initials}
        </span>
      )}
      {showLabel ? `Trainer: ${trainer.profile.data.name}` : trainer.profile.data.name}
    </Wrapper>
  ) : (
    <span class="text-[length:var(--text-caption)] text-neutral-600">
      {showLabel ? `Trainer: ${trainer.name}` : trainer.name}
    </span>
  )
}
