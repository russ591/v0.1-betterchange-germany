---
import type { CollectionEntry } from "astro:content";
import { toPathSegment } from "@/lib/urlSlug";
import { localeOfId, baseSlug } from "@/lib/i18n";
import { useTranslations } from "@/i18n/utils";

interface Props {
  article: CollectionEntry<"insights-articles">;
  showDate?: boolean;
  // Pre-resolved byline (the caller already looked up the author reference,
  // since several pages need that same lookup for their own filtering/
  // grouping) -- omit to render the card with no byline, as before.
  author?: { name: string; photo?: string };
}

const { article, showDate = true, author } = Astro.props;
const { title, date, readTimeMinutes, contentType, excerpt, primaryCategory, imageUrl } = article.data;

// Cards mix locales during the ongoing article-by-article translation
// (a German page can show an English card as a fallback, and vice versa
// for a "related" list), so href/date go by the article's OWN locale
// rather than the page it happens to render on -- otherwise a German
// article's card would link to a /insights/... 404 when shown on an
// English fallback list, or vice versa.
const articleLocale = localeOfId(article.id);
const articlePrefix = articleLocale === "de" ? "/de" : "";
const t = useTranslations(articleLocale);

// Real article photography exists for most articles (migrated from the Wix
// imageUrl field); a deterministic duotone placeholder (picked from the
// slug) stands in for the remainder, so the grid still has visual rhythm.
const positions = ["30% 20%", "70% 30%", "40% 70%", "60% 60%"];
const hash = [...article.id].reduce((sum, ch) => sum + ch.charCodeAt(0), 0);
const position = positions[hash % positions.length];

const initials = author?.name
  .split(" ")
  .map((w) => w[0])
  .slice(0, 2)
  .join("")
  .toUpperCase();
---

<a
  href={`${articlePrefix}/insights/${toPathSegment(article.data.urlSlug ?? baseSlug(article.id))}`}
  class="flex flex-col overflow-hidden rounded-[var(--radius-card)] border border-neutral-200 bg-surface shadow-card transition-shadow hover:shadow-card-hover"
>
  {
    imageUrl ? (
      <div class="aspect-[16/10] w-full overflow-hidden">
        <img src={imageUrl} alt="" class="h-full w-full object-cover" loading="lazy" />
      </div>
    ) : (
      <div
        aria-hidden="true"
        class="relative aspect-[16/10] w-full overflow-hidden"
        style={`background: radial-gradient(circle at ${position}, rgba(154,255,91,0.5), transparent 55%), linear-gradient(135deg, #14200c, #37452a);`}
      />
    )
  }
  <div class="flex flex-1 flex-col p-6">
    <p class="eyebrow">
      {
        [
          showDate &&
            date.toLocaleDateString(articleLocale === "de" ? "de-DE" : "en-GB", {
              day: "numeric",
              month: "short",
              year: "numeric",
            }),
          readTimeMinutes && `${readTimeMinutes} ${t("insights.minRead")}`,
          contentType && contentType !== "Blog" && contentType,
        ]
          .filter(Boolean)
          .join(" · ")
      }
    </p>
    <h3 class="mt-2 text-[length:var(--text-h4)]">{title}</h3>
    <p class="mt-2 line-clamp-3 text-[length:var(--text-small)] text-neutral-600">{excerpt}</p>
    {primaryCategory && <p class="mt-3 text-[length:var(--text-caption)] font-semibold text-neutral-600">{primaryCategory}</p>}
    {
      author && (
        <div class="mt-auto flex items-center gap-2 pt-4">
          {author.photo ? (
            <img src={author.photo} alt="" class="h-7 w-7 shrink-0 rounded-full object-cover" />
          ) : (
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-neutral-200 text-[10px] font-semibold text-neutral-600">
              {initials}
            </span>
          )}
          <span class="text-[length:var(--text-caption)] font-semibold text-neutral-700">{author.name}</span>
        </div>
      )
    }
  </div>
</a>
