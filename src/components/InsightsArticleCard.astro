---
import type { CollectionEntry } from "astro:content";

interface Props {
  article: CollectionEntry<"insights-articles">;
}

const { article } = Astro.props;
const { title, date, readTime, type, excerpt } = article.data;
---

<a
  href={`/insights/${article.id}`}
  class="flex flex-col rounded-[var(--radius-card)] border border-neutral-200 bg-surface p-6 shadow-card transition-shadow hover:shadow-card-hover"
>
  <p class="eyebrow text-neutral-500">
    {date.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" })} · {readTime}
    {type === "webinar" && " · Webinar"}
  </p>
  <h3 class="mt-2 text-[length:var(--text-h4)]">{title}</h3>
  <p class="mt-2 line-clamp-3 text-[length:var(--text-small)] text-neutral-600">{excerpt}</p>
</a>
