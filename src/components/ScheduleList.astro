---
// Shared "upcoming sessions" list: a real <table> on desktop (columns line
// up naturally) and stacked cards on mobile, each row showing the course's
// own certification badge (falling back to its category's logo). Used by
// the category page and the training hub; the homepage and full-schedule
// page have their own longer-standing versions of this same pattern.
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import Badge from "@/components/Badge.astro";
import { certificationLogos } from "@/data/certifications";
import { courseBadges } from "@/data/courseBadges";
import { formatSessionDate } from "@/lib/dates";

interface Row {
  session: CollectionEntry<"training-schedules">;
  course: CollectionEntry<"training-courses">;
  category: CollectionEntry<"training-categories">;
}

interface Props {
  rows: Row[];
  filterable?: boolean;
  emptyMessage?: string;
  id?: string;
}

const { rows, filterable = false, emptyMessage = "No sessions are currently scheduled.", id = "schedule-list" } = Astro.props;

const topics = filterable
  ? [...new Map(rows.map((r) => [r.category.id, r.category])).values()].sort(
      (a, b) => a.data.order - b.data.order
    )
  : [];

function badgeFor(row: Row) {
  const badge = courseBadges[row.course.id];
  if (badge) return { kind: "badge" as const, badge };
  const logo = row.category.data.certificationBody ? certificationLogos[row.category.data.certificationBody] : undefined;
  return logo ? { kind: "logo" as const, logo } : undefined;
}
---

{
  filterable && topics.length > 1 && (
    <div class="mb-6 flex flex-wrap gap-2" id={`${id}-filters`}>
      <button type="button" data-filter-value="all" class="schedule-filter-btn cursor-pointer rounded-[var(--radius-pill)] border border-lime bg-lime px-4 py-1.5 text-[length:var(--text-small)] font-semibold text-ink transition-colors">
        All disciplines
      </button>
      {topics.map((topic) => (
        <button
          type="button"
          data-filter-value={topic.id}
          class="schedule-filter-btn cursor-pointer rounded-[var(--radius-pill)] border border-neutral-300 bg-surface px-4 py-1.5 text-[length:var(--text-small)] font-semibold text-neutral-700 transition-colors hover:border-ink hover:text-ink"
        >
          {topic.data.name}
        </button>
      ))}
    </div>
  )
}

{
  rows.length > 0 ? (
    <Fragment>
      {/* stacked cards below sm, table from sm up */}
      <div class="flex flex-col gap-3 sm:hidden" id={`${id}-mobile`}>
        {rows.map((row) => {
          const b = badgeFor(row);
          return (
            <div class="schedule-row rounded-[var(--radius-card)] border border-neutral-200 bg-surface p-4" data-topic={row.category.id}>
              <div class="flex items-center gap-2.5">
                {b?.kind === "badge" && <Image src={b.badge} alt="" width={40} height={40} class="h-7 w-7 shrink-0 rounded-full" />}
                {b?.kind === "logo" && (
                  <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-neutral-200 bg-surface p-1">
                    <img src={b.logo.src} alt="" class="h-full w-full object-contain" />
                  </span>
                )}
                <p class="font-semibold">{row.course.data.name}</p>
              </div>
              <div class="mt-3 flex items-center justify-between gap-3 border-t border-neutral-100 pt-3 text-[length:var(--text-small)]">
                <div>
                  <p class="font-semibold">{formatSessionDate(row.session, row.course)}</p>
                  <p class="text-neutral-500">{row.session.data.location}</p>
                </div>
                <Badge format={row.session.data.format} />
              </div>
              <div class="mt-3 flex items-center justify-between gap-3 border-t border-neutral-100 pt-3">
                <span class="font-bold">{row.session.data.price}</span>
                <a
                  href={`/training/register/${row.session.id}`}
                  class="rounded-[var(--radius-control)] bg-ink px-4 py-2 text-center text-[length:var(--text-small)] font-semibold text-surface"
                >
                  Book now →
                </a>
              </div>
            </div>
          );
        })}
      </div>

      <div class="hidden overflow-x-auto rounded-[var(--radius-card)] border border-neutral-200 bg-surface sm:block" id={`${id}-desktop`}>
        <table class="w-full text-left text-[length:var(--text-small)]">
          <thead>
            <tr class="border-b border-neutral-200 bg-ink text-surface">
              <th class="px-4 py-3 font-medium sm:px-5">Course</th>
              <th class="px-4 py-3 font-medium sm:px-5">Date</th>
              <th class="px-4 py-3 font-medium sm:px-5">Location</th>
              <th class="px-4 py-3 font-medium sm:px-5">Format</th>
              <th class="px-4 py-3 font-medium sm:px-5">Price</th>
              <th class="px-4 py-3 sm:px-5" />
            </tr>
          </thead>
          <tbody>
            {rows.map((row) => {
              const b = badgeFor(row);
              return (
                <tr class="schedule-row border-b border-neutral-100 last:border-0" data-topic={row.category.id}>
                  <td class="px-4 py-4 sm:px-5">
                    <div class="flex items-center gap-2.5">
                      {b?.kind === "badge" && <Image src={b.badge} alt="" width={40} height={40} class="h-7 w-7 shrink-0 rounded-full" />}
                      {b?.kind === "logo" && (
                        <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-neutral-200 bg-surface p-1">
                          <img src={b.logo.src} alt="" class="h-full w-full object-contain" />
                        </span>
                      )}
                      <span class="font-semibold">{row.course.data.name}</span>
                    </div>
                  </td>
                  <td class="whitespace-nowrap px-4 py-4 font-medium sm:px-5">{formatSessionDate(row.session, row.course)}</td>
                  <td class="px-4 py-4 text-neutral-600 sm:px-5">{row.session.data.location}</td>
                  <td class="px-4 py-4 sm:px-5">
                    <Badge format={row.session.data.format} />
                  </td>
                  <td class="whitespace-nowrap px-4 py-4 font-bold sm:px-5">{row.session.data.price}</td>
                  <td class="px-4 py-4 text-right sm:px-5">
                    <a href={`/training/register/${row.session.id}`} class="whitespace-nowrap font-semibold text-ink hover:underline">
                      Book now →
                    </a>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      {filterable && (
        <p class="mt-6 hidden text-[length:var(--text-small)] text-neutral-500" id={`${id}-empty`}>
          No sessions match this filter right now.
        </p>
      )}
    </Fragment>
  ) : (
    <div class="rounded-[var(--radius-card)] border border-neutral-200 bg-surface p-10 text-center">
      <p class="text-[length:var(--text-small)] text-neutral-600">{emptyMessage}</p>
      <a
        href="/contact"
        class="mt-4 inline-flex items-center justify-center gap-1.5 rounded-[var(--radius-control)] bg-ink px-4 py-2.5 text-sm font-semibold text-surface"
      >
        Get in touch <span aria-hidden="true">→</span>
      </a>
    </div>
  )
}

{
  filterable && topics.length > 1 && (
    <script define:vars={{ id }}>
      const filterBar = document.getElementById(`${id}-filters`);
      const rows = Array.from(document.querySelectorAll(`#${id}-mobile .schedule-row, #${id}-desktop .schedule-row`));
      const emptyMessage = document.getElementById(`${id}-empty`);
      const mobileList = document.getElementById(`${id}-mobile`);
      const desktopList = document.getElementById(`${id}-desktop`);

      filterBar?.addEventListener("click", (e) => {
        const btn = e.target.closest(".schedule-filter-btn");
        if (!btn) return;

        filterBar.querySelectorAll(".schedule-filter-btn").forEach((b) => {
          b.classList.remove("bg-lime", "border-lime", "text-ink");
          b.classList.add("bg-surface", "border-neutral-300", "text-neutral-700");
        });
        btn.classList.remove("bg-surface", "border-neutral-300", "text-neutral-700");
        btn.classList.add("bg-lime", "border-lime", "text-ink");

        const value = btn.dataset.filterValue;
        let visible = 0;
        rows.forEach((row) => {
          const show = value === "all" || row.dataset.topic === value;
          row.hidden = !show;
          if (show) visible++;
        });

        if (emptyMessage) emptyMessage.hidden = visible > 0;
        if (mobileList) mobileList.style.display = visible > 0 ? "" : "none";
        if (desktopList) desktopList.style.display = visible > 0 ? "" : "none";
      });
    </script>
  )
}
