---
// Shared "upcoming sessions" list: a real <table> on desktop (columns line
// up naturally) and stacked cards on mobile, each row showing the course's
// own certification badge (falling back to its category's logo). This is
// the single implementation behind the homepage teaser, the training hub,
// the full schedule page, and category pages -- they used to be four
// separate hand-written copies that drifted (different columns, only one
// had a country filter, only two had the mobile breakpoint fix), which is
// exactly the inconsistency this component now exists to prevent.
//
// Country isn't a schema field -- it's parsed off the end of the
// free-text `location` string (e.g. "Berlin, Germany" -> "Germany"), same
// as full-schedule.astro did before consolidation.
//
// Every listing here links its course title straight to the course page
// and (when a session has one) a trainer chip tucked underneath it,
// linking to that trainer's own profile page -- but only when they have
// one; a trainer with no migrated profile renders as plain unlinked text
// rather than sending a visitor off-site to LinkedIn from a browsing list.
// Price is deliberately left out of every one of these listings; it shows
// up once a visitor clicks through to the course or registration page.
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import Badge from "@/components/Badge.astro";
import SoldOutBadge from "@/components/SoldOutBadge.astro";
import TrainerChip from "@/components/TrainerChip.astro";
import { certificationLogos } from "@/data/certifications";
import { courseBadges } from "@/data/courseBadges";
import { formatSessionDate } from "@/lib/dates";
import { registrationHref, registrationLinkAttrs } from "@/lib/registrationLink";
import { toPathSegment } from "@/lib/urlSlug";
import { getTrainersForSessions, type TrainerEntry } from "@/lib/trainers";

interface Row {
  session: CollectionEntry<"training-schedules">;
  course: CollectionEntry<"training-courses">;
  category: CollectionEntry<"training-categories">;
}

type FilterKind = "topic" | "country" | "trainer";

interface Props {
  rows: Row[];
  filters?: FilterKind[];
  defaultCountry?: string;
  showTrainer?: boolean;
  limit?: number;
  emptyMessage?: string;
  id?: string;
}

const {
  rows: allRows,
  filters = [],
  defaultCountry,
  showTrainer = true,
  limit,
  emptyMessage = "No sessions are currently scheduled.",
  id = "schedule-list",
} = Astro.props as Props;

const rows = limit ? allRows.slice(0, limit) : allRows;

const trainerKey = (t: TrainerEntry) => (t.kind === "profile" ? t.profile.id : `name:${t.name}`);
const trainerLabel = (t: TrainerEntry) => (t.kind === "profile" ? t.profile.data.name : t.name);

const enriched = await Promise.all(
  rows.map(async (row) => {
    const country = row.session.data.location.includes(",")
      ? row.session.data.location.split(",").pop()!.trim()
      : row.session.data.location;
    const trainers = showTrainer ? await getTrainersForSessions([row.session]) : [];
    const coursePath = `/training/${row.category.id}/${toPathSegment(row.course.data.urlSlug ?? row.course.id)}`;
    return { ...row, country, trainers, coursePath };
  })
);

const showTopicFilter = filters.includes("topic") && new Set(rows.map((r) => r.category.id)).size > 1;
const showCountryFilter = filters.includes("country") && new Set(enriched.map((r) => r.country)).size > 1;
const showTrainerFilter =
  filters.includes("trainer") &&
  new Set(enriched.flatMap((r) => r.trainers).map(trainerKey)).size > 1;

const topics = showTopicFilter
  ? [...new Map(rows.map((r) => [r.category.id, r.category])).values()].sort((a, b) => a.data.order - b.data.order)
  : [];
const countries = showCountryFilter ? [...new Set(enriched.map((r) => r.country))].sort() : [];
const allTrainers = showTrainerFilter
  ? [...new Map(enriched.flatMap((r) => r.trainers).map((t) => [trainerKey(t), t])).values()].sort((a, b) =>
      trainerLabel(a).localeCompare(trainerLabel(b))
    )
  : [];

const hasAnyFilter = showTopicFilter || showCountryFilter || showTrainerFilter;

function badgeFor(row: Row) {
  const badge = courseBadges[row.course.id];
  if (badge) return { kind: "badge" as const, badge };
  const logo = row.category.data.certificationBody ? certificationLogos[row.category.data.certificationBody] : undefined;
  return logo ? { kind: "logo" as const, logo } : undefined;
}

const chevron = `<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 7.5l5 5 5-5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
---

{
  hasAnyFilter && (
    <div class="mb-6 space-y-3" id={`${id}-filters`}>
      {showTopicFilter && (
        <div class="rounded-[var(--radius-control)] border border-neutral-200 lg:border-0">
          <button type="button" class="filter-toggle flex w-full cursor-pointer items-center justify-between gap-2 px-4 py-3 lg:hidden" data-panel={`${id}-panel-topic`} aria-expanded="false">
            <span class="text-[length:var(--text-caption)] font-semibold uppercase tracking-[0.1em] text-neutral-500">
              Discipline<span class="filter-summary-count font-normal normal-case tracking-normal text-neutral-400" />
            </span>
            <span class="chevron h-4 w-4 shrink-0 text-neutral-400 transition-transform" set:html={chevron} />
          </button>
          <p class="hidden px-4 pb-3 text-[length:var(--text-caption)] font-semibold uppercase tracking-[0.1em] text-neutral-500 lg:block lg:px-0 lg:pb-0">Discipline</p>
          <div id={`${id}-panel-topic`} class="hidden flex-wrap gap-2 px-4 pb-4 pt-1 lg:flex lg:p-0 lg:pt-2">
            {topics.map((topic) => (
              <button type="button" data-filter-group="topic" data-filter-value={topic.id} class="filter-btn mb-2 mr-2 cursor-pointer rounded-[var(--radius-pill)] border border-neutral-300 bg-surface px-4 py-1.5 text-[length:var(--text-small)] font-semibold text-neutral-700 transition-colors hover:border-ink hover:text-ink lg:mb-0">
                {topic.data.name}
              </button>
            ))}
          </div>
        </div>
      )}

      {showCountryFilter && (
        <div class="rounded-[var(--radius-control)] border border-neutral-200 lg:border-0">
          <button type="button" class="filter-toggle flex w-full cursor-pointer items-center justify-between gap-2 px-4 py-3 lg:hidden" data-panel={`${id}-panel-country`} aria-expanded="false">
            <span class="text-[length:var(--text-caption)] font-semibold uppercase tracking-[0.1em] text-neutral-500">
              Country<span class="filter-summary-count font-normal normal-case tracking-normal text-neutral-400" />
            </span>
            <span class="chevron h-4 w-4 shrink-0 text-neutral-400 transition-transform" set:html={chevron} />
          </button>
          <p class="hidden px-4 pb-3 text-[length:var(--text-caption)] font-semibold uppercase tracking-[0.1em] text-neutral-500 lg:block lg:px-0 lg:pb-0">Country</p>
          <div id={`${id}-panel-country`} class="hidden flex-wrap gap-2 px-4 pb-4 pt-1 lg:flex lg:p-0 lg:pt-2">
            {countries.map((country) => (
              <button type="button" data-filter-group="country" data-filter-value={country} class={`filter-btn mb-2 mr-2 cursor-pointer rounded-[var(--radius-pill)] border px-4 py-1.5 text-[length:var(--text-small)] font-semibold transition-colors hover:border-ink hover:text-ink lg:mb-0 ${country === defaultCountry ? "border-lime bg-lime text-ink" : "border-neutral-300 bg-surface text-neutral-700"}`}>
                {country}
              </button>
            ))}
          </div>
        </div>
      )}

      {showTrainerFilter && (
        <div class="rounded-[var(--radius-control)] border border-neutral-200 lg:border-0">
          <button type="button" class="filter-toggle flex w-full cursor-pointer items-center justify-between gap-2 px-4 py-3 lg:hidden" data-panel={`${id}-panel-trainer`} aria-expanded="false">
            <span class="text-[length:var(--text-caption)] font-semibold uppercase tracking-[0.1em] text-neutral-500">
              Trainer<span class="filter-summary-count font-normal normal-case tracking-normal text-neutral-400" />
            </span>
            <span class="chevron h-4 w-4 shrink-0 text-neutral-400 transition-transform" set:html={chevron} />
          </button>
          <p class="hidden px-4 pb-3 text-[length:var(--text-caption)] font-semibold uppercase tracking-[0.1em] text-neutral-500 lg:block lg:px-0 lg:pb-0">Trainer</p>
          <div id={`${id}-panel-trainer`} class="hidden flex-wrap gap-2 px-4 pb-4 pt-1 lg:flex lg:p-0 lg:pt-2">
            {allTrainers.map((trainer) => (
              <button type="button" data-filter-group="trainer" data-filter-value={trainerKey(trainer)} class="filter-btn mb-2 mr-2 cursor-pointer rounded-[var(--radius-pill)] border border-neutral-300 bg-surface px-4 py-1.5 text-[length:var(--text-small)] font-semibold text-neutral-700 transition-colors hover:border-ink hover:text-ink lg:mb-0">
                {trainerLabel(trainer)}
              </button>
            ))}
          </div>
        </div>
      )}
    </div>
  )
}

{
  enriched.length > 0 ? (
    <Fragment>
      {/* stacked cards below lg, table from lg up -- a real desktop-width
      screen is needed for this many columns not to cramp the course name
      into an ugly 3-line wrap; below that, the card layout has room to
      breathe instead. */}
      <div class="flex flex-col gap-3 lg:hidden" id={`${id}-mobile`}>
        {enriched.map((row) => {
          const b = badgeFor(row);
          return (
            <div
              class="schedule-row rounded-[var(--radius-card)] border border-neutral-200 bg-surface p-4"
              data-topic={row.category.id}
              data-country={row.country}
              data-trainers={row.trainers.map(trainerKey).join(" ")}
            >
              <div class="flex items-start gap-2.5">
                {b?.kind === "badge" && <Image src={b.badge} alt="" width={40} height={40} class="h-7 w-7 shrink-0 rounded-full" />}
                {b?.kind === "logo" && (
                  <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-neutral-200 bg-surface p-1">
                    <img src={b.logo.src} alt="" class="h-full w-full object-contain" />
                  </span>
                )}
                <div class="min-w-0 flex-1">
                  <div class="flex flex-wrap items-center gap-2">
                    <a href={row.coursePath} class="font-semibold hover:underline">{row.course.data.name}</a>
                    {row.session.data.status === "sold-out" && <SoldOutBadge />}
                  </div>
                  {row.trainers.length > 0 && (
                    <div class="mt-1 flex flex-wrap gap-1.5">
                      {row.trainers.map((trainer) => <TrainerChip trainer={trainer} density="plain" linkedinFallback={false} />)}
                    </div>
                  )}
                </div>
              </div>
              <div class="mt-3 flex items-center justify-between gap-3 border-t border-neutral-100 pt-3 text-[length:var(--text-small)]">
                <div>
                  <p class="font-semibold">{formatSessionDate(row.session, row.course)}</p>
                  <p class="text-neutral-500">{row.session.data.location}</p>
                </div>
                <Badge format={row.session.data.format} />
              </div>
              <a
                href={registrationHref(row.session)}
                {...registrationLinkAttrs(row.session)}
                class={
                  row.session.data.status === "sold-out"
                    ? "mt-3 block rounded-[var(--radius-control)] border border-ink px-4 py-2 text-center text-[length:var(--text-small)] font-semibold text-ink transition-colors hover:bg-mist-light"
                    : "mt-3 block rounded-[var(--radius-control)] bg-ink px-4 py-2 text-center text-[length:var(--text-small)] font-semibold text-surface transition-colors hover:bg-neutral-800"
                }
              >
                {row.session.data.status === "sold-out" ? "Join waitlist →" : "Book now →"}
              </a>
            </div>
          );
        })}
      </div>

      <div class="hidden overflow-x-auto rounded-[var(--radius-card)] border border-neutral-200 bg-surface lg:block" id={`${id}-desktop`}>
        <table class="w-full text-left text-[length:var(--text-small)]">
          <thead>
            <tr class="border-b border-neutral-200 bg-ink text-surface">
              <th class="px-4 py-3 font-medium sm:px-5">Course</th>
              <th class="px-4 py-3 font-medium sm:px-5">Date</th>
              <th class="px-4 py-3 font-medium sm:px-5">Location</th>
              <th class="px-4 py-3 font-medium sm:px-5">Format</th>
              <th class="px-4 py-3 sm:px-5" />
            </tr>
          </thead>
          <tbody>
            {enriched.map((row) => {
              const b = badgeFor(row);
              return (
                <tr
                  class="schedule-row border-b border-neutral-100 last:border-0"
                  data-topic={row.category.id}
                  data-country={row.country}
                  data-trainers={row.trainers.map(trainerKey).join(" ")}
                >
                  <td class="px-4 py-4 sm:px-5">
                    <div class="flex items-start gap-2.5">
                      {b?.kind === "badge" && <Image src={b.badge} alt="" width={40} height={40} class="h-7 w-7 shrink-0 rounded-full" />}
                      {b?.kind === "logo" && (
                        <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-neutral-200 bg-surface p-1">
                          <img src={b.logo.src} alt="" class="h-full w-full object-contain" />
                        </span>
                      )}
                      <div class="min-w-0">
                        <div class="flex flex-wrap items-center gap-2">
                          <a href={row.coursePath} class="font-semibold hover:underline">{row.course.data.name}</a>
                          {row.session.data.status === "sold-out" && <SoldOutBadge />}
                        </div>
                        {row.trainers.length > 0 && (
                          <div class="mt-1 flex flex-wrap gap-1.5">
                            {row.trainers.map((trainer) => <TrainerChip trainer={trainer} density="plain" linkedinFallback={false} />)}
                          </div>
                        )}
                      </div>
                    </div>
                  </td>
                  <td class="whitespace-nowrap px-4 py-4 font-medium sm:px-5">{formatSessionDate(row.session, row.course)}</td>
                  <td class="px-4 py-4 text-neutral-600 sm:px-5">{row.session.data.location}</td>
                  <td class="px-4 py-4 sm:px-5">
                    <Badge format={row.session.data.format} />
                  </td>
                  <td class="px-4 py-4 text-right sm:px-5">
                    <a
                      href={registrationHref(row.session)}
                      {...registrationLinkAttrs(row.session)}
                      class={
                        row.session.data.status === "sold-out"
                          ? "inline-block whitespace-nowrap rounded-[var(--radius-control)] border border-ink px-3 py-1.5 font-semibold text-ink transition-colors hover:bg-mist-light"
                          : "whitespace-nowrap font-semibold text-ink hover:underline"
                      }
                    >
                      {row.session.data.status === "sold-out" ? "Join waitlist →" : "Book now →"}
                    </a>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      {hasAnyFilter && (
        <p class="mt-6 hidden text-[length:var(--text-small)] text-neutral-500" id={`${id}-empty`}>
          No sessions match this filter right now.
        </p>
      )}
    </Fragment>
  ) : (
    <div class="rounded-[var(--radius-card)] border border-neutral-200 bg-surface p-10 text-center">
      <p class="text-[length:var(--text-small)] text-neutral-600">{emptyMessage}</p>
      <a
        href="/contact"
        class="mt-4 inline-flex items-center justify-center gap-1.5 rounded-[var(--radius-control)] bg-ink px-4 py-2.5 text-sm font-semibold text-surface transition-colors hover:bg-neutral-800"
      >
        Get in touch <span aria-hidden="true">→</span>
      </a>
    </div>
  )
}

{
  hasAnyFilter && (
    <script define:vars={{ id, defaultCountry }}>
      const filterButtons = Array.from(document.querySelectorAll(`#${id}-filters [data-filter-group]`));
      const toggleButtons = Array.from(document.querySelectorAll(`#${id}-filters .filter-toggle`));
      const rows = Array.from(document.querySelectorAll(`#${id}-mobile .schedule-row, #${id}-desktop .schedule-row`));
      const emptyMessage = document.getElementById(`${id}-empty`);
      const mobileList = document.getElementById(`${id}-mobile`);
      const desktopList = document.getElementById(`${id}-desktop`);

      const active = {
        topic: new Set(),
        country: new Set(defaultCountry ? [defaultCountry] : []),
        trainer: new Set(),
      };

      function updateSummaryCounts() {
        toggleButtons.forEach((toggle) => {
          const panel = document.getElementById(toggle.dataset.panel);
          const group = panel?.querySelector("[data-filter-group]")?.dataset.filterGroup;
          if (!group) return;
          const count = active[group].size;
          const countEl = toggle.querySelector(".filter-summary-count");
          if (countEl) countEl.textContent = count > 0 ? ` (${count})` : "";
        });
      }

      function update() {
        let visible = 0;
        rows.forEach((row) => {
          const topic = row.dataset.topic ?? "";
          const country = row.dataset.country ?? "";
          const trainers = (row.dataset.trainers ?? "").split(" ").filter(Boolean);
          const topicMatch = active.topic.size === 0 || active.topic.has(topic);
          const countryMatch = active.country.size === 0 || active.country.has(country);
          const trainerMatch = active.trainer.size === 0 || trainers.some((t) => active.trainer.has(t));
          const show = topicMatch && countryMatch && trainerMatch;
          row.hidden = !show;
          if (show) visible++;
        });
        if (emptyMessage) emptyMessage.hidden = visible > 0;
        if (mobileList) mobileList.style.display = visible > 0 ? "" : "none";
        if (desktopList) desktopList.style.display = visible > 0 ? "" : "none";
        updateSummaryCounts();
      }

      filterButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const group = button.dataset.filterGroup;
          const value = button.dataset.filterValue;
          const isActive = active[group].has(value);
          if (isActive) {
            active[group].delete(value);
            button.classList.remove("bg-lime", "border-lime", "text-ink");
            button.classList.add("bg-surface", "border-neutral-300", "text-neutral-700");
          } else {
            active[group].add(value);
            button.classList.remove("bg-surface", "border-neutral-300", "text-neutral-700");
            button.classList.add("bg-lime", "border-lime", "text-ink");
          }
          update();
        });
      });

      toggleButtons.forEach((toggle) => {
        toggle.addEventListener("click", () => {
          const panel = document.getElementById(toggle.dataset.panel);
          if (!panel) return;
          const isOpen = !panel.classList.contains("hidden");
          panel.classList.toggle("hidden", isOpen);
          panel.classList.toggle("flex", !isOpen);
          toggle.setAttribute("aria-expanded", String(!isOpen));
          toggle.querySelector(".chevron")?.classList.toggle("rotate-180", !isOpen);
        });
      });

      update();
    </script>
  )
}
