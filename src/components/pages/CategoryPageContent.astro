---
// Shared body for /training/[category] (English) and /de/training/[category]
// (German) -- the two route files differ only in getStaticPaths (which
// language's categories/courses/schedules they resolve) and the translations
// prop passed to BaseLayout. Everything visual lives here once. Locale is
// read directly off the current request rather than passed as a prop.
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import Section from "@/components/Section.astro";
import Badge from "@/components/Badge.astro";
import CTABanner from "@/components/CTABanner.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ScheduleList from "@/components/ScheduleList.astro";
import { certificationLogos } from "@/data/certifications";
import { courseBadges } from "@/data/courseBadges";
import { levelIcons, levelPillClasses } from "@/data/levelIcons";
import { toPathSegment } from "@/lib/urlSlug";
import { baseSlug } from "@/lib/i18n";
import { resolveLocale, useTranslations } from "@/i18n/utils";
import MeetTheTrainers from "@/components/MeetTheTrainers.astro";

interface Props {
  category: CollectionEntry<"training-categories">;
  courses: CollectionEntry<"training-courses">[];
  upcomingWithCourse: {
    session: CollectionEntry<"training-schedules">;
    course: CollectionEntry<"training-courses">;
    category: CollectionEntry<"training-categories">;
  }[];
  categoryTrainers: import("@/lib/trainers").TrainerEntry[];
}

const { category, courses, upcomingWithCourse, categoryTrainers } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const prefix = locale === "de" ? "/de" : "";
const categorySlug = baseSlug(category.id);

const logo = category.data.certificationBody ? certificationLogos[category.data.certificationBody] : undefined;
---

<Breadcrumbs items={[{ label: t("nav.training"), href: `${prefix}/training` }, { label: category.data.name }]} />

<Section class="bg-mist-light">
  <div class="grid gap-10 lg:grid-cols-[1.2fr_1fr] lg:items-start">
    <div class="min-w-0">
      <p class="eyebrow">{t("training.eyebrowLabel")}</p>
      <h1 class="mt-4 text-[length:var(--text-h1)] leading-[var(--text-h1--line-height)]">
        {category.data.name}
      </h1>
      <p class="mt-4 max-w-2xl text-[length:var(--text-h4)] font-medium text-neutral-700">
        {category.data.tagline}
      </p>
      <p class="mt-4 max-w-2xl text-[length:var(--text-body)] text-neutral-600">{category.data.description}</p>

      {
        category.data.videoUrl && (
          <div class="mt-8 flex items-center gap-5 rounded-[var(--radius-card)] border border-neutral-200 bg-surface p-6">
            <a
              href={category.data.videoUrl}
              target="_blank"
              rel="noopener"
              class="flex h-[110px] w-[180px] shrink-0 items-center justify-center rounded-[0.6rem] bg-ink"
              aria-label={category.data.videoTitle ?? "Watch the video"}
            >
              <span class="flex h-11 w-11 items-center justify-center rounded-full bg-surface">
                <svg viewBox="0 0 24 24" width="16" height="16"><path d="M6 4l14 8-14 8V4z" fill="#0a0a0a" /></svg>
              </span>
            </a>
            <div>
              <h4 class="text-[length:var(--text-small)] font-semibold">{category.data.videoTitle}</h4>
              <a href={category.data.videoUrl} target="_blank" rel="noopener" class="mt-1 inline-block text-[length:var(--text-caption)] text-neutral-500 hover:underline">
                {t("cta.watchOnYouTube")} &rarr;
              </a>
            </div>
          </div>
        )
      }
    </div>

    <div class="min-w-0 lg:sticky lg:top-24">
      <div class="overflow-hidden rounded-[var(--radius-card)] border border-neutral-200 bg-surface shadow-card">
        {
          category.data.certificationBody && (
            <div class="flex items-center gap-3 border-b border-neutral-200 bg-mist-light px-5 py-4">
              {logo ? (
                <img src={logo.src} alt={logo.alt} width={logo.width} height={logo.height} class="h-7 w-auto max-w-[64px] object-contain" />
              ) : (
                <span class="text-[length:var(--text-small)] font-semibold text-neutral-500">
                  {category.data.certificationBody}
                </span>
              )}
              <div>
                <p class="font-semibold">{t("certifiedBy")} {category.data.certificationBody}</p>
                <p class="text-[length:var(--text-caption)] text-neutral-500">{t("training.chooseWhereToStart")}</p>
              </div>
            </div>
          )
        }
        {
          courses.map((course) => (
            <a
              href={`${prefix}/training/${categorySlug}/${toPathSegment(course.data.urlSlug ?? baseSlug(course.id))}`}
              class="flex items-center justify-between gap-3 border-b border-neutral-100 px-5 py-3.5 transition-colors last:border-0 hover:bg-mist-light"
            >
              <div>
                <p class="text-[length:var(--text-small)] font-semibold">{course.data.name}</p>
                <p class="text-[length:var(--text-caption)] text-neutral-500">
                  {course.data.level}
                  {course.data.level && " · "}
                  {course.data.formats.length === 1 && course.data.formats[0] === "self-paced"
                    ? t("badge.selfPaced")
                    : `${course.data.formats.length} ${course.data.formats.length > 1 ? t("training.formatPlural") : t("training.formatSingular")}`}
                </p>
              </div>
              {course.data.priceFrom && <span class="shrink-0 font-bold">{course.data.priceFrom}</span>}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</Section>

<Section
  eyebrow={`${courses.length} ${courses.length === 1 ? t("training.courseSingular") : t("training.coursePlural")}`}
  heading={`${category.data.name} ${t("training.trainingCoursesHeadingSuffix")}`}
>
  {
    courses.length > 0 ? (
      <div class="flex flex-col gap-5">
        {courses.map((course) => {
          const badge = courseBadges[baseSlug(course.id)];
          return (
            <a
              href={`${prefix}/training/${categorySlug}/${toPathSegment(course.data.urlSlug ?? baseSlug(course.id))}`}
              class="flex flex-col gap-5 rounded-[var(--radius-card)] border border-neutral-200 bg-surface p-6 shadow-card transition-shadow hover:shadow-card-hover sm:flex-row sm:items-start"
            >
              {course.data.level && (
                <span
                  aria-hidden="true"
                  class="flex h-14 w-14 shrink-0 items-center justify-center rounded-[var(--radius-control)] bg-mist-light"
                  set:html={levelIcons[course.data.level]}
                />
              )}
              <div class="flex-1">
                <div class="flex flex-wrap items-center gap-2">
                  {course.data.level && (
                    <span class={`level-pill inline-flex items-center rounded-[var(--radius-pill)] px-3 py-1 text-[length:var(--text-caption)] font-bold uppercase tracking-[0.03em] ${levelPillClasses[course.data.level] ?? "bg-neutral-100 text-neutral-700"}`}>
                      {course.data.level}
                    </span>
                  )}
                  <span class="inline-flex items-center gap-1.5 rounded-[var(--radius-pill)] border border-neutral-200 py-0.5 pl-0.5 pr-2.5 text-[length:var(--text-caption)] font-semibold text-neutral-600">
                    {badge ? (
                      <Image src={badge} alt="" width={40} height={40} class="h-5 w-5 rounded-full" />
                    ) : (
                      logo && <img src={logo.src} alt="" class="h-5 w-5 rounded-full object-contain bg-surface p-0.5" />
                    )}
                    {course.data.code}
                  </span>
                </div>
                <h3 class="mt-3 text-[length:var(--text-h4)]">{course.data.name}</h3>
                <p class="mt-2 max-w-3xl text-[length:var(--text-small)] leading-relaxed text-neutral-600">
                  {course.data.summary}
                </p>
                <div class="mt-4 flex flex-wrap gap-2">
                  {course.data.formats.map((format) => (
                    <Badge format={format} />
                  ))}
                </div>
              </div>
            </a>
          );
        })}
      </div>
    ) : (
      <p class="text-[length:var(--text-body)] text-neutral-500">{t("training.noCoursesPublished")}</p>
    )
  }
</Section>

<MeetTheTrainers trainers={categoryTrainers} />

<Section
  eyebrow={`${t("training.upcomingPrefix")} ${category.data.name} ${t("training.upcomingSuffix")}`}
  heading={t("training.nextScheduledSessions")}
  class="bg-mist-light"
>
  <ScheduleList
    rows={upcomingWithCourse}
    id="category-schedule"
    emptyMessage={`${t("schedule.noSessions")}`}
  />
  <div class="mt-6 flex flex-wrap items-center justify-between gap-4">
    <p class="text-[length:var(--text-small)] text-neutral-600">
      {t("schedule.preferInHouse")} <a href={`/contact`} class="font-semibold text-ink underline">{t("schedule.letUsKnow")}</a>.
    </p>
    <a href={`/training/full-schedule`} class="rounded-[var(--radius-control)] border border-ink px-4 py-2.5 text-sm font-semibold text-ink">
      {t("schedule.seeAllScheduled")} &rarr;
    </a>
  </div>
</Section>

<CTABanner
  tone="light"
  heading={t("cta.categoryClosingHeading")}
  ctaLabel={t("cta.getStarted")}
  ctaHref={`/contact`}
/>
