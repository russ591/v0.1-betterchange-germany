---
// Shared body for / (English) and /de/ (German) -- see
// CategoryPageContent.astro for the same split pattern. `copy` carries the
// page's own prose (home-page content collection); everything else is data
// already resolved by the caller for the correct locale.
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import Section from "@/components/Section.astro";
import Button from "@/components/Button.astro";
import ServiceCard from "@/components/ServiceCard.astro";
import Badge from "@/components/Badge.astro";
import SoldOutBadge from "@/components/SoldOutBadge.astro";
import InsightsArticleCard from "@/components/InsightsArticleCard.astro";
import CTABanner from "@/components/CTABanner.astro";
import { getServices, serviceIcons } from "@/data/services";
import { courseBadges } from "@/data/courseBadges";
import { certificationLogos } from "@/data/certifications";
import { formatSessionDate } from "@/lib/dates";
import { registrationHref, registrationLinkAttrs } from "@/lib/registrationLink";
import { baseSlug } from "@/lib/i18n";
import { resolveLocale, useTranslations } from "@/i18n/utils";

interface Props {
  copy: CollectionEntry<"home-page">["data"];
  certifiedBy: string[];
  upcomingCourses: {
    session: CollectionEntry<"training-schedules">;
    course: CollectionEntry<"training-courses">;
    logo: { src: string; alt: string; width: number; height: number } | undefined;
  }[];
  team: CollectionEntry<"coach-profiles">[];
  featuredArticles: CollectionEntry<"insights-articles">[];
}

const { copy, certifiedBy, upcomingCourses, team, featuredArticles } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const prefix = locale === "de" ? "/de" : "";
const services = getServices(locale);

const clients = [
  "Deutsche Telekom",
  "Grundfos",
  "Laerdal",
  "TC Electronic",
  "HelloFresh",
  "McKinsey",
  "Microsoft",
  "Kleinanzeigen",
  "mobile.de",
  "Cogent",
  "Volkswagen",
  "Axel Springer",
  "Flightright",
  "Aiven",
  "Velux",
  "Luxembourg Chamber of Commerce",
  "Search Guard",
];
---

<section class="bg-mist-light">
  <div class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
    <div class="grid gap-10 lg:grid-cols-[1.15fr_1fr] lg:items-start">
      <div class="min-w-0">
        <p class="eyebrow">{copy.heroEyebrow}</p>
        <h1 class="mt-4 text-[length:var(--text-h1)] leading-[var(--text-h1--line-height)]">
          {copy.heroHeadingLead}{" "}
          <span aria-hidden="true" class="blob-dot inline-block h-[0.5em] w-[0.5em] bg-lime align-middle"></span>{" "}
          {copy.heroHeadingTrail}
        </h1>
        <p class="mt-6 max-w-lg text-[length:var(--text-body)] text-neutral-600">{copy.heroBody}</p>
        <div class="mt-8 flex flex-wrap gap-4">
          <Button href={`${prefix}/training`} variant="primary">{t("cta.seeAllTraining")}</Button>
          <Button href={`${prefix}/services`} variant="secondary">{t("cta.ourServices")}</Button>
        </div>
      </div>

      <div class="min-w-0 rounded-[var(--radius-card)] bg-surface p-6 shadow-card">
        <div class="grid grid-cols-2 gap-3">
          {
            copy.stats.map((stat) => (
              <div class="rounded-[0.6rem] bg-mist-light p-4">
                <p class="eyebrow">{stat.label}</p>
                <p class="mt-1 text-[length:var(--text-h3)] font-bold">{stat.value}</p>
                <p class="mt-1 text-[length:var(--text-caption)] text-neutral-600">{stat.description}</p>
              </div>
            ))
          }
        </div>
        <div class="mt-5 border-t border-neutral-200 pt-5">
          <p class="eyebrow justify-center">{t("certifiedBy")}</p>
          <div class="mt-3 flex flex-wrap items-center justify-center gap-x-6 gap-y-3">
            {
              certifiedBy
                .filter((cert) => cert !== "Scaled Agile")
                .map((cert) => {
                  const logo = certificationLogos[cert];
                  return logo ? (
                    <img src={logo.src} alt={logo.alt} width={logo.width} height={logo.height} class="h-6 w-auto object-contain" />
                  ) : (
                    <span class="text-[length:var(--text-caption)] font-semibold text-neutral-500">{cert}</span>
                  );
                })
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<Section class="border-t border-neutral-200 !py-10">
  <div class="flex items-center gap-8">
    <p class="shrink-0 text-[length:var(--text-caption)] font-semibold uppercase tracking-[0.1em] text-neutral-600">
      {copy.workedWithLabel}
    </p>
    <div class="overflow-hidden" style="mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent);">
      <ul class="marquee-track flex w-max flex-nowrap items-center gap-x-14 text-[length:var(--text-small)] font-medium whitespace-nowrap text-neutral-600">
        {clients.map((client) => <li>{client}</li>)}
        {clients.map((client) => <li aria-hidden="true">{client}</li>)}
      </ul>
    </div>
  </div>
</Section>

<Section eyebrow={copy.servicesEyebrow} heading={copy.servicesHeading} class="border-t border-neutral-200">
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {
      services.map((service) => (
        <ServiceCard name={service.name} blurb={service.blurb} href={`${prefix}/services`}>
          <Fragment slot="icon" set:html={serviceIcons[service.icon]} />
        </ServiceCard>
      ))
    }
  </div>
</Section>

<Section eyebrow={copy.upcomingEyebrow} heading={copy.upcomingHeading} class="border-t border-neutral-200 bg-mist-light">
  {/* stacked cards below sm, table from sm up -- the real content
      (long dates, format pills, location) doesn't fit a 5-column
      table at phone widths */}
  <div class="flex flex-col gap-3 sm:hidden">
    {
      upcomingCourses.map(({ session, course, logo }) => (
        <div class="rounded-[var(--radius-card)] border border-neutral-200 bg-surface p-4">
          <div class="flex items-center gap-2.5">
            {courseBadges[baseSlug(course.id)] ? (
              <Image src={courseBadges[baseSlug(course.id)]} alt="" width={40} height={40} class="h-7 w-7 shrink-0 rounded-full" />
            ) : (
              logo && (
                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-neutral-200 bg-surface p-1">
                  <img src={logo.src} alt="" class="h-full w-full object-contain" />
                </span>
              )
            )}
            <p class="font-semibold">{course.data.name}</p>
            {session.data.status === "sold-out" && <SoldOutBadge />}
          </div>
          <div class="mt-3 flex items-center justify-between gap-3 border-t border-neutral-100 pt-3 text-[length:var(--text-small)]">
            <div>
              <p class="font-semibold">{formatSessionDate(session, course, "short")}</p>
              <p class="text-neutral-500">{session.data.location}</p>
            </div>
            <Badge format={session.data.format} />
          </div>
          <a
            href={registrationHref(session)}
            {...registrationLinkAttrs(session)}
            class={
              session.data.status === "sold-out"
                ? "mt-3 block rounded-[var(--radius-control)] border border-ink px-4 py-2 text-center text-[length:var(--text-small)] font-semibold text-ink transition-colors hover:bg-mist-light"
                : "mt-3 block rounded-[var(--radius-control)] bg-ink px-4 py-2 text-center text-[length:var(--text-small)] font-semibold text-surface transition-colors hover:bg-neutral-800"
            }
          >
            {session.data.status === "sold-out" ? `${t("schedule.joinWaitlist")} →` : `${t("schedule.register")} →`}
          </a>
        </div>
      ))
    }
  </div>

  <div class="hidden overflow-x-auto rounded-[var(--radius-card)] border border-neutral-200 bg-surface sm:block">
    <table class="w-full text-left text-[length:var(--text-small)]">
      <thead>
        <tr class="border-b border-neutral-200 bg-ink text-surface">
          <th class="px-3 py-3 font-medium sm:px-5">{t("schedule.course")}</th>
          <th class="px-3 py-3 font-medium sm:px-5">{t("schedule.date")}</th>
          <th class="px-3 py-3 font-medium sm:px-5">{t("schedule.location")}</th>
          <th class="px-3 py-3 font-medium sm:px-5">{t("schedule.format")}</th>
          <th class="px-3 py-3 sm:px-5" />
        </tr>
      </thead>
      <tbody>
        {
          upcomingCourses.map(({ session, course, logo }) => (
            <tr class="border-b border-neutral-100 last:border-0">
              <td class="px-3 py-4 sm:px-5">
                <div class="flex items-center gap-2.5">
                  {courseBadges[baseSlug(course.id)] ? (
                    <Image
                      src={courseBadges[baseSlug(course.id)]}
                      alt=""
                      width={40}
                      height={40}
                      class="h-7 w-7 shrink-0 rounded-full"
                    />
                  ) : (
                    logo && (
                      <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-neutral-200 bg-surface p-1">
                        <img src={logo.src} alt="" class="h-full w-full object-contain" />
                      </span>
                    )
                  )}
                  <span class="font-semibold">{course.data.name}</span>
                  {session.data.status === "sold-out" && <SoldOutBadge />}
                </div>
              </td>
              <td class="whitespace-nowrap px-3 py-4 sm:px-5">{formatSessionDate(session, course, "short")}</td>
              <td class="px-3 py-4 text-neutral-600 sm:px-5">{session.data.location}</td>
              <td class="px-3 py-4 sm:px-5">
                <Badge format={session.data.format} />
              </td>
              <td class="px-3 py-4 text-right sm:px-5">
                <a
                  href={registrationHref(session)}
                  {...registrationLinkAttrs(session)}
                  class={
                    session.data.status === "sold-out"
                      ? "inline-block whitespace-nowrap rounded-[var(--radius-control)] border border-ink px-3 py-1.5 font-semibold text-ink transition-colors hover:bg-mist-light"
                      : "whitespace-nowrap font-semibold hover:underline"
                  }
                >
                  {session.data.status === "sold-out" ? `${t("schedule.joinWaitlist")} →` : `${t("schedule.register")} →`}
                </a>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <div class="mt-6 text-right">
    <Button href={`/training/full-schedule`} variant="link" class="group">{t("schedule.fullSchedule")}</Button>
  </div>
</Section>

<Section tone="dark" eyebrow={copy.teamEyebrow} heading={copy.teamHeading}>
  <div class="flex flex-wrap gap-6">
    {
      team.map((profile) => (
        <div class="flex w-24 flex-col items-center gap-2 text-center">
          {
            profile.data.photo ? (
              <img
                src={profile.data.photo}
                alt={profile.data.name}
                class="h-14 w-14 rounded-full object-cover"
                loading="lazy"
              />
            ) : (
              <span class="flex h-14 w-14 items-center justify-center rounded-full border-[1.5px] border-lime text-sm font-bold text-lime">
                {(() => {
                  const parts = profile.data.name.split(" ");
                  return parts.length > 1 ? parts[0][0] + parts[parts.length - 1][0] : parts[0].slice(0, 2);
                })()}
              </span>
            )
          }
          <span class="text-[length:var(--text-caption)] font-semibold">{profile.data.name}</span>
          <span class="text-[length:var(--text-caption)] text-neutral-400">{profile.data.country}</span>
        </div>
      ))
    }
  </div>
  <div class="mt-8 flex flex-wrap items-center gap-6">
    <Button href="/about" variant="primary">{t("cta.meetFullTeam")}</Button>
    <p class="max-w-md text-[length:var(--text-small)] text-neutral-300">{copy.teamBody}</p>
  </div>

  <div class="mt-12 border-t border-neutral-800 pt-10">
    <p class="eyebrow text-lime">{copy.quoteEyebrow}</p>
    <blockquote class="mt-3 max-w-2xl text-[length:var(--text-h3)] font-bold leading-snug text-lime">
      “{copy.quoteText}”
    </blockquote>
    <cite class="mt-4 block text-[length:var(--text-small)] not-italic text-neutral-400">{copy.quoteCite}</cite>
  </div>
</Section>

<Section eyebrow={copy.insightsEyebrow} heading={copy.insightsHeading} class="border-t border-neutral-200">
  <div class="grid gap-6 sm:grid-cols-3">
    {featuredArticles.map((article) => <InsightsArticleCard article={article} />)}
  </div>
  <div class="mt-6 text-right">
    <Button href="/insights" variant="link" class="group">{t("cta.viewAllInsights")}</Button>
  </div>
</Section>

<CTABanner tone="light" heading={t("cta.closingHeading")} body={t("cta.closingBody")} ctaLabel={t("schedule.getInTouch")} ctaHref={`/contact`} />
