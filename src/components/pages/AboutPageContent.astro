---
// Shared body for /about (English) and /de/about (German) -- see
// HomePageContent.astro for the same split pattern. `copy` carries the
// page's own prose (about-page content collection); `team` is already
// resolved for the correct locale (each entry is the German translation
// when one exists, English otherwise -- see localizedCoachProfile in
// src/lib/i18n.ts). TeamCard.astro derives its own href prefix from the
// current locale rather than from the entry it's given.
import type { CollectionEntry } from "astro:content";
import Section from "@/components/Section.astro";
import StatCallout from "@/components/StatCallout.astro";
import TeamCard from "@/components/TeamCard.astro";
import CTABanner from "@/components/CTABanner.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { resolveLocale, useTranslations } from "@/i18n/utils";
import { getNetworkSite } from "@/data/networkSites";

interface Props {
  copy: CollectionEntry<"about-page">["data"];
  team: CollectionEntry<"coach-profiles">[];
}

const { copy, team } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const prefix = locale === "de" ? "/de" : "";

// The callout's copy is content; the one link in it (the .com domain) is
// slotted in at its `{com}` token so the URL stays in the shared site list.
const com = getNetworkSite("com", locale);
const [noteBefore, noteAfter] = copy.networkNoteBody.split("{com}");
---

<Breadcrumbs items={[{ label: t("nav.about") }]} />

<Section eyebrow={copy.heroEyebrow} class="bg-mist-light">
  <h1 class="text-[length:var(--text-h1)] leading-[var(--text-h1--line-height)]">
    {copy.heroHeading}
  </h1>
  <p class="mt-6 max-w-2xl text-[length:var(--text-body)] text-neutral-600">
    {copy.heroBody}
  </p>
  <div
    class="mt-8 max-w-2xl rounded-[var(--radius-card)] border border-l-4 border-neutral-200 border-l-lime bg-surface p-5 text-[length:var(--text-small)] leading-relaxed text-neutral-600"
  >
    <strong class="font-semibold text-ink">{copy.networkNoteHeading}</strong>
    {noteBefore}<a
      href={com.url}
      target="_blank"
      rel="noopener"
      class="whitespace-nowrap border-b border-lime font-semibold text-ink hover:bg-lime/30"
      >{com.domain}<span aria-hidden="true"> ↗</span><span class="sr-only"> {t("network.opensNewTab")}</span></a
    >{noteAfter}
  </div>
</Section>

<Section eyebrow={copy.approachEyebrow} heading={copy.approachHeading}>
  <div class="max-w-2xl space-y-4 text-[length:var(--text-body)] text-neutral-600">
    {copy.approachParagraphs.map((paragraph) => <p>{paragraph}</p>)}
  </div>
</Section>

<Section class="border-t border-neutral-200 bg-mist-light !py-16">
  <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
    {copy.stats.map((stat) => <StatCallout {...stat} />)}
  </div>
</Section>

<Section eyebrow={copy.peopleEyebrow} heading={copy.teamHeading}>
  <p class="max-w-2xl text-[length:var(--text-small)] text-neutral-500">
    {copy.teamBody}
  </p>
  <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {team.map((profile) => <TeamCard profile={profile} />)}
  </div>
</Section>

<CTABanner
  tone="light"
  heading={t("cta.closingHeading")}
  body={t("cta.closingBody")}
  ctaLabel={t("schedule.getInTouch")}
  ctaHref={`${prefix}/contact`}
/>
