---
// Shared body for /about/[slug] (English) and /de/about/[slug] (German) --
// see HomePageContent.astro for the same split pattern. `profile` is
// already resolved to the correct locale by the caller (localizedCoachProfile
// in src/lib/i18n.ts); `coursesDelivered`/`upcomingSessions` always reference
// the English training-courses/training-categories entries regardless of
// locale (there's one shared set of course/session data, not duplicated per
// language -- see the getStaticPaths comment in the page files), so their
// hrefs need locale-aware slug resolution, not just a prefix -- see
// courseHref() below. `recentArticles` is already resolved
// to the correct locale by the caller too, one at a time via localizedArticle,
// so it degrades to the English original for any article without a German
// translation yet -- same graceful-fallback pattern used on the Insights hub.
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Section from "@/components/Section.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { formatSessionDate } from "@/lib/dates";
import { toPathSegment } from "@/lib/urlSlug";
import { courseBadges } from "@/data/courseBadges";
import { certificationLogos } from "@/data/certifications";
import { baseSlug, localeOfId } from "@/lib/i18n";
import { resolveLocale, useTranslations } from "@/i18n/utils";

interface Props {
  profile: CollectionEntry<"coach-profiles">;
  coursesDelivered: CollectionEntry<"training-courses">[];
  upcomingSessions: {
    session: CollectionEntry<"training-schedules">;
    course: CollectionEntry<"training-courses">;
    category: CollectionEntry<"training-categories">;
  }[];
  recentArticles: CollectionEntry<"insights-articles">[];
}

const { profile, coursesDelivered, upcomingSessions, recentArticles } = Astro.props;
const {
  name,
  role,
  country,
  languages,
  bio,
  backgroundAndExpertise,
  approach,
  specialities,
  photo,
  linkedinUrl,
  yearsExperience,
  certifications,
} = profile.data;

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const prefix = locale === "de" ? "/de" : "";

const paragraphs = (text: string) =>
  text
    .split(/\n\s*\n/)
    .map((p) => p.trim())
    .filter(Boolean);

const UPCOMING_PREVIEW_COUNT = 4;
const firstNameLabel = name.split(" ")[0];

// German word order doesn't fit the site's usual shared-key prefix/suffix
// interpolation pattern for this one possessive string, so it's built
// directly here rather than via a dictionary key (see CLAUDE.md-adjacent
// notes in src/i18n/ui.ts around the profile.* keys).
const upcomingMoreLabel =
  locale === "de" ? `Alle Trainings von ${firstNameLabel} ansehen →` : `See all ${firstNameLabel}'s training →`;
const upcomingLessLabel = `${t("profile.showLess")} ↑`;

function badgeFor(course: CollectionEntry<"training-courses">, category: CollectionEntry<"training-categories">) {
  const badge = courseBadges[course.id];
  if (badge) return { kind: "badge" as const, badge };
  const logo = category.data.certificationBody ? certificationLogos[category.data.certificationBody] : undefined;
  return logo ? { kind: "logo" as const, logo } : undefined;
}

// `course` here is always the English training-courses entry (see the file
// header comment), so its own urlSlug is only a valid path segment on the
// English route -- German course pages always route on the plain base slug
// regardless of urlSlug, per the getStaticPaths comment in
// src/pages/de/training/[category]/[course].astro. Using course.data.urlSlug
// unconditionally here produced a 404 on the German profile pages (urlSlug
// segments like "flight-level-3-design-(fl3d)" have no German route; only
// "/de/training/flight-levels/fl3d" does).
function courseHref(course: CollectionEntry<"training-courses">, categoryId: string) {
  const slug = locale === "de" ? baseSlug(course.id) : (course.data.urlSlug ?? course.id);
  return `${prefix}/training/${baseSlug(categoryId)}/${toPathSegment(slug)}`;
}

// A recentArticles entry without a German translation falls back to the
// English original (see localizedArticle) -- its href/date must go by its
// OWN locale, not the page's, or a fallback article shown here 404s at
// /de/insights/<en-slug>. Same fix as InsightsHubPageContent.astro's
// articleHref()/articleDate() for the identical fallback case.
function articleHref(article: CollectionEntry<"insights-articles">) {
  const articlePrefix = localeOfId(article.id) === "de" ? "/de" : "";
  return `${articlePrefix}/insights/${toPathSegment(article.data.urlSlug ?? baseSlug(article.id))}`;
}

const hasSidebar = upcomingSessions.length > 0 || recentArticles.length > 0;
---

<Breadcrumbs items={[{ label: t("nav.about"), href: `${prefix}/about` }, { label: name }]} />

<Section class="bg-mist-light">
  <div class="flex flex-col gap-6 sm:flex-row sm:items-center">
    {photo && <img src={photo} alt={name} class="h-28 w-28 shrink-0 rounded-full object-cover" />}
    <div>
      <p class="eyebrow">{role}</p>
      <h1 class="mt-2 text-[length:var(--text-h1)] leading-[var(--text-h1--line-height)]">{name}</h1>
      <p class="mt-3 text-[length:var(--text-small)] text-neutral-500">{country} · {languages.join(", ")}</p>
      <div class="mt-3 flex flex-wrap items-center gap-2">
        {linkedinUrl && (
          <a href={linkedinUrl} target="_blank" rel="noopener noreferrer" class="text-[length:var(--text-small)] font-semibold text-ink hover:underline">
            LinkedIn →
          </a>
        )}
        {yearsExperience && (
          <>
            <span class="text-neutral-300">·</span>
            <span class="rounded-[var(--radius-pill)] border border-neutral-300 bg-surface px-3 py-1 text-[length:var(--text-caption)] font-semibold">
              {yearsExperience} {t("profile.yearsExperienceSuffix")}
            </span>
          </>
        )}
        {certifications && certifications.length > 0 && (
          <span class="rounded-[var(--radius-pill)] border border-neutral-300 bg-surface px-3 py-1 text-[length:var(--text-caption)] font-semibold">
            {certifications.length} {t("profile.certifications")}
          </span>
        )}
      </div>
    </div>
  </div>
</Section>

<Section>
  <div class={hasSidebar ? "grid gap-10 md:grid-cols-[1.5fr_1fr] md:items-start" : ""}>
    <!-- Main narrative -->
    <div class="min-w-0 space-y-10">
      {bio && (
        <div>
          <h2 class="text-[length:var(--text-h3)]">{t("profile.bio")}</h2>
          <div class="mt-4 max-w-2xl space-y-4 text-[length:var(--text-body)] text-neutral-600">
            {paragraphs(bio).map((p) => <p>{p}</p>)}
          </div>
        </div>
      )}
      {backgroundAndExpertise && (
        <div>
          <h2 class="text-[length:var(--text-h3)]">{t("profile.backgroundExpertise")}</h2>
          <div class="mt-4 max-w-2xl space-y-4 text-[length:var(--text-body)] text-neutral-600">
            {paragraphs(backgroundAndExpertise).map((p) => <p>{p}</p>)}
          </div>
        </div>
      )}
      {approach && (
        <div>
          <h2 class="text-[length:var(--text-h3)]">{t("profile.approach")}</h2>
          <div class="mt-4 max-w-2xl space-y-4 text-[length:var(--text-body)] text-neutral-600">
            {paragraphs(approach).map((p) => <p>{p}</p>)}
          </div>
        </div>
      )}

      {((specialities && specialities.length > 0) || (certifications && certifications.length > 0) || coursesDelivered.length > 0) && (
        <div class="flex flex-wrap gap-6 border-t border-neutral-100 pt-8">
          {specialities && specialities.length > 0 && (
            <div class="flex-1 min-w-[220px]">
              <p class="text-[length:var(--text-caption)] font-semibold uppercase tracking-[0.06em] text-neutral-500">{t("profile.specialities")}</p>
              <ul class="mt-3 flex flex-wrap gap-1.5">
                {specialities.map((s) => <li class="rounded-[var(--radius-pill)] border border-neutral-200 bg-mist-light px-2.5 py-1 text-[length:var(--text-caption)]">{s}</li>)}
              </ul>
            </div>
          )}
          {certifications && certifications.length > 0 && (
            <div class="flex-1 min-w-[220px]">
              <p class="text-[length:var(--text-caption)] font-semibold uppercase tracking-[0.06em] text-neutral-500">{t("profile.certifications")}</p>
              <ul class="mt-3 flex flex-wrap gap-1.5">
                {certifications.map((c) => <li class="rounded-[var(--radius-pill)] border border-neutral-300 bg-surface px-2.5 py-1 text-[length:var(--text-caption)] font-semibold">{c}</li>)}
              </ul>
            </div>
          )}
          {coursesDelivered.length > 0 && (
            <div class="flex-1 min-w-[220px]">
              <p class="text-[length:var(--text-caption)] font-semibold uppercase tracking-[0.06em] text-neutral-500">{t("profile.coursesDelivered")}</p>
              <ul class="mt-3 flex flex-wrap gap-1.5">
                {coursesDelivered.map((course) => (
                  <li>
                    <a
                      href={courseHref(course, course.data.category.id)}
                      class="flex items-center gap-1.5 rounded-[var(--radius-pill)] border border-neutral-300 bg-surface py-1 pl-1 pr-2.5 text-[length:var(--text-caption)] font-semibold transition-colors hover:border-ink hover:text-ink"
                    >
                      {courseBadges[course.id] && (
                        <span class="flex h-5 w-5 shrink-0 items-center justify-center">
                          <Image src={courseBadges[course.id]} alt="" width={28} height={28} class="h-full w-full object-contain" />
                        </span>
                      )}
                      {course.data.code}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      )}
    </div>

    <!-- Right rail: upcoming training + recent articles, above the fold -->
    {hasSidebar && (
      <div class="order-first min-w-0 space-y-6 md:order-last md:sticky md:top-24">
        {upcomingSessions.length > 0 && (
          <div class="rounded-[var(--radius-card)] border border-neutral-200 bg-surface p-5 shadow-card">
            <p class="text-[length:var(--text-caption)] font-semibold uppercase tracking-[0.06em] text-neutral-500">{t("profile.upcomingTraining")}</p>
            <div class="mt-3 flex flex-col divide-y divide-neutral-100" id="upcoming-training-list">
              {upcomingSessions.map(({ session, course, category }, i) => {
                const b = badgeFor(course, category);
                return (
                  <a
                    href={courseHref(course, category.id)}
                    class="flex flex-col gap-2 py-3 first:pt-0 last:pb-0 transition-colors hover:bg-mist-light lg:flex-row lg:items-center lg:gap-3"
                    data-extra-session={i >= UPCOMING_PREVIEW_COUNT ? "" : undefined}
                    hidden={i >= UPCOMING_PREVIEW_COUNT}
                  >
                    <div class="flex min-w-0 flex-1 items-center gap-3">
                      {b?.kind === "badge" && (
                        <span class="flex h-8 w-8 shrink-0 items-center justify-center">
                          <Image src={b.badge} alt="" width={36} height={36} class="h-full w-full object-contain" />
                        </span>
                      )}
                      {b?.kind === "logo" && (
                        <span class="flex h-8 w-8 shrink-0 items-center justify-center">
                          <img src={b.logo.src} alt="" class="h-full w-full object-contain" />
                        </span>
                      )}
                      <div class="min-w-0 flex-1">
                        <p class="text-[length:var(--text-small)] font-semibold leading-snug">{course.data.name}</p>
                        <p class="text-[length:var(--text-caption)] text-neutral-500">{formatSessionDate(session, course, "short")}</p>
                      </div>
                    </div>
                    <span class="shrink-0 self-end text-[length:var(--text-caption)] font-semibold text-ink lg:self-auto">{t("profile.findOutMore")} →</span>
                  </a>
                );
              })}
            </div>
            {upcomingSessions.length > UPCOMING_PREVIEW_COUNT ? (
              <button
                type="button"
                id="upcoming-training-toggle"
                data-expanded="false"
                data-label-more={upcomingMoreLabel}
                data-label-less={upcomingLessLabel}
                class="mt-3 cursor-pointer text-[length:var(--text-caption)] font-semibold text-ink hover:underline"
              >
                {upcomingMoreLabel}
              </button>
            ) : (
              <a href={`${prefix}/training`} class="mt-3 inline-block text-[length:var(--text-caption)] font-semibold text-ink hover:underline">{t("cta.seeAllTraining")} →</a>
            )}
          </div>
        )}

        {recentArticles.length > 0 && (
          <div class="rounded-[var(--radius-card)] border border-neutral-200 bg-surface p-5 shadow-card">
            <p class="text-[length:var(--text-caption)] font-semibold uppercase tracking-[0.06em] text-neutral-500">{t("profile.recentArticles")}</p>
            <div class="mt-3 flex flex-col divide-y divide-neutral-100">
              {recentArticles.map((article) => (
                <a href={articleHref(article)} class="flex items-center gap-3 py-3 first:pt-0 last:pb-0 transition-colors hover:bg-mist-light">
                  <span class="block h-12 w-12 shrink-0 overflow-hidden rounded-[0.5rem] bg-mist-light">
                    {article.data.imageUrl && <img src={article.data.imageUrl} alt={article.data.title} class="h-full w-full object-cover" loading="lazy" />}
                  </span>
                  <div class="min-w-0 flex-1">
                    <p class="line-clamp-2 text-[length:var(--text-small)] font-semibold leading-snug">{article.data.title}</p>
                    <p class="mt-0.5 text-[length:var(--text-caption)] text-neutral-500">
                      {article.data.date.toLocaleDateString(localeOfId(article.id) === "de" ? "de-DE" : "en-GB", { day: "numeric", month: "short" })}
                      {article.data.readTimeMinutes && ` · ${article.data.readTimeMinutes} ${t("insights.minRead")}`}
                    </p>
                  </div>
                </a>
              ))}
            </div>
            <a href={`${prefix}/insights`} class="mt-3 inline-block text-[length:var(--text-caption)] font-semibold text-ink hover:underline">{t("profile.seeAllArticles")} →</a>
          </div>
        )}
      </div>
    )}
  </div>
</Section>

<script>
  const toggle = document.getElementById("upcoming-training-toggle") as HTMLButtonElement | null;
  const extraSessions = Array.from(document.querySelectorAll<HTMLElement>("[data-extra-session]"));

  toggle?.addEventListener("click", () => {
    const expanded = toggle.dataset.expanded === "true";
    extraSessions.forEach((row) => {
      row.hidden = expanded;
    });
    toggle.dataset.expanded = String(!expanded);
    toggle.textContent = expanded ? toggle.dataset.labelMore! : toggle.dataset.labelLess!;
  });
</script>
