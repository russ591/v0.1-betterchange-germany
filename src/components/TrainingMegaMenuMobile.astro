---
// Nested <details> accordion shown in place of a flat "Training" link
// inside the mobile menu drawer (see Header.astro). Two levels: tapping
// "Training" reveals the 6 categories, tapping a category reveals its
// courses -- all native <details>/<summary>, no JS, matching the same
// pattern already used for the drawer itself.
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { categoryIcons } from "@/data/categoryIcons";
import { certificationLogos } from "@/data/certifications";
import { courseBadges } from "@/data/courseBadges";
import { toPathSegment } from "@/lib/urlSlug";

interface Props {
  categoriesWithCourses: {
    category: CollectionEntry<"training-categories">;
    courses: CollectionEntry<"training-courses">[];
  }[];
}

const { categoriesWithCourses } = Astro.props;

// Fallback certification-body logo per category, keyed by category id, for
// the rare course with no specific badge in courseBadges -- see
// TrainingMegaMenuDesktop.astro, which shows the same icon next to each
// course row on desktop.
const logoByCategory = Object.fromEntries(
  categoriesWithCourses.map(({ category }) => [
    category.id,
    category.data.certificationBody ? certificationLogos[category.data.certificationBody] : undefined,
  ])
);
---

<details class="group/training border-b border-neutral-100">
  <summary class="flex cursor-pointer list-none items-center justify-between py-2 text-sm font-medium text-ink">
    Training
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      class="h-4 w-4 shrink-0 text-neutral-500 transition-transform group-open/training:rotate-180"
    >
      <path d="m6 9 6 6 6-6" />
    </svg>
  </summary>
  <div class="-mx-6 mb-2 bg-mist-light pb-3 pt-1">
    <a
      href="/training"
      class="flex items-center justify-between gap-2.5 border-b border-neutral-200 px-6 py-2.5 text-[length:var(--text-small)] font-semibold text-ink"
    >
      <span class="flex items-center gap-2.5">
        <span
          aria-hidden="true"
          class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-lime [&_svg]:h-3.5 [&_svg]:w-3.5"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="#0a0a0a" stroke-width="2">
            <rect x="3" y="3" width="7" height="7" rx="1" />
            <rect x="14" y="3" width="7" height="7" rx="1" />
            <rect x="3" y="14" width="7" height="7" rx="1" />
            <rect x="14" y="14" width="7" height="7" rx="1" />
          </svg>
        </span>
        Training Home
      </span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-3.5 w-3.5 shrink-0 text-neutral-400">
        <path d="m9 6 6 6-6 6" />
      </svg>
    </a>
    {
      categoriesWithCourses.map(({ category, courses }) => (
        <details class="group/category border-b border-neutral-200 px-6 last:border-0">
          <summary class="flex cursor-pointer list-none items-center justify-between py-2.5 text-[length:var(--text-small)] font-semibold text-ink">
            <span class="flex items-center gap-2.5">
              {categoryIcons[category.id] && (
                <span
                  aria-hidden="true"
                  class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-neutral-200 bg-surface [&_svg]:h-3.5 [&_svg]:w-3.5"
                  set:html={categoryIcons[category.id]}
                />
              )}
              {category.data.name}
            </span>
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              class="h-3.5 w-3.5 shrink-0 text-neutral-500 transition-transform group-open/category:rotate-180"
            >
              <path d="m6 9 6 6 6-6" />
            </svg>
          </summary>
          <div class="space-y-0.5 py-1.5 pl-6">
            {courses.map((course) => (
              <a
                href={`/training/${category.id}/${toPathSegment(course.data.urlSlug ?? course.id)}`}
                class="flex items-center gap-2 py-1.5 text-[length:var(--text-caption)] text-neutral-600"
              >
                {courseBadges[course.id] ? (
                  <span class="flex h-4 w-6 shrink-0 items-center justify-center">
                    <Image src={courseBadges[course.id]} alt="" width={24} height={16} class="max-h-3.5 max-w-full object-contain" />
                  </span>
                ) : (
                  logoByCategory[category.id] && (
                    <span class="flex h-4 w-6 shrink-0 items-center justify-center">
                      <img
                        src={logoByCategory[category.id]!.src}
                        alt=""
                        width={logoByCategory[category.id]!.width}
                        height={logoByCategory[category.id]!.height}
                        class="max-h-3.5 max-w-full object-contain"
                      />
                    </span>
                  )
                )}
                <span class="min-w-0 flex-1 truncate">{course.data.name}</span>
              </a>
            ))}
          </div>
        </details>
      ))
    }
    <div class="mx-6 mt-3 rounded-[var(--radius-card)] bg-ink p-4 text-surface">
      <p class="text-[length:var(--text-caption)] font-bold uppercase tracking-[0.06em] text-lime">
        Not sure where to start?
      </p>
      <h3 class="mt-1.5 text-[length:var(--text-small)] font-semibold">Talk to us about your team's situation</h3>
      <a
        href="/contact"
        class="mt-3 block rounded-[var(--radius-control)] bg-lime px-4 py-2 text-center text-[length:var(--text-small)] font-semibold text-ink"
      >
        Contact us &rarr;
      </a>
    </div>
  </div>
</details>
