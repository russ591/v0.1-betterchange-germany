---
// Hover/focus panel shown under the "Training" nav link on desktop (see
// Header.astro, which wraps this in a `.group` and toggles the panel's own
// visibility with group-hover/group-focus-within -- no JS needed for that
// part). Inside the panel: a category list on the left (with "Training
// Home" pinned above it as its own trigger/panel pair, active by default),
// and the hovered/focused item's content on the right -- Training Home
// shows a mini grid of all six disciplines, any other category shows its
// full-width course list, each course row wide enough for real course names
// ("ICAgile Agile Coaching Professional (ICP-ACC)") without wrapping.
// Swapping which item's content shows is the one bit of actual
// interactivity here, handled by the small inline script below (same
// mouseenter/click pattern already used for the schedule filter buttons in
// ScheduleList.astro).
import type { CollectionEntry } from "astro:content";
import { categoryIcons } from "@/data/categoryIcons";
import { certificationLogos } from "@/data/certifications";
import { toPathSegment } from "@/lib/urlSlug";

interface Props {
  categoriesWithCourses: {
    category: CollectionEntry<"training-categories">;
    courses: CollectionEntry<"training-courses">[];
  }[];
}

const { categoriesWithCourses } = Astro.props;

// One certification-body logo per category, keyed by category id, so each
// course row in the panel can show the body that actually certifies it
// without a per-course lookup.
const logoByCategory = Object.fromEntries(
  categoriesWithCourses.map(({ category }) => [
    category.id,
    category.data.certificationBody ? certificationLogos[category.data.certificationBody] : undefined,
  ])
);
---

<div
  class="invisible absolute left-1/2 top-full z-50 -translate-x-1/2 opacity-0 transition-opacity duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100"
>
  <div class="w-[min(92vw,960px)] pt-3">
    <div class="training-mega flex overflow-hidden rounded-[var(--radius-card)] border border-neutral-200 bg-surface shadow-card-hover">
      <div class="flex w-56 shrink-0 flex-col gap-0.5 border-r border-neutral-100 bg-mist-light p-3">
        <a
          href="/training"
          data-cat-trigger="__home"
          class="mega-cat-trigger is-active flex items-center justify-between gap-2 rounded-[var(--radius-control)] bg-surface px-3 py-2.5 text-[length:var(--text-small)] font-semibold text-ink shadow-card transition-colors hover:bg-surface"
        >
          <span class="flex items-center gap-2.5">
            <span
              aria-hidden="true"
              class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-lime [&_svg]:h-3.5 [&_svg]:w-3.5"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="#0a0a0a" stroke-width="2">
                <rect x="3" y="3" width="7" height="7" rx="1" />
                <rect x="14" y="3" width="7" height="7" rx="1" />
                <rect x="3" y="14" width="7" height="7" rx="1" />
                <rect x="14" y="14" width="7" height="7" rx="1" />
              </svg>
            </span>
            Training Home
          </span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-3.5 w-3.5 shrink-0 text-neutral-400">
            <path d="m9 6 6 6-6 6" />
          </svg>
        </a>
        <div class="my-1 border-t border-neutral-200"></div>
        {
          categoriesWithCourses.map(({ category }) => (
            <a
              href={`/training/${category.id}`}
              data-cat-trigger={category.id}
              class="mega-cat-trigger flex items-center justify-between gap-2 rounded-[var(--radius-control)] px-3 py-2.5 text-[length:var(--text-small)] font-semibold text-ink transition-colors hover:bg-surface"
            >
              <span class="flex items-center gap-2.5">
                {categoryIcons[category.id] && (
                  <span
                    aria-hidden="true"
                    class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-neutral-200 bg-surface [&_svg]:h-3.5 [&_svg]:w-3.5"
                    set:html={categoryIcons[category.id]}
                  />
                )}
                {category.data.name}
              </span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-3.5 w-3.5 shrink-0 text-neutral-400">
                <path d="m9 6 6 6-6 6" />
              </svg>
            </a>
          ))
        }
      </div>

      <div class="min-w-0 flex-1 px-5 py-6">
        <div class="mega-cat-panel" data-cat-panel="__home">
          <p class="text-[length:var(--text-caption)] text-neutral-500">Six disciplines, one practitioner network.</p>
          <div class="mt-3 grid grid-cols-2 gap-3">
            {
              categoriesWithCourses.map(({ category, courses }) => (
                <a
                  href={`/training/${category.id}`}
                  class="flex flex-col gap-2 rounded-[var(--radius-control)] border border-neutral-200 p-3 transition-colors hover:border-neutral-400 hover:shadow-card"
                >
                  {categoryIcons[category.id] && (
                    <span
                      aria-hidden="true"
                      class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-lime [&_svg]:h-4 [&_svg]:w-4"
                      set:html={categoryIcons[category.id]}
                    />
                  )}
                  <span class="text-[length:var(--text-small)] font-semibold text-ink">{category.data.name}</span>
                  <span class="text-[length:var(--text-caption)] text-neutral-500">{courses.length} courses &rarr;</span>
                </a>
              ))
            }
          </div>
        </div>
        {
          categoriesWithCourses.map(({ category, courses }) => (
            <div class="mega-cat-panel" data-cat-panel={category.id} hidden>
              <p class="text-[length:var(--text-caption)] text-neutral-500">{category.data.tagline}</p>
              <div class="mt-3 flex flex-col gap-2">
                {courses.map((course) => (
                  <a
                    href={`/training/${category.id}/${toPathSegment(course.data.urlSlug ?? course.id)}`}
                    class="flex items-center gap-2.5 text-[length:var(--text-small)] text-neutral-600 hover:text-ink hover:underline"
                  >
                    {logoByCategory[category.id] && (
                      <span class="flex h-5 w-8 shrink-0 items-center justify-center">
                        <img
                          src={logoByCategory[category.id]!.src}
                          alt=""
                          width={logoByCategory[category.id]!.width}
                          height={logoByCategory[category.id]!.height}
                          class="max-h-4 max-w-full object-contain"
                        />
                      </span>
                    )}
                    <span class="min-w-0 flex-1 truncate">{course.data.name}</span>
                  </a>
                ))}
              </div>
            </div>
          ))
        }
      </div>

      <div class="flex w-56 shrink-0 flex-col bg-ink p-5 text-surface">
        <p class="text-[length:var(--text-caption)] font-bold uppercase tracking-[0.06em] text-lime">
          Not sure where to start?
        </p>
        <h3 class="mt-2 text-[length:var(--text-small)] font-semibold leading-snug">
          Talk to us about your team's situation
        </h3>
        <p class="mt-2 flex-1 text-[length:var(--text-caption)] text-neutral-300">
          We'll help you pick the right discipline and format, in-person, live online, or self-paced.
        </p>
        <a
          href="/contact"
          class="mt-4 rounded-[var(--radius-control)] bg-lime px-4 py-2.5 text-center text-[length:var(--text-small)] font-semibold text-ink transition-colors hover:bg-lime/85"
        >
          Contact us &rarr;
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>(".training-mega").forEach((menu) => {
    const triggers = Array.from(menu.querySelectorAll<HTMLElement>(".mega-cat-trigger"));
    const panels = Array.from(menu.querySelectorAll<HTMLElement>(".mega-cat-panel"));

    function activate(id: string | undefined) {
      if (!id) return;
      triggers.forEach((t) => t.classList.toggle("is-active", t.dataset.catTrigger === id));
      triggers.forEach((t) => t.classList.toggle("bg-surface", t.dataset.catTrigger === id));
      triggers.forEach((t) => t.classList.toggle("shadow-card", t.dataset.catTrigger === id));
      panels.forEach((p) => (p.hidden = p.dataset.catPanel !== id));
    }

    triggers.forEach((trigger) => {
      trigger.addEventListener("mouseenter", () => activate(trigger.dataset.catTrigger));
      trigger.addEventListener("focus", () => activate(trigger.dataset.catTrigger));
    });
  });
</script>
