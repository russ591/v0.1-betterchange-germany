---
// Hover/focus panel shown under the "Training" nav link on desktop (see
// Header.astro, which wraps this in a `.group` and toggles visibility with
// group-hover/group-focus-within -- no JS needed). Each category column
// only shows its first few courses to keep the panel a fixed height
// regardless of how many courses a discipline has (Scrum currently has 7);
// the rest are reachable via the category's own page.
import type { CollectionEntry } from "astro:content";
import { categoryIcons } from "@/data/categoryIcons";
import { toPathSegment } from "@/lib/urlSlug";

interface Props {
  categoriesWithCourses: {
    category: CollectionEntry<"training-categories">;
    courses: CollectionEntry<"training-courses">[];
  }[];
}

const { categoriesWithCourses } = Astro.props;
const MAX_VISIBLE_COURSES = 4;
---

<div
  class="invisible absolute left-0 right-0 top-full z-50 opacity-0 transition-opacity duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100"
>
  <div class="mx-auto w-[min(92vw,960px)] pt-3">
    <div class="flex gap-7 rounded-[var(--radius-card)] border border-neutral-200 bg-surface p-7 shadow-card-hover">
      <div class="grid flex-1 grid-cols-3 gap-x-7 gap-y-6">
        {
          categoriesWithCourses.map(({ category, courses }) => (
            <div class="min-w-0">
              <a
                href={`/training/${category.id}`}
                class="flex items-center gap-2 text-sm font-semibold text-ink hover:text-ink"
              >
                {categoryIcons[category.id] && (
                  <span
                    aria-hidden="true"
                    class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-neutral-200 bg-neutral-50 [&_svg]:h-4 [&_svg]:w-4"
                    set:html={categoryIcons[category.id]}
                  />
                )}
                {category.data.name}
              </a>
              <ul class="mt-2.5 space-y-1.5">
                {courses.slice(0, MAX_VISIBLE_COURSES).map((course) => (
                  <li>
                    <a
                      href={`/training/${category.id}/${toPathSegment(course.data.urlSlug ?? course.id)}`}
                      class="text-[length:var(--text-small)] text-neutral-600 hover:text-ink hover:underline"
                    >
                      {course.data.name}
                    </a>
                  </li>
                ))}
                {courses.length > MAX_VISIBLE_COURSES && (
                  <li>
                    <a href={`/training/${category.id}`} class="text-[length:var(--text-small)] font-semibold text-ink hover:underline">
                      +{courses.length - MAX_VISIBLE_COURSES} more &rarr;
                    </a>
                  </li>
                )}
              </ul>
            </div>
          ))
        }
      </div>

      <div class="flex w-60 shrink-0 flex-col rounded-[var(--radius-card)] bg-ink p-5 text-surface">
        <p class="text-[length:var(--text-caption)] font-bold uppercase tracking-[0.06em] text-lime">
          Not sure where to start?
        </p>
        <h3 class="mt-2 text-[length:var(--text-small)] font-semibold leading-snug">
          Talk to us about your team's situation
        </h3>
        <p class="mt-2 flex-1 text-[length:var(--text-caption)] text-neutral-300">
          We'll help you pick the right discipline and format — in-person, live online, or self-paced.
        </p>
        <a
          href="/contact"
          class="mt-4 rounded-[var(--radius-control)] bg-lime px-4 py-2.5 text-center text-[length:var(--text-small)] font-semibold text-ink transition-colors hover:bg-lime/85"
        >
          Contact us &rarr;
        </a>
      </div>
    </div>
  </div>
</div>
