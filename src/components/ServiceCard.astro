---
import { resolveLocale, useTranslations } from "@/i18n/utils";

interface Props {
  name: string;
  items?: string[];
  blurb?: string;
  href?: string;
  learnLabel?: string;
}

const t = useTranslations(resolveLocale(Astro.currentLocale));
const { name, items, blurb, href, learnLabel = t("cta.learnMore") } = Astro.props;
// Whole-card link (same pattern as the training category cards on
// /training) rather than just the "Learn more" line -- with the entire
// card already a link, that line becomes plain text underneath it, group-hover
// underlined, instead of a second, nested <a>.
const Tag = href ? "a" : "div";
---

<Tag
  href={href}
  class="group flex flex-col rounded-[var(--radius-card)] border border-neutral-200 bg-surface p-8 shadow-card transition-shadow hover:shadow-card-hover"
>
  <span aria-hidden="true" class="blob-dot flex h-11 w-11 items-center justify-center bg-lime">
    <slot name="icon" />
  </span>
  <h3 class="mt-4 text-[length:var(--text-h4)]">{name}</h3>
  {blurb && <p class="mt-2 text-[length:var(--text-small)] text-neutral-600">{blurb}</p>}
  {
    items && (
      <ul class="mt-4 space-y-2 text-[length:var(--text-small)] text-neutral-600">
        {items.map((item) => (
          <li class="flex items-start gap-2">
            <span aria-hidden="true" class="blob-dot mt-2 h-1.5 w-1.5 shrink-0 bg-lime" />
            {item}
          </li>
        ))}
      </ul>
    )
  }
  {
    href && (
      <span class="mt-6 inline-flex items-center gap-1 text-sm font-semibold text-ink group-hover:underline">
        {learnLabel} <span aria-hidden="true">→</span>
      </span>
    )
  }
</Tag>
