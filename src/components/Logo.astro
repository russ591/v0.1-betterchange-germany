---
// Wordmark: a lime dot followed by "Better" (bold) + "Change" (bold
// italic), no gap between the two words -- matches the live betterchange-
// consulting.com mark. Below it, right-justified under "Change", a small
// tricolour flag tab + "GERMANY" caption tags the regional site.
interface Props {
  size?: "default" | "medium" | "large";
  tone?: "dark" | "light";
  class?: string;
}

const { size = "default", tone = "dark", class: className = "" } = Astro.props;

const dotSize = size === "large" ? "h-9 w-9" : size === "medium" ? "h-8 w-8" : "h-6 w-6";
const textSize = size === "large" ? "text-3xl" : size === "medium" ? "text-2xl" : "text-lg";
const rowGap = size === "large" ? "gap-1" : size === "medium" ? "gap-0.5" : "gap-0";
const wordGap = size === "large" ? "gap-2.5" : size === "medium" ? "gap-2" : "gap-1.5";
const flagSize = size === "large" ? "h-[13px] w-5" : size === "medium" ? "h-3 w-[18px]" : "h-2 w-3";
const captionSize = size === "large" ? "text-xs" : size === "medium" ? "text-[11px]" : "text-[9px]";

const isLight = tone === "light";
---

<span class={`inline-flex flex-col items-end ${rowGap} ${className}`}>
  <span class={`inline-flex items-center self-start ${wordGap}`}>
    <span aria-hidden="true" class={`blob-dot shrink-0 bg-lime ${dotSize}`}></span>
    <span
      class={`${textSize} whitespace-nowrap font-extrabold tracking-tight ${isLight ? "text-surface" : "text-ink"}`}
    >
      Better<span class="italic">Change</span>
    </span>
  </span>
  <span class="inline-flex items-center gap-1.5">
    <span
      aria-hidden="true"
      class={`flex flex-col overflow-hidden rounded-[1px] ${flagSize} ${isLight ? "ring-1 ring-white/20" : ""}`}
    >
      <span class={`flex-1 ${isLight ? "bg-neutral-400" : "bg-de-black"}`}></span>
      <span class="flex-1 bg-de-red"></span>
      <span class="flex-1 bg-de-gold"></span>
    </span>
    <span
      class={`${captionSize} font-semibold uppercase tracking-[0.18em] ${isLight ? "text-neutral-400" : "text-neutral-500"}`}
    >
      Germany
    </span>
  </span>
</span>
