---
import { getCollection, getEntry, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { formatSessionDate } from "@/lib/dates";
import { toPathSegment } from "@/lib/urlSlug";
import { courseBadges } from "@/data/courseBadges";
import { certificationLogos } from "@/data/certifications";

// Spec §2 bug 1: only profiles with hasFullProfile: true get a page here —
// this is the "resolved" behaviour, since the About index only links to
// profiles in this set (see TeamCard.astro).
export async function getStaticPaths() {
  const profiles = await getCollection("coach-profiles", ({ data }) => data.hasFullProfile);
  const courses = await getCollection("training-courses");
  // course codes in Fellows.coursesDelivered don't always match
  // TrainingCourse.code punctuation exactly (e.g. "ICP-ACC" vs "ICPACC")
  const normalize = (s: string) => s.replace(/[^a-z0-9]/gi, "").toUpperCase();
  return profiles.map((profile) => ({
    params: { slug: profile.data.urlSlug ?? profile.id },
    props: {
      profile,
      coursesDelivered: (profile.data.coursesDelivered ?? [])
        .map((code) => courses.find((c) => normalize(c.data.code) === normalize(code)))
        .filter((c) => c !== undefined),
    },
  }));
}

const { profile, coursesDelivered } = Astro.props;
const {
  name,
  role,
  country,
  languages,
  bio,
  backgroundAndExpertise,
  approach,
  specialities,
  photo,
  linkedinUrl,
  yearsExperience,
  certifications,
} = profile.data;

const paragraphs = (text: string) =>
  text
    .split(/\n\s*\n/)
    .map((p) => p.trim())
    .filter(Boolean);

// "About your trainer(s)" companion data: what this person is teaching next
// and what they've written recently. Both are optional add-ons -- most
// profiles (everyone except Russell Hill today) won't have either yet, and
// the sections simply don't render for them.
const allSchedules = await getCollection("training-schedules");
const upcomingSessions = await Promise.all(
  allSchedules
    .filter((s) => s.data.trainers?.some((t) => t.id === profile.id) && s.data.date && s.data.date >= new Date())
    .sort((a, b) => a.data.date!.valueOf() - b.data.date!.valueOf())
    .slice(0, 4)
    .map(async (session) => {
      const course = await getEntry(session.data.course);
      const category = await getEntry(course.data.category);
      return { session, course, category };
    })
);

function badgeFor(course: CollectionEntry<"training-courses">, category: CollectionEntry<"training-categories">) {
  const badge = courseBadges[course.id];
  if (badge) return { kind: "badge" as const, badge };
  const logo = category.data.certificationBody ? certificationLogos[category.data.certificationBody] : undefined;
  return logo ? { kind: "logo" as const, logo } : undefined;
}

const allArticles = await getCollection("insights-articles");
const recentArticles = allArticles
  .filter((a) => a.data.author?.id === profile.id)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

const hasSidebar = upcomingSessions.length > 0 || recentArticles.length > 0;
---

<BaseLayout title={name} description={bio ? bio.slice(0, 160) : `${name} — ${role} at Better Change`}>
  <Breadcrumbs items={[{ label: "About", href: "/about" }, { label: name }]} />

  <Section class="bg-mist-light">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-center">
      {photo && <img src={photo} alt={name} class="h-28 w-28 shrink-0 rounded-full object-cover" />}
      <div>
        <p class="eyebrow">{role}</p>
        <h1 class="mt-2 text-[length:var(--text-h1)] leading-[var(--text-h1--line-height)]">{name}</h1>
        <p class="mt-3 text-[length:var(--text-small)] text-neutral-500">{country} · {languages.join(", ")}</p>
        <div class="mt-3 flex flex-wrap items-center gap-2">
          {linkedinUrl && (
            <a href={linkedinUrl} target="_blank" rel="noopener noreferrer" class="text-[length:var(--text-small)] font-semibold text-ink hover:underline">
              LinkedIn →
            </a>
          )}
          {yearsExperience && (
            <>
              <span class="text-neutral-300">·</span>
              <span class="rounded-[var(--radius-pill)] border border-neutral-300 bg-surface px-3 py-1 text-[length:var(--text-caption)] font-semibold">
                {yearsExperience} years experience
              </span>
            </>
          )}
          {certifications && certifications.length > 0 && (
            <span class="rounded-[var(--radius-pill)] border border-neutral-300 bg-surface px-3 py-1 text-[length:var(--text-caption)] font-semibold">
              {certifications.length} certifications
            </span>
          )}
        </div>
      </div>
    </div>
  </Section>

  <Section>
    <div class={hasSidebar ? "grid gap-10 md:grid-cols-[1.5fr_1fr] md:items-start" : ""}>
      <!-- Main narrative -->
      <div class="min-w-0 space-y-10">
        {bio && (
          <div>
            <h2 class="text-[length:var(--text-h3)]">Bio</h2>
            <div class="mt-4 max-w-2xl space-y-4 text-[length:var(--text-body)] text-neutral-600">
              {paragraphs(bio).map((p) => <p>{p}</p>)}
            </div>
          </div>
        )}
        {backgroundAndExpertise && (
          <div>
            <h2 class="text-[length:var(--text-h3)]">Background &amp; expertise</h2>
            <div class="mt-4 max-w-2xl space-y-4 text-[length:var(--text-body)] text-neutral-600">
              {paragraphs(backgroundAndExpertise).map((p) => <p>{p}</p>)}
            </div>
          </div>
        )}
        {approach && (
          <div>
            <h2 class="text-[length:var(--text-h3)]">Approach</h2>
            <div class="mt-4 max-w-2xl space-y-4 text-[length:var(--text-body)] text-neutral-600">
              {paragraphs(approach).map((p) => <p>{p}</p>)}
            </div>
          </div>
        )}

        {((specialities && specialities.length > 0) || (certifications && certifications.length > 0) || coursesDelivered.length > 0) && (
          <div class="flex flex-wrap gap-6 border-t border-neutral-100 pt-8">
            {specialities && specialities.length > 0 && (
              <div class="flex-1 min-w-[220px]">
                <p class="text-[length:var(--text-caption)] font-semibold uppercase tracking-[0.06em] text-neutral-500">Specialities</p>
                <ul class="mt-3 flex flex-wrap gap-1.5">
                  {specialities.map((s) => <li class="rounded-[var(--radius-pill)] border border-neutral-200 bg-mist-light px-2.5 py-1 text-[length:var(--text-caption)]">{s}</li>)}
                </ul>
              </div>
            )}
            {certifications && certifications.length > 0 && (
              <div class="flex-1 min-w-[220px]">
                <p class="text-[length:var(--text-caption)] font-semibold uppercase tracking-[0.06em] text-neutral-500">Certifications</p>
                <ul class="mt-3 flex flex-wrap gap-1.5">
                  {certifications.map((c) => <li class="rounded-[var(--radius-pill)] border border-neutral-300 bg-surface px-2.5 py-1 text-[length:var(--text-caption)] font-semibold">{c}</li>)}
                </ul>
              </div>
            )}
            {coursesDelivered.length > 0 && (
              <div class="flex-1 min-w-[220px]">
                <p class="text-[length:var(--text-caption)] font-semibold uppercase tracking-[0.06em] text-neutral-500">Courses delivered</p>
                <ul class="mt-3 flex flex-wrap gap-1.5">
                  {coursesDelivered.map((course) => (
                    <li>
                      <a
                        href={`/training/${course.data.category.id}/${toPathSegment(course.data.urlSlug ?? course.id)}`}
                        class="rounded-[var(--radius-pill)] border border-neutral-300 bg-surface px-2.5 py-1 text-[length:var(--text-caption)] font-semibold transition-colors hover:border-ink hover:text-ink"
                      >
                        {course.data.code}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        )}
      </div>

      <!-- Right rail: upcoming training + recent articles, above the fold -->
      {hasSidebar && (
        <div class="order-first min-w-0 space-y-6 md:order-last md:sticky md:top-24">
          {upcomingSessions.length > 0 && (
            <div class="rounded-[var(--radius-card)] border border-neutral-200 bg-surface p-5 shadow-card">
              <p class="text-[length:var(--text-caption)] font-semibold uppercase tracking-[0.06em] text-neutral-500">Upcoming training</p>
              <div class="mt-3 flex flex-col divide-y divide-neutral-100">
                {upcomingSessions.map(({ session, course, category }) => {
                  const b = badgeFor(course, category);
                  return (
                    <a
                      href={`/training/${category.id}/${toPathSegment(course.data.urlSlug ?? course.id)}`}
                      class="flex flex-col gap-2 py-3 first:pt-0 last:pb-0 transition-colors hover:bg-mist-light lg:flex-row lg:items-center lg:gap-3"
                    >
                      <div class="flex min-w-0 flex-1 items-center gap-3">
                        {b?.kind === "badge" && <Image src={b.badge} alt="" width={36} height={36} class="h-8 w-8 shrink-0 rounded-full" />}
                        {b?.kind === "logo" && (
                          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-neutral-200 bg-mist-light p-1">
                            <img src={b.logo.src} alt="" class="h-full w-full object-contain" />
                          </span>
                        )}
                        <div class="min-w-0 flex-1">
                          <p class="text-[length:var(--text-small)] font-semibold leading-snug">{course.data.name}</p>
                          <p class="text-[length:var(--text-caption)] text-neutral-500">{formatSessionDate(session, course, "short")}</p>
                        </div>
                      </div>
                      <span class="shrink-0 self-end text-[length:var(--text-caption)] font-semibold text-ink lg:self-auto">Find out more →</span>
                    </a>
                  );
                })}
              </div>
              <a href="/training" class="mt-3 inline-block text-[length:var(--text-caption)] font-semibold text-ink hover:underline">See all training →</a>
            </div>
          )}

          {recentArticles.length > 0 && (
            <div class="rounded-[var(--radius-card)] border border-neutral-200 bg-surface p-5 shadow-card">
              <p class="text-[length:var(--text-caption)] font-semibold uppercase tracking-[0.06em] text-neutral-500">Recent articles</p>
              <div class="mt-3 flex flex-col divide-y divide-neutral-100">
                {recentArticles.map((article) => (
                  <a href={`/insights/${toPathSegment(article.data.urlSlug ?? article.id)}`} class="flex items-center gap-3 py-3 first:pt-0 last:pb-0 transition-colors hover:bg-mist-light">
                    <span class="block h-12 w-12 shrink-0 overflow-hidden rounded-[0.5rem] bg-mist-light">
                      {article.data.imageUrl && <img src={article.data.imageUrl} alt="" class="h-full w-full object-cover" loading="lazy" />}
                    </span>
                    <div class="min-w-0 flex-1">
                      <p class="line-clamp-2 text-[length:var(--text-small)] font-semibold leading-snug">{article.data.title}</p>
                      <p class="mt-0.5 text-[length:var(--text-caption)] text-neutral-500">
                        {article.data.date.toLocaleDateString("en-GB", { day: "numeric", month: "short" })}
                        {article.data.readTimeMinutes && ` · ${article.data.readTimeMinutes} min`}
                      </p>
                    </div>
                  </a>
                ))}
              </div>
              <a href="/insights" class="mt-3 inline-block text-[length:var(--text-caption)] font-semibold text-ink hover:underline">See all articles →</a>
            </div>
          )}
        </div>
      )}
    </div>
  </Section>
</BaseLayout>
