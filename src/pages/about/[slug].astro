---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import AboutProfilePageContent from "@/components/pages/AboutProfilePageContent.astro";
import { toPathSegment } from "@/lib/urlSlug";
import { localeOfId, baseSlug } from "@/lib/i18n";

// Spec §2 bug 1: only profiles with hasFullProfile: true get a page here —
// this is the "resolved" behaviour, since the About index only links to
// profiles in this set (see TeamCard.astro). This route is the English
// one, so it must only ever generate English paths; /de/about/[slug].astro
// is the German counterpart.
export async function getStaticPaths() {
  const profiles = await getCollection(
    "coach-profiles",
    ({ data, id }) => data.hasFullProfile && localeOfId(id) === "en"
  );
  // Individual coach profile pages don't translate course/session data --
  // there's one shared set of course/session instances, not duplicated per
  // language -- only ever link out to the English course pages, not the
  // German placeholder entries the courses collection now also contains.
  const courses = await getCollection("training-courses", (c) => localeOfId(c.id) === "en");
  // course codes in Fellows.coursesDelivered don't always match
  // TrainingCourse.code punctuation exactly (e.g. "ICP-ACC" vs "ICPACC")
  const normalize = (s: string) => s.replace(/[^a-z0-9]/gi, "").toUpperCase();
  return profiles.map((profile) => ({
    params: { slug: profile.data.urlSlug ?? profile.id },
    props: {
      profile,
      coursesDelivered: (profile.data.coursesDelivered ?? [])
        .map((code) => courses.find((c) => normalize(c.data.code) === normalize(code)))
        .filter((c) => c !== undefined),
    },
  }));
}

const { profile, coursesDelivered } = Astro.props;
const { bio, name, role } = profile.data;

// "About your trainer(s)" companion data: what this person is teaching next
// and what they've written recently. Both are optional add-ons -- most
// profiles (everyone except Russell Hill today) won't have either yet, and
// the sections simply don't render for them.
const allSchedules = await getCollection("training-schedules");
const upcomingSessions = await Promise.all(
  allSchedules
    .filter((s) => s.data.trainers?.some((t) => t.id === profile.id) && s.data.date && s.data.date >= new Date())
    .sort((a, b) => a.data.date!.valueOf() - b.data.date!.valueOf())
    .map(async (session) => {
      const course = await getEntry(session.data.course);
      const category = await getEntry(course.data.category);
      return { session, course, category };
    })
);

// A growing few articles now have a German translation alongside them,
// which this English route must not surface as if it were a separate,
// distinct article -- allArticles stays English-only.
const allArticles = await getCollection("insights-articles", (a) => localeOfId(a.id) === "en");
const recentArticles = allArticles
  .filter((a) => a.data.author?.id === profile.id)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

// Only the German coach profiles that exist get a switcher/hreflang pair --
// every hasFullProfile entry does today, but this stays defensive (same
// shape as insights articles) rather than assuming so for a future profile
// added without its German counterpart yet.
const deProfile = await getEntry("coach-profiles", `de/${baseSlug(profile.id)}`);
---

<BaseLayout
  title={name}
  description={bio ? bio.slice(0, 160) : `${name}, ${role} at Better Change`}
  translations={
    deProfile
      ? {
          en: `/about/${toPathSegment(profile.data.urlSlug ?? baseSlug(profile.id))}`,
          de: `/de/about/${toPathSegment(deProfile.data.urlSlug ?? baseSlug(deProfile.id))}`,
        }
      : undefined
  }
>
  <AboutProfilePageContent
    profile={profile}
    coursesDelivered={coursesDelivered}
    upcomingSessions={upcomingSessions}
    recentArticles={recentArticles}
  />
</BaseLayout>
