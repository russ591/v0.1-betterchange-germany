---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import SelfPacedPageContent from "@/components/pages/SelfPacedPageContent.astro";
import { toPathSegment } from "@/lib/urlSlug";
import { localeOfId, baseSlug } from "@/lib/i18n";
import { getTrainersForSessions } from "@/lib/trainers";
import { metaOrFallback } from "@/i18n/utils";

export async function getStaticPaths() {
  const courses = await getCollection(
    "training-courses",
    (c) => localeOfId(c.id) === "de" && c.data.formats.includes("self-paced")
  );
  return courses.map((course) => ({
    // German entries never set their own urlSlug -- the path segment is
    // always the shared base slug, same as [course].astro.
    params: { category: baseSlug(course.data.category.id), course: baseSlug(course.id) },
    props: { course },
  }));
}

const { course } = Astro.props;
const category = await getEntry(course.data.category);

const allSchedules = await getCollection("training-schedules");
const selfPacedSession = allSchedules.find(
  (s) => baseSlug(s.data.course.id) === baseSlug(course.id) && s.data.format === "self-paced"
)!;
const trainers = await getTrainersForSessions([selfPacedSession]);

const categorySlug = baseSlug(category.id);
const courseSlug = baseSlug(course.id);

// The English counterpart may have a real urlSlug (special characters,
// parentheses) that differs from the plain base slug -- look it up rather
// than assuming it matches, same as [course].astro.
const enCourse = await getEntry("training-courses", courseSlug);
const enCourseSlug = toPathSegment(enCourse?.data.urlSlug ?? courseSlug);
---

<BaseLayout
  title={`Self-Paced ${metaOrFallback(course.data.metaTitle, course.data.name)}`}
  description={metaOrFallback(course.data.metaDescription, course.data.summary)}
  translations={{
    en: `/training/${categorySlug}/${enCourseSlug}/self-paced`,
    de: `/de/training/${categorySlug}/${courseSlug}/self-paced`,
  }}
>
  <SelfPacedPageContent course={course} category={category} selfPacedSession={selfPacedSession} trainers={trainers} />
</BaseLayout>
