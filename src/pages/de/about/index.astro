---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import AboutPageContent from "@/components/pages/AboutPageContent.astro";
import { localeOfId, localizedCoachProfile } from "@/lib/i18n";

const copy = (await getEntry("about-page", "de"))!.data;

// Same canonical (English) roster as /about, each resolved to its German
// translation -- every hasFullProfile coach now has one, but this still
// falls back to English for anyone added without a translation yet (see
// localizedCoachProfile).
const teamEn = (await getCollection("coach-profiles", (c) => localeOfId(c.id) === "en")).sort(
  (a, b) => a.data.displayOrder - b.data.displayOrder || a.data.name.localeCompare(b.data.name)
);
const team = await Promise.all(teamEn.map((profile) => localizedCoachProfile(profile, "de")));
---

<BaseLayout title="Über uns" description={copy.metaDescription} translations={{ en: "/about", de: "/de/about" }}>
  <AboutPageContent copy={copy} team={team} />
</BaseLayout>
