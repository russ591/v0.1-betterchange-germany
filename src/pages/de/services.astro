---
import { getEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ServicesPageContent from "@/components/pages/ServicesPageContent.astro";
import { localizedArticle } from "@/lib/i18n";

const copy = (await getEntry("services-page", "de"))!.data;

const insightSlugs = ["what-is-a-scrum-master", "how-to-run-a-retrospective", "why-change-management-matters-more-than-the-plan-itself"];
const insightArticlesEn = (
  await Promise.all(insightSlugs.map((slug) => getEntry("insights-articles", slug)))
).filter((article) => article !== undefined);
// Each resolves to its German translation where one exists, falling back to
// English otherwise -- same graceful-fallback pattern as the homepage's
// featured articles (localizedArticle). InsightsArticleCard already derives
// its own href/date from each article's own locale, so no other change is
// needed here for the cards to link and read correctly in German.
const insightArticles = await Promise.all(insightArticlesEn.map((a) => localizedArticle(a, "de")));
---

<BaseLayout title="Leistungen" description={copy.metaDescription} translations={{ en: "/services", de: "/de/services" }}>
  <ServicesPageContent copy={copy} insightArticles={insightArticles} />
</BaseLayout>
