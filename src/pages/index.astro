---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import Button from "@/components/Button.astro";
import StatCallout from "@/components/StatCallout.astro";
import ServiceCard from "@/components/ServiceCard.astro";
import TestimonialCard from "@/components/TestimonialCard.astro";
import CTABanner from "@/components/CTABanner.astro";
import { services } from "@/data/services";

const stats = [
  { label: "Base", value: "Berlin", description: "In-person & online, Germany & Europe wide" },
  { label: "Delivery", value: "EN+", description: "Training & coaching in English and multilingual" },
  { label: "Network", value: "8+", description: "Expert coaches & trainers across Europe" },
  { label: "Experience", value: "30+", description: "Years combined practitioner experience" },
];

const clients = ["Deutsche Telekom", "Grundfos", "Laerdal", "TC Electronic", "HelloFresh", "McKinsey", "Microsoft"];
---

<BaseLayout
  title="Home"
  description="Better Change is a European network of experienced trainers and coaching practitioners. We deliver Kanban, Flight Levels and Scrum training, team and leadership coaching, and organisational transformation — in English and German."
>
  <section class="bg-ink text-surface">
    <div class="mx-auto max-w-6xl px-6 py-24 sm:py-32">
      <p class="eyebrow text-lime">training, coaching &amp; Consulting · Berlin &amp; Europe</p>
      <h1 class="mt-4 max-w-3xl text-[length:var(--text-h1)] leading-[var(--text-h1--line-height)]">
        We help organisations change <span class="text-lime">●</span> for the better
      </h1>
      <p class="mt-6 max-w-2xl text-[length:var(--text-body)] text-neutral-300">
        Better Change is a European network of experienced trainers and coaching practitioners. We
        deliver Kanban, Flight Levels and Scrum training, team and leadership coaching, and
        organisational transformation — in English and German.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <Button href="/training" variant="primary">See all training</Button>
        <Button href="/services" variant="secondary" class="border-surface text-surface hover:bg-surface hover:text-ink">
          Our services
        </Button>
      </div>
    </div>
  </section>

  <Section class="!py-16">
    <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
      {stats.map((stat) => <StatCallout {...stat} />)}
    </div>
  </Section>

  <Section eyebrow="Trusted by" class="border-t border-neutral-200">
    <ul class="flex flex-wrap items-center gap-x-10 gap-y-4 text-[length:var(--text-small)] font-semibold text-neutral-500">
      {clients.map((client) => <li>{client}</li>)}
    </ul>
  </Section>

  <Section
    eyebrow="What we do"
    heading="Services that create lasting change"
    class="border-t border-neutral-200 bg-neutral-50"
  >
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {services.map((service) => <ServiceCard name={service.name} items={service.items} href="/services" />)}
    </div>
  </Section>

  <Section eyebrow="Our people" heading="Practitioners, not theorists">
    <p class="max-w-2xl text-[length:var(--text-body)] text-neutral-600">
      All of us have been there ourselves — and know what to do when the real world doesn't follow
      the manual.
    </p>
    <div class="mt-8">
      <Button href="/about" variant="link" class="group">Meet the team</Button>
    </div>
  </Section>

  <Section class="border-t border-neutral-200 bg-neutral-50">
    <TestimonialCard
      quote="Better Change brought real-world credibility to our transformation. They'd done it themselves — that made all the difference."
      attribution="Senior Engineering Leader, DACH region"
    />
  </Section>

  <CTABanner
    heading="Not sure where to start?"
    body="Talk to us. We'll help you find the right training or coaching approach for your situation."
    ctaLabel="Contact us"
    ctaHref="/contact"
  />
</BaseLayout>
