---
import { getEntry, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";

const entry = await getEntry("legal-pages", "agb");
const { Content } = await render(entry!);
---

<BaseLayout title="AGB" description="Terms and conditions for Better Change Germany.">
  <Breadcrumbs items={[{ label: "AGB" }]} />

  <Section eyebrow="Legal" class="bg-mist-light">
    <h1 class="text-[length:var(--text-h1)] leading-[var(--text-h1--line-height)]">{entry!.data.title}</h1>
  </Section>

  <Section>
    <div class="article-body max-w-2xl text-[length:var(--text-body)] text-neutral-700">
      <Content />
    </div>
  </Section>
</BaseLayout>
