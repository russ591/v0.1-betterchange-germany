---
import { getEntry, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";

const entry = await getEntry("legal-pages", "datenschutz");
const { Content } = await render(entry!);
---

<BaseLayout title="Datenschutz" description="Privacy policy for Better Change Germany.">
  <Breadcrumbs items={[{ label: "Datenschutz" }]} />

  <Section eyebrow="Legal" heading={entry!.data.title}>
    <div class="article-body max-w-2xl text-[length:var(--text-body)] text-neutral-700">
      <Content />
    </div>
  </Section>
</BaseLayout>
