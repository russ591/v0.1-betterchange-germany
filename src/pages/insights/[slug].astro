---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import InsightsArticleCard from "@/components/InsightsArticleCard.astro";

export async function getStaticPaths() {
  const articles = await getCollection("insights-articles");
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const author = article.data.author ? await getEntry(article.data.author) : undefined;
const authorName = author?.data.name ?? article.data.authorName ?? "Better Change";

const allArticles = await getCollection("insights-articles");
const related = article.data.primaryCategory
  ? allArticles
      .filter((a) => a.id !== article.id && a.data.primaryCategory === article.data.primaryCategory)
      .slice(0, 3)
  : [];
---

<BaseLayout
  title={article.data.metaTitle ?? article.data.title}
  description={article.data.metaDescription ?? article.data.excerpt}
>
  <Section
    eyebrow={[article.data.primaryCategory, article.data.contentType].filter(Boolean).join(" · ") || "Insights"}
    class="bg-mist-light"
  >
    <h1 class="text-[length:var(--text-h1)] leading-[var(--text-h1--line-height)]">
      {article.data.title}
    </h1>
    <p class="mt-4 text-[length:var(--text-small)] text-neutral-500">
      {article.data.date.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" })}
      {article.data.readTimeMinutes && ` · ${article.data.readTimeMinutes} min read`}
      {" "}· By {authorName}
    </p>
  </Section>

  <Section>
    <div class="article-body max-w-2xl text-[length:var(--text-body)] text-neutral-700" set:html={article.data.bodyHtml} />
  </Section>

  {
    related.length > 0 && (
      <Section eyebrow="Related reading" class="bg-mist-light">
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((a) => (
            <InsightsArticleCard article={a} />
          ))}
        </div>
      </Section>
    )
  }
</BaseLayout>
