---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import InsightsArticlePageContent from "@/components/pages/InsightsArticlePageContent.astro";
import { localeOfId, baseSlug } from "@/lib/i18n";

export async function getStaticPaths() {
  // A handful of articles now have a German translation living alongside
  // them (src/content/insights-articles/de/*.md, id "de/<slug>") -- this
  // route is the English one, so it must only ever generate English paths;
  // /de/insights/[slug].astro is the German counterpart.
  const articles = await getCollection("insights-articles", (a) => localeOfId(a.id) === "en");
  return articles.map((article) => ({
    params: { slug: article.data.urlSlug ?? article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const author = article.data.author ? await getEntry(article.data.author) : undefined;
const authorName = author?.data.name ?? article.data.authorName ?? "Better Change";

const allArticles = await getCollection("insights-articles", (a) => localeOfId(a.id) === "en");
const related = article.data.primaryCategory
  ? allArticles
      .filter((a) => a.id !== article.id && a.data.primaryCategory === article.data.primaryCategory)
      .slice(0, 3)
  : [];

// Only some articles have a German translation yet -- the switcher/hreflang
// only appear when this specific one does, same as individual coach
// profiles (no translations prop at all otherwise).
const deArticle = await getEntry("insights-articles", `de/${baseSlug(article.id)}`);

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: article.data.title,
  description: article.data.metaDescription ?? article.data.excerpt,
  datePublished: article.data.date.toISOString(),
  author: { "@type": "Person", name: authorName },
  publisher: {
    "@type": "Organization",
    name: "Better Change",
    logo: { "@type": "ImageObject", url: new URL("/logo.png", Astro.site).toString() },
  },
  ...(article.data.imageUrl && { image: article.data.imageUrl }),
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).toString(),
};
---

<BaseLayout
  title={article.data.metaTitle ?? article.data.title}
  description={article.data.metaDescription ?? article.data.excerpt}
  jsonLd={articleSchema}
  translations={
    deArticle
      ? {
          en: `/insights/${article.data.urlSlug ?? baseSlug(article.id)}`,
          de: `/de/insights/${deArticle.data.urlSlug ?? baseSlug(deArticle.id)}`,
        }
      : undefined
  }
>
  <InsightsArticlePageContent article={article} authorName={authorName} related={related} />
</BaseLayout>
