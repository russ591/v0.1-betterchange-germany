---
import { getCollection, getEntry, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import InsightsArticleCard from "@/components/InsightsArticleCard.astro";

export async function getStaticPaths() {
  const articles = await getCollection("insights-articles");
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const category = await getEntry(article.data.category);
const author = await getEntry(article.data.author);

const allArticles = await getCollection("insights-articles");
const related = allArticles
  .filter((a) => a.id !== article.id && a.data.category.id === category.id)
  .slice(0, 3);
---

<BaseLayout title={article.data.title} description={article.data.excerpt}>
  <Section eyebrow={`${category.data.name}${article.data.type === "webinar" ? " · Webinar" : ""}`} class="bg-neutral-50">
    <h1 class="text-[length:var(--text-h1)] leading-[var(--text-h1--line-height)]">
      {article.data.title}
    </h1>
    <p class="mt-4 text-[length:var(--text-small)] text-neutral-500">
      {article.data.date.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" })}
      · {article.data.readTime} · By {author.data.name}
    </p>
  </Section>

  <Section>
    <div class="article-body max-w-2xl text-[length:var(--text-body)] text-neutral-700">
      <Content />
    </div>
  </Section>

  {
    related.length > 0 && (
      <Section eyebrow="Related reading" class="bg-neutral-50">
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((a) => (
            <InsightsArticleCard article={a} />
          ))}
        </div>
      </Section>
    )
  }
</BaseLayout>
