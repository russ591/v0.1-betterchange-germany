---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import InsightsHubPageContent from "@/components/pages/InsightsHubPageContent.astro";
import { localeOfId } from "@/lib/i18n";
import { useTranslations } from "@/i18n/utils";

const t = useTranslations("en");

// A handful of articles now have a German translation living alongside
// them (src/content/insights-articles/de/*.md) -- this route only ever
// shows the English original of each, since /de/insights is the German
// counterpart (see that route for how it resolves the German version of
// each article, falling back to English where none exists yet).
const allArticles = await getCollection("insights-articles", (a) => localeOfId(a.id) === "en");

// Resolve each article's author once, up front -- the same lookup feeds
// the card byline everywhere below, plus the isFellow flag that drives
// the sort order.
const withAuthor = await Promise.all(
  allArticles.map(async (article) => {
    const profile = article.data.author ? await getEntry(article.data.author) : undefined;
    const author = profile
      ? { name: profile.data.name, photo: profile.data.photo }
      : article.data.authorName
        ? { name: article.data.authorName, photo: undefined }
        : undefined;
    // Articles with only a plain authorName (no linked coach profile)
    // can never be checked against the Fellow list, so they default to
    // "not a Fellow" rather than guessing.
    const isFellow = profile?.data.isFellow ?? false;
    return { article, author, isFellow };
  })
);

// Newest-first within each group, but every Fellow-authored article sinks
// below every non-Fellow one regardless of date -- per Russ's request, a
// reader only reaches them by paging through to the end of the grid.
const byDateDesc = (a: (typeof withAuthor)[number], b: (typeof withAuthor)[number]) =>
  b.article.data.date.valueOf() - a.article.data.date.valueOf();
const articles = [
  ...withAuthor.filter((a) => !a.isFellow).sort(byDateDesc),
  ...withAuthor.filter((a) => a.isFellow).sort(byDateDesc),
];
---

<BaseLayout title="Insights" description={t("insights.intro")} translations={{ en: "/insights", de: "/de/insights" }}>
  <InsightsHubPageContent articles={articles} />
</BaseLayout>
