---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import InsightsArticleCard from "@/components/InsightsArticleCard.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { toPathSegment } from "@/lib/urlSlug";

const allArticles = (await getCollection("insights-articles")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

// Resolve each article's author once, up front -- the same lookup feeds
// the card byline, the "Filter by Fellow" chips, and each card's
// data-author attribute below.
const articles = await Promise.all(
  allArticles.map(async (article) => {
    const profile = article.data.author ? await getEntry(article.data.author) : undefined;
    const author = profile
      ? { id: profile.id, name: profile.data.name, photo: profile.data.photo }
      : article.data.authorName
        ? { id: article.data.authorName, name: article.data.authorName, photo: undefined }
        : undefined;
    return { article, author };
  })
);

const initials = (name: string) =>
  name
    .split(" ")
    .map((w) => w[0])
    .slice(0, 2)
    .join("")
    .toUpperCase();

// Duotone placeholder for articles without real photography -- same
// deterministic pattern as InsightsArticleCard, used here for the bespoke
// spotlight cards below.
const positions = ["30% 20%", "70% 30%", "40% 70%", "60% 60%"];
const placeholderStyle = (id: string) => {
  const hash = [...id].reduce((sum, ch) => sum + ch.charCodeAt(0), 0);
  const position = positions[hash % positions.length];
  return `background: radial-gradient(circle at ${position}, rgba(154,255,91,0.5), transparent 55%), linear-gradient(135deg, #14200c, #37452a);`;
};

// Curated via the `featured` flag migrated from the old site; falls back to
// the most recent articles if fewer than 3 are flagged, so the spotlight
// row is never sparse or empty.
const featuredPool = articles.filter((a) => a.article.data.featured);
const spotlight = (featuredPool.length >= 3 ? featuredPool : articles).slice(0, 3);
const spotlightIds = new Set(spotlight.map((a) => a.article.id));
const gridArticles = articles.filter((a) => !spotlightIds.has(a.article.id));

// Order topics by how many articles use them, most common first — matches
// the filter pattern on /training/full-schedule.
const topicCounts = new Map<string, number>();
for (const { article } of articles) {
  if (article.data.primaryCategory) {
    topicCounts.set(article.data.primaryCategory, (topicCounts.get(article.data.primaryCategory) ?? 0) + 1);
  }
}
const topics = [...topicCounts.keys()].sort((a, b) => topicCounts.get(b)! - topicCounts.get(a)!);

// Same idea for Fellows: most-published first.
const fellowCounts = new Map<string, { name: string; photo?: string; count: number }>();
for (const { author } of articles) {
  if (!author) continue;
  const existing = fellowCounts.get(author.id);
  if (existing) existing.count++;
  else fellowCounts.set(author.id, { name: author.name, photo: author.photo, count: 1 });
}
const fellows = [...fellowCounts.entries()]
  .map(([id, v]) => ({ id, ...v }))
  .sort((a, b) => b.count - a.count);
---

<BaseLayout
  title="Insights"
  description="Practical thinking on Kanban, Flight Levels, agile transformation, and organisational change, written by people who have done the work."
>
  <Breadcrumbs items={[{ label: "Insights" }]} />

  <Section eyebrow="insights" class="bg-mist-light">
    <h1 class="text-[length:var(--text-h1)] leading-[var(--text-h1--line-height)]">
      Articles, guides &amp; resources
    </h1>
    <p class="mt-6 max-w-2xl text-[length:var(--text-body)] text-neutral-600">
      Practical thinking on Kanban, Flight Levels, agile transformation, and organisational change,
      written by people who have done the work.
    </p>
  </Section>

  <Section eyebrow="Featured">
    <div class="grid gap-6 lg:grid-cols-[1.6fr_1fr]">
      {
        spotlight[0] && (
          <a
            href={`/insights/${toPathSegment(spotlight[0].article.data.urlSlug ?? spotlight[0].article.id)}`}
            class="flex flex-col overflow-hidden rounded-[var(--radius-card)] border border-neutral-200 bg-surface shadow-card transition-shadow hover:shadow-card-hover"
          >
            {spotlight[0].article.data.imageUrl ? (
              <div class="aspect-[16/9] w-full overflow-hidden">
                <img src={spotlight[0].article.data.imageUrl} alt="" class="h-full w-full object-cover" />
              </div>
            ) : (
              <div aria-hidden="true" class="aspect-[16/9] w-full" style={placeholderStyle(spotlight[0].article.id)} />
            )}
            <div class="flex flex-1 flex-col p-7">
              <p class="eyebrow">
                {[
                  spotlight[0].article.data.date.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" }),
                  spotlight[0].article.data.readTimeMinutes && `${spotlight[0].article.data.readTimeMinutes} min read`,
                ]
                  .filter(Boolean)
                  .join(" · ")}
              </p>
              <h2 class="mt-2 text-[length:var(--text-h3)] leading-[var(--text-h3--line-height)]">{spotlight[0].article.data.title}</h2>
              <p class="mt-3 max-w-xl text-[length:var(--text-body)] text-neutral-600">{spotlight[0].article.data.excerpt}</p>
              {spotlight[0].author && (
                <div class="mt-auto flex items-center gap-2 pt-5">
                  {spotlight[0].author.photo ? (
                    <img src={spotlight[0].author.photo} alt="" class="h-9 w-9 shrink-0 rounded-full object-cover" />
                  ) : (
                    <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-neutral-200 text-[11px] font-semibold text-neutral-600">
                      {initials(spotlight[0].author.name)}
                    </span>
                  )}
                  <span class="text-[length:var(--text-small)] font-semibold text-neutral-700">{spotlight[0].author.name}</span>
                </div>
              )}
            </div>
          </a>
        )
      }

      <div class="flex flex-col gap-6">
        {
          spotlight.slice(1, 3).map(({ article, author }) => (
            <a
              href={`/insights/${toPathSegment(article.data.urlSlug ?? article.id)}`}
              class="flex overflow-hidden rounded-[var(--radius-card)] border border-neutral-200 bg-surface shadow-card transition-shadow hover:shadow-card-hover"
            >
              {article.data.imageUrl ? (
                <div class="w-2/5 shrink-0 overflow-hidden">
                  <img src={article.data.imageUrl} alt="" class="h-full w-full object-cover" />
                </div>
              ) : (
                <div aria-hidden="true" class="w-2/5 shrink-0" style={placeholderStyle(article.id)} />
              )}
              <div class="flex flex-1 flex-col justify-center p-5">
                <p class="eyebrow">
                  {[
                    article.data.date.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" }),
                    article.data.readTimeMinutes && `${article.data.readTimeMinutes} min read`,
                  ]
                    .filter(Boolean)
                    .join(" · ")}
                </p>
                <h3 class="mt-1.5 text-[length:var(--text-small)] font-semibold leading-snug">{article.data.title}</h3>
                {author && (
                  <div class="mt-3 flex items-center gap-2">
                    {author.photo ? (
                      <img src={author.photo} alt="" class="h-6 w-6 shrink-0 rounded-full object-cover" />
                    ) : (
                      <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-neutral-200 text-[9px] font-semibold text-neutral-600">
                        {initials(author.name)}
                      </span>
                    )}
                    <span class="text-[length:var(--text-caption)] font-semibold text-neutral-700">{author.name}</span>
                  </div>
                )}
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </Section>

  <Section eyebrow={`${gridArticles.length} article${gridArticles.length === 1 ? "" : "s"}`}>
    <div id="insights-filters" class="space-y-6">
      <div class="relative max-w-md">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-neutral-400"
        >
          <circle cx="11" cy="11" r="7" />
          <path d="m21 21-4.3-4.3" />
        </svg>
        <label for="insights-search" class="sr-only">Search articles</label>
        <input
          id="insights-search"
          type="search"
          placeholder="Search articles…"
          class="w-full rounded-[var(--radius-control)] border border-neutral-300 bg-surface py-2.5 pl-9 pr-3 text-[length:var(--text-small)] placeholder:text-neutral-400 focus:border-ink focus:outline-none"
        />
      </div>

      <div>
        <p class="text-[length:var(--text-caption)] font-semibold uppercase tracking-[0.1em] text-neutral-500">
          Filter by topic
        </p>
        <div class="mt-2 flex flex-wrap gap-2">
          {
            topics.map((topic) => (
              <button
                type="button"
                data-filter-group="topic"
                data-filter-value={topic}
                class="cursor-pointer rounded-[var(--radius-pill)] border border-neutral-300 bg-surface px-4 py-1.5 text-[length:var(--text-small)] font-semibold text-neutral-700 transition-colors hover:border-ink hover:text-ink"
              >
                {topic}
              </button>
            ))
          }
        </div>
      </div>

      {
        fellows.length > 0 && (
          <div>
            <p class="text-[length:var(--text-caption)] font-semibold uppercase tracking-[0.1em] text-neutral-500">
              Filter by Fellow
            </p>
            <div class="mt-2 flex flex-wrap gap-2">
              {fellows.map((fellow) => (
                <button
                  type="button"
                  data-filter-group="author"
                  data-filter-value={fellow.id}
                  class="flex cursor-pointer items-center gap-2 rounded-[var(--radius-pill)] border border-neutral-300 bg-surface py-1 pl-1 pr-3.5 text-[length:var(--text-small)] font-semibold text-neutral-700 transition-colors hover:border-ink hover:text-ink"
                >
                  {fellow.photo ? (
                    <img src={fellow.photo} alt="" class="h-6 w-6 shrink-0 rounded-full object-cover" />
                  ) : (
                    <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-neutral-200 text-[9px] font-semibold text-neutral-600">
                      {initials(fellow.name)}
                    </span>
                  )}
                  {fellow.name}
                </button>
              ))}
            </div>
          </div>
        )
      }
    </div>

    <p id="insights-empty" class="mt-10 text-[length:var(--text-body)] text-neutral-500" hidden>
      No articles match the selected filters.
    </p>

    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" id="insights-grid">
      {
        gridArticles.map(({ article, author }) => (
          <div
            class="insights-card contents"
            data-topic={article.data.primaryCategory ?? ""}
            data-author={author?.id ?? ""}
          >
            <InsightsArticleCard article={article} author={author} />
          </div>
        ))
      }
    </div>
  </Section>

  <Section tone="dark" eyebrow="Newsletter" heading="Get new articles by email">
    <p class="max-w-xl text-[length:var(--text-body)] text-neutral-300">
      No noise. Just useful thinking on agile, Kanban, and Flight Levels, roughly monthly.
    </p>
    <form
      name="newsletter"
      method="POST"
      data-netlify="true"
      data-netlify-honeypot="bot-field"
      action="/thank-you"
      class="mt-6 flex max-w-md flex-col gap-3 sm:flex-row"
    >
      <input type="hidden" name="form-name" value="newsletter" />
      <p class="hidden">
        <label>
          Don't fill this out if you're human: <input name="bot-field" />
        </label>
      </p>
      <label class="sr-only" for="newsletter-email">Email address</label>
      <input
        id="newsletter-email"
        name="email"
        type="email"
        required
        placeholder="you@company.com"
        class="w-full rounded-[var(--radius-control)] border border-neutral-600 bg-transparent px-4 py-2.5 text-surface placeholder:text-neutral-500"
      />
      <button
        type="submit"
        class="shrink-0 cursor-pointer rounded-[var(--radius-control)] bg-lime px-6 py-2.5 font-semibold text-ink transition-colors hover:bg-lime/85"
      >
        Subscribe
      </button>
    </form>
  </Section>

  <script>
    const filterButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-filter-group]")
    );
    const cards = Array.from(document.querySelectorAll<HTMLElement>(".insights-card"));
    const emptyMessage = document.getElementById("insights-empty") as HTMLParagraphElement;
    const grid = document.getElementById("insights-grid") as HTMLDivElement;
    const searchInput = document.getElementById("insights-search") as HTMLInputElement | null;

    const searchText = new Map(cards.map((card) => [card, card.textContent?.toLowerCase() ?? ""]));

    const active: Record<string, Set<string>> = { topic: new Set(), author: new Set() };
    let query = "";

    function update() {
      let visibleCount = 0;

      cards.forEach((card) => {
        const topic = card.dataset.topic ?? "";
        const author = card.dataset.author ?? "";
        const topicMatch = active.topic.size === 0 || active.topic.has(topic);
        const authorMatch = active.author.size === 0 || active.author.has(author);
        const searchMatch = query === "" || (searchText.get(card) ?? "").includes(query);
        const visible = topicMatch && authorMatch && searchMatch;
        card.hidden = !visible;
        if (visible) visibleCount++;
      });

      emptyMessage.hidden = visibleCount > 0;
      grid.style.display = visibleCount > 0 ? "" : "none";
    }

    filterButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const group = button.dataset.filterGroup!;
        const value = button.dataset.filterValue!;
        const isActive = active[group].has(value);

        if (isActive) {
          active[group].delete(value);
          button.classList.remove("bg-lime", "border-lime", "text-ink");
          button.classList.add("bg-surface", "border-neutral-300", "text-neutral-700");
        } else {
          active[group].add(value);
          button.classList.remove("bg-surface", "border-neutral-300", "text-neutral-700");
          button.classList.add("bg-lime", "border-lime", "text-ink");
        }

        update();
      });
    });

    searchInput?.addEventListener("input", () => {
      query = searchInput.value.trim().toLowerCase();
      update();
    });
  </script>
</BaseLayout>
