---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import InsightsArticleCard from "@/components/InsightsArticleCard.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";

export const getStaticPaths = (async ({ paginate }) => {
  const articles = (await getCollection("insights-articles")).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
  );
  return paginate(articles, { pageSize: 24 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<BaseLayout
  title={page.currentPage === 1 ? "Insights" : `Insights — page ${page.currentPage}`}
  description="Practical thinking on Kanban, Flight Levels, agile transformation, and organisational change — written by people who have done the work."
>
  <Breadcrumbs
    items={
      page.currentPage === 1
        ? [{ label: "Insights" }]
        : [{ label: "Insights", href: "/insights" }, { label: `Page ${page.currentPage}` }]
    }
  />

  <Section eyebrow="insights" class="bg-mist-light">
    <h1 class="text-[length:var(--text-h1)] leading-[var(--text-h1--line-height)]">
      Articles, guides &amp; resources
    </h1>
    <p class="mt-6 max-w-2xl text-[length:var(--text-body)] text-neutral-600">
      Practical thinking on Kanban, Flight Levels, agile transformation, and organisational change —
      written by people who have done the work.
    </p>
  </Section>

  <Section eyebrow={`${page.total} article${page.total === 1 ? "" : "s"}`}>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {page.data.map((article) => <InsightsArticleCard article={article} />)}
    </div>
    {
      page.lastPage > 1 && (
        <nav aria-label="Pagination" class="mt-10 flex items-center justify-between text-[length:var(--text-small)]">
          {page.url.prev ? (
            <a href={page.url.prev} class="font-semibold hover:underline">
              ← Newer
            </a>
          ) : (
            <span />
          )}
          <span class="text-neutral-500">
            Page {page.currentPage} of {page.lastPage}
          </span>
          {page.url.next ? (
            <a href={page.url.next} class="font-semibold hover:underline">
              Older →
            </a>
          ) : (
            <span />
          )}
        </nav>
      )
    }
  </Section>

  <Section tone="dark" eyebrow="Newsletter" heading="Get new articles by email">
    <p class="max-w-xl text-[length:var(--text-body)] text-neutral-300">
      No noise. Just useful thinking on agile, Kanban, and Flight Levels — roughly monthly.
    </p>
    <form
      name="newsletter"
      method="POST"
      data-netlify="true"
      data-netlify-honeypot="bot-field"
      action="/thank-you"
      class="mt-6 flex max-w-md flex-col gap-3 sm:flex-row"
    >
      <input type="hidden" name="form-name" value="newsletter" />
      <p class="hidden">
        <label>
          Don't fill this out if you're human: <input name="bot-field" />
        </label>
      </p>
      <label class="sr-only" for="newsletter-email">Email address</label>
      <input
        id="newsletter-email"
        name="email"
        type="email"
        required
        placeholder="you@company.com"
        class="w-full rounded-[var(--radius-control)] border border-neutral-600 bg-transparent px-4 py-2.5 text-surface placeholder:text-neutral-500"
      />
      <button
        type="submit"
        class="shrink-0 rounded-[var(--radius-control)] bg-lime px-6 py-2.5 font-semibold text-ink"
      >
        Subscribe
      </button>
    </form>
  </Section>
</BaseLayout>
