---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import CTABanner from "@/components/CTABanner.astro";
import Button from "@/components/Button.astro";

const categories = (await getCollection("training-categories")).sort(
  (a, b) => a.data.order - b.data.order
);
const courses = await getCollection("training-courses");

const certifiedBy = [...new Set(categories.map((c) => c.data.certificationBody).filter(Boolean))];

const formats = [
  {
    name: "Self-paced online",
    description:
      "Work through the material at your own pace. Available for selected Flight Levels courses. Optional coaching sessions available.",
  },
  {
    name: "Live online",
    description:
      "The same workshop run remotely with the full group. Interactive, facilitated, and structured over the same number of days.",
  },
  {
    name: "In-person",
    description:
      "Full-day classroom workshops in Berlin. The most immersive format — live exercises, group dynamics, and direct trainer access.",
  },
];

const testimonials = [
  {
    quote:
      "The most practical agile training I've done. Russ challenges your assumptions and keeps it grounded in real situations.",
    role: "Head of Product",
    location: "Berlin",
    course: "FLIN",
    format: "In-person",
  },
  {
    quote:
      "KMP1 completely changed how I think about visualising work. Done in the best possible way — tools I used immediately.",
    role: "Agile Coach",
    location: "Amsterdam",
    course: "KMP1",
    format: "In-person",
  },
  {
    quote: "The ICP-ACC gave me a real coaching framework, not just theory. Exceptional facilitation throughout.",
    role: "Scrum Master",
    location: "Hamburg",
    course: "ICP-ACC",
    format: "In-person",
  },
];
---

<BaseLayout
  title="Training"
  description="Hands-on, certification-ready training in Flight Levels, Kanban, Scrum and leadership. In-person in Berlin, live online, or at your own pace."
>
  <Section eyebrow="better change training academy" class="bg-mist-light">
    <h1 class="text-[length:var(--text-h1)] leading-[var(--text-h1--line-height)]">
      Training that actually sticks
    </h1>
    <p class="mt-6 max-w-2xl text-[length:var(--text-body)] text-neutral-600">
      Hands-on, certification-ready training in Flight Levels, Kanban, Scrum and leadership.
      In-person in Berlin, live online, or at your own pace.
    </p>
    <ul class="mt-8 flex flex-wrap gap-x-8 gap-y-2 text-[length:var(--text-small)] font-semibold text-neutral-500">
      {certifiedBy.map((cert) => <li>Certified by {cert}</li>)}
    </ul>
  </Section>

  <Section eyebrow="Disciplines" heading="Six disciplines, one practitioner network">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        categories.map((category) => {
          const categoryCourses = courses.filter((c) => c.data.category.id === category.id);
          return (
            <div class="rounded-[var(--radius-card)] border border-neutral-200 bg-surface p-6">
              <h3 class="text-[length:var(--text-h4)]">{category.data.name}</h3>
              <p class="mt-2 text-[length:var(--text-small)] text-neutral-600">{category.data.tagline}</p>
              <a
                href={`/training/${category.id}`}
                class="mt-4 inline-flex items-center gap-1 text-sm font-semibold hover:underline"
              >
                {categoryCourses.length > 0
                  ? `${categoryCourses.length} course${categoryCourses.length === 1 ? "" : "s"}`
                  : "View discipline"}{" "}
                <span aria-hidden="true">→</span>
              </a>
            </div>
          );
        })
      }
    </div>
  </Section>

  <Section eyebrow="Delivery formats" heading="Choose how you learn" class="bg-mist-light">
    <div class="grid gap-6 sm:grid-cols-3">
      {
        formats.map((format) => (
          <div class="rounded-[var(--radius-card)] border border-neutral-200 bg-surface p-6">
            <h3 class="text-[length:var(--text-h4)]">{format.name}</h3>
            <p class="mt-2 text-[length:var(--text-small)] text-neutral-600">{format.description}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <Section tone="dark" eyebrow="In-house training">
    <div class="flex flex-col items-start gap-6 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2 class="text-[length:var(--text-h3)]">Need private or in-house training?</h2>
        <p class="mt-4 max-w-2xl text-[length:var(--text-body)] text-neutral-300">
          All courses can be run exclusively for your team — in Berlin, at your location, or online.
          Tailored to your context, delivered at your pace.
        </p>
      </div>
      <Button href="/contact" variant="primary" class="shrink-0">Talk to us</Button>
    </div>
  </Section>

  <Section eyebrow="Feedback" heading="What participants say" class="bg-mist-light">
    <p class="max-w-2xl text-[length:var(--text-body)] text-neutral-600">
      Feedback from real course participants, not curated marketing copy.
    </p>

    <div class="mt-8 grid gap-6 sm:grid-cols-3">
      {
        testimonials.map((t) => (
          <div class="flex flex-col rounded-[var(--radius-card)] border border-neutral-200 bg-surface p-6 shadow-card">
            <div class="flex gap-0.5 text-lime" aria-hidden="true">
              {Array.from({ length: 5 }).map(() => (
                <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4">
                  <path d="M10 1.5l2.6 5.6 6.1.6-4.6 4.1 1.3 6-5.4-3.1-5.4 3.1 1.3-6-4.6-4.1 6.1-.6z" />
                </svg>
              ))}
            </div>
            <p class="mt-4 flex-1 text-[length:var(--text-body)] text-ink">"{t.quote}"</p>
            <div class="mt-6 border-t border-neutral-100 pt-4">
              <p class="text-[length:var(--text-small)] font-semibold">
                {t.role}, {t.location}
              </p>
              <p class="mt-1 text-[length:var(--text-caption)] text-neutral-500">
                {t.course} · {t.format}
              </p>
            </div>
          </div>
        ))
      }
    </div>

    <div class="mt-6 flex flex-wrap items-center justify-between gap-4 rounded-[var(--radius-card)] border border-neutral-200 bg-surface px-6 py-4">
      <div class="flex items-center gap-3">
        <span class="text-[length:var(--text-h3)] font-bold">4.8</span>
        <span class="text-[length:var(--text-small)] text-neutral-600">
          Trustpilot — verified reviews across all courses.
        </span>
      </div>
      <a
        href="https://www.trustpilot.com/review/betterchange-consulting.com"
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm font-semibold hover:underline"
      >
        Read all reviews →
      </a>
    </div>
  </Section>

  <CTABanner
    tone="light"
    heading="Not sure where to start?"
    body="Talk to us. We'll help you find the right training or coaching approach for your situation."
    ctaLabel="Contact us"
    ctaHref="/contact"
  />
</BaseLayout>
