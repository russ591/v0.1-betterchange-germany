---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import Badge from "@/components/Badge.astro";
import CourseCard from "@/components/CourseCard.astro";
import CTABanner from "@/components/CTABanner.astro";

export async function getStaticPaths() {
  const courses = await getCollection("training-courses");
  return courses.map((course) => ({
    params: { category: course.data.category.id, course: course.id },
    props: { course },
  }));
}

const { course } = Astro.props;
const category = await getEntry(course.data.category);
const allCourses = await getCollection("training-courses");
const relatedCourses = allCourses.filter(
  (c) => c.data.category.id === category.id && c.id !== course.id
);

const allSchedules = await getCollection("training-schedules");
const upcoming = allSchedules
  .filter((s) => s.data.course.id === course.id)
  .sort((a, b) => (a.data.date?.valueOf() ?? 0) - (b.data.date?.valueOf() ?? 0));

const dateFormatter = new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "long", year: "numeric" });
---

<BaseLayout
  title={course.data.metaTitle ?? course.data.name}
  description={course.data.metaDescription ?? course.data.summary}
>
  <Section eyebrow={`${category.data.name} · ${course.data.code}`} class="bg-mist-light">
    <h1 class="text-[length:var(--text-h1)] leading-[var(--text-h1--line-height)]">
      {course.data.name}
    </h1>
    <p class="mt-6 max-w-2xl text-[length:var(--text-body)] text-neutral-600">{course.data.summary}</p>
    <dl class="mt-8 flex flex-wrap gap-x-10 gap-y-4 text-[length:var(--text-small)]">
      {
        course.data.level && (
          <div>
            <dt class="text-neutral-500">Level</dt>
            <dd class="font-semibold">{course.data.level}</dd>
          </div>
        )
      }
      <div>
        <dt class="text-neutral-500">Duration</dt>
        <dd class="font-semibold">{course.data.durationText}</dd>
      </div>
      {
        course.data.certification && (
          <div>
            <dt class="text-neutral-500">Certification</dt>
            <dd class="font-semibold">{course.data.certification}</dd>
          </div>
        )
      }
      {
        course.data.languages.length > 0 && (
          <div>
            <dt class="text-neutral-500">Languages</dt>
            <dd class="font-semibold">{course.data.languages.join(", ")}</dd>
          </div>
        )
      }
    </dl>
  </Section>

  <Section eyebrow="Formats & pricing" heading="How to take this course">
    <div class="grid gap-6 sm:grid-cols-3">
      {
        course.data.formats.map((format) => (
          <div class="flex flex-col rounded-[var(--radius-card)] border border-neutral-200 bg-surface p-6">
            <Badge format={format} />
            {course.data.priceFrom && (
              <>
                <p class="mt-4 text-[length:var(--text-h4)] font-bold">From {course.data.priceFrom}</p>
                <p class="text-[length:var(--text-caption)] text-neutral-500">excl. VAT</p>
              </>
            )}
            {course.data.specialOfferText && (
              <p class="mt-1 text-[length:var(--text-caption)] text-neutral-500">{course.data.specialOfferText}</p>
            )}
            <a
              href="#upcoming-sessions"
              class="mt-6 inline-flex items-center justify-center rounded-[var(--radius-control)] bg-ink px-4 py-2.5 text-sm font-semibold text-surface"
            >
              See dates
            </a>
          </div>
        ))
      }
    </div>
  </Section>

  <Section eyebrow="Who is this course for?" class="bg-mist-light">
    <ul class="max-w-2xl space-y-2 text-[length:var(--text-body)] text-neutral-600">
      {course.data.whoIsThisFor.map((item) => <li>{item}</li>)}
    </ul>
  </Section>

  <Section eyebrow="What you'll learn">
    <ul class="max-w-2xl space-y-2 text-[length:var(--text-body)] text-neutral-600">
      {course.data.whatYoullLearn.map((item) => <li>{item}</li>)}
    </ul>
  </Section>

  {
    upcoming.length > 0 && (
      <Section id="upcoming-sessions" eyebrow="Upcoming sessions" class="bg-mist-light">
        {/* stacked cards below sm, table from sm up -- the real content
            (long dates, format pills, price + offer text) doesn't fit a
            5-column table at phone widths */}
        <div class="flex flex-col gap-3 sm:hidden">
          {
            upcoming.map((session) => (
              <div class="rounded-[var(--radius-card)] border border-neutral-200 bg-surface p-4">
                <div class="flex items-start justify-between gap-3">
                  <div>
                    <p class="font-semibold">
                      {session.data.date ? dateFormatter.format(session.data.date) : "Start anytime"}
                    </p>
                    <p class="mt-1 text-[length:var(--text-caption)] text-neutral-500">{session.data.location}</p>
                  </div>
                  <Badge format={session.data.format} />
                </div>
                <div class="mt-3 flex items-center justify-between gap-3 border-t border-neutral-100 pt-3">
                  <div>
                    <p class="font-bold">{session.data.price}</p>
                    <p class="text-[length:var(--text-caption)] text-neutral-500">excl. VAT</p>
                    {session.data.offer && (
                      <p class="text-[length:var(--text-caption)] text-neutral-500">{session.data.offer}</p>
                    )}
                  </div>
                  <a href={`/training/register/${session.id}`} class="font-semibold text-ink hover:underline">
                    Register →
                  </a>
                </div>
              </div>
            ))
          }
        </div>

        <div class="hidden overflow-x-auto rounded-[var(--radius-card)] border border-neutral-200 bg-surface sm:block">
          <table class="w-full text-left text-[length:var(--text-small)]">
            <thead>
              <tr class="border-b border-neutral-200 text-neutral-500">
                <th class="px-4 py-3 font-medium">Date</th>
                <th class="px-4 py-3 font-medium">Format</th>
                <th class="px-4 py-3 font-medium">Location</th>
                <th class="px-4 py-3 font-medium">Price</th>
                <th class="px-4 py-3" />
              </tr>
            </thead>
            <tbody>
              {upcoming.map((session) => (
                <tr class="border-b border-neutral-100 last:border-0">
                  <td class="whitespace-nowrap px-4 py-3 font-medium">
                    {session.data.date ? dateFormatter.format(session.data.date) : "Start anytime"}
                  </td>
                  <td class="px-4 py-3">
                    <Badge format={session.data.format} />
                  </td>
                  <td class="px-4 py-3">{session.data.location}</td>
                  <td class="px-4 py-3">
                    {session.data.price}
                    <span class="block text-[length:var(--text-caption)] text-neutral-500">excl. VAT</span>
                    {session.data.offer && (
                      <span class="block text-[length:var(--text-caption)] text-neutral-500">{session.data.offer}</span>
                    )}
                  </td>
                  <td class="px-4 py-3 text-right">
                    <a
                      href={`/training/register/${session.id}`}
                      class="whitespace-nowrap font-semibold text-ink hover:underline"
                    >
                      Register →
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </Section>
    )
  }

  {
    relatedCourses.length > 0 && (
      <Section eyebrow="Related courses" class={upcoming.length > 0 ? "" : "bg-mist-light"}>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {relatedCourses.map((related) => (
            <CourseCard course={related} categorySlug={category.id} />
          ))}
        </div>
      </Section>
    )
  }

  <CTABanner
    tone="light"
    heading={`More courses in ${category.data.name}`}
    ctaLabel="View discipline"
    ctaHref={`/training/${category.id}`}
  />
</BaseLayout>
