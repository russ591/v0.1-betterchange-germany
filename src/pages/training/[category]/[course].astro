---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import CoursePageContent from "@/components/pages/CoursePageContent.astro";
import { toPathSegment } from "@/lib/urlSlug";
import { localeOfId, baseSlug } from "@/lib/i18n";
import { getTrainersForSessions } from "@/lib/trainers";

export async function getStaticPaths() {
  const courses = await getCollection("training-courses", (c) => localeOfId(c.id) === "en");
  return courses.map((course) => ({
    params: { category: course.data.category.id, course: course.data.urlSlug ?? course.id },
    props: { course },
  }));
}

const { course } = Astro.props;
const category = await getEntry(course.data.category);
const allCourses = await getCollection("training-courses", (c) => localeOfId(c.id) === "en");
const relatedCourses = allCourses.filter((c) => c.data.category.id === category.id && c.id !== course.id);

const allSchedules = await getCollection("training-schedules");
const upcoming = allSchedules
  .filter((s) => baseSlug(s.data.course.id) === baseSlug(course.id))
  .sort((a, b) => (a.data.date?.valueOf() ?? 0) - (b.data.date?.valueOf() ?? 0));
const upcomingWithTrainers = await Promise.all(
  upcoming.map(async (session) => ({ session, trainers: await getTrainersForSessions([session]) }))
);

const courseModeByFormat = { "in-person": "Onsite", "live-online": "Online", "self-paced": "Online" } as const;
const courseSchema = {
  "@context": "https://schema.org",
  "@type": "Course",
  name: course.data.name,
  description: course.data.summary,
  provider: { "@type": "Organization", name: "Better Change", sameAs: Astro.site?.toString() },
  ...(course.data.certification && { educationalCredentialAwarded: course.data.certification }),
  hasCourseInstance: upcoming.map((session) => ({
    "@type": "CourseInstance",
    courseMode: courseModeByFormat[session.data.format],
    ...(session.data.date && { startDate: session.data.date.toISOString().slice(0, 10) }),
    ...(session.data.format === "in-person" && {
      location: { "@type": "Place", name: session.data.location },
    }),
    offers: {
      "@type": "Offer",
      price: parseFloat(session.data.price.replace(/[^0-9.]/g, "")) || undefined,
      priceCurrency: "EUR",
      url: session.data.isExternal ? session.data.externalUrl! : new URL(`/training/register/${session.id}`, Astro.site).toString(),
      availability: "https://schema.org/InStock",
    },
  })),
};

const categorySlug = baseSlug(category.id);
const courseSlug = toPathSegment(course.data.urlSlug ?? baseSlug(course.id));

// The German counterpart never sets its own urlSlug (see the course
// generator script), so it always falls back to the shared base slug --
// no lookup needed to build the /de path for the switcher/hreflang.
const deCourseSlug = toPathSegment(baseSlug(course.id));
---

<BaseLayout
  title={course.data.metaTitle ?? course.data.name}
  description={course.data.metaDescription ?? course.data.summary}
  jsonLd={courseSchema}
  translations={{
    en: `/training/${categorySlug}/${courseSlug}`,
    de: `/de/training/${categorySlug}/${deCourseSlug}`,
  }}
>
  <CoursePageContent
    course={course}
    category={category}
    relatedCourses={relatedCourses}
    upcoming={upcoming}
    upcomingWithTrainers={upcomingWithTrainers}
  />
</BaseLayout>
