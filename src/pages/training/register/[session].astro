---
import { getCollection, getEntry } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import Badge from "@/components/Badge.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { formatSessionDate } from "@/lib/dates";
import { certificationLogos } from "@/data/certifications";
import { courseBadges } from "@/data/courseBadges";

export async function getStaticPaths() {
  const sessions = await getCollection("training-schedules");
  return sessions.map((session) => ({
    params: { session: session.id },
    props: { session },
  }));
}

const { session } = Astro.props;
const course = await getEntry(session.data.course);
const category = await getEntry(course.data.category);
const trainer = session.data.trainer ? await getEntry(session.data.trainer) : undefined;

const unitPrice = parseFloat(session.data.price.replace(/[^0-9.]/g, "")) || 0;
const hasBulkOffer = /seats? for the price of/i.test(session.data.offer ?? "");

const logo = category.data.certificationBody ? certificationLogos[category.data.certificationBody] : undefined;
const badge = courseBadges[course.id];

const countries = [
  "Germany",
  "Austria",
  "Belgium",
  "Croatia",
  "Czech Republic",
  "Denmark",
  "Estonia",
  "Finland",
  "France",
  "Greece",
  "Hungary",
  "Ireland",
  "Italy",
  "Latvia",
  "Lithuania",
  "Luxembourg",
  "Netherlands",
  "Norway",
  "Poland",
  "Portugal",
  "Romania",
  "Slovakia",
  "Slovenia",
  "Spain",
  "Sweden",
  "Switzerland",
  "United Kingdom",
  "United States",
  "Other",
];
---

<BaseLayout
  title={`Register — ${course.data.name}`}
  description={`Register for ${course.data.name} — ${session.data.format}, ${session.data.location}.`}
>
  <Breadcrumbs
    items={[
      { label: "Training", href: "/training" },
      { label: category.data.name, href: `/training/${category.id}` },
      { label: course.data.name, href: `/training/${category.id}/${course.id}` },
      { label: "Register" },
    ]}
  />

  <Section eyebrow="Register" class="bg-mist-light">
    <h1 class="text-[length:var(--text-h1)] leading-[var(--text-h1--line-height)]">{course.data.name}</h1>
    <p class="mt-4 text-[length:var(--text-small)] text-neutral-500">
      <a href={`/training/${course.data.category.id}/${course.id}`} class="hover:underline">
        &larr; Back to course details
      </a>
    </p>
    {
      category.data.certificationBody && (
        <div class="mt-7 inline-flex items-center gap-3 rounded-[var(--radius-pill)] border border-neutral-200 bg-surface px-4 py-2.5">
          {logo ? (
            <img src={logo.src} alt={logo.alt} class="h-4 w-auto object-contain" />
          ) : (
            <span class="text-[length:var(--text-caption)] font-semibold text-neutral-500">
              {category.data.certificationBody}
            </span>
          )}
          {badge && (
            <>
              <span aria-hidden="true" class="h-5 w-px bg-neutral-200" />
              <Image
                src={badge}
                alt={`${course.data.certification ?? course.data.code} certification`}
                width={56}
                height={56}
                class="h-7 w-7 rounded-full"
              />
            </>
          )}
          <span class="text-[length:var(--text-caption)] text-neutral-500">
            Certified by <span class="font-semibold text-ink">{category.data.certificationBody}</span>
          </span>
        </div>
      )
    }
  </Section>

  <Section>
    <div class="grid gap-10 lg:grid-cols-[1fr_1.3fr]">
      <div class="min-w-0 rounded-[var(--radius-card)] border border-neutral-200 bg-mist-light p-6">
        <p class="eyebrow text-neutral-500">Order summary</p>
        <div class="mt-2 flex items-center gap-3">
          {
            badge ? (
              <Image src={badge} alt="" width={48} height={48} class="h-8 w-8 shrink-0 rounded-full" />
            ) : (
              logo && (
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-neutral-200 bg-surface p-1.5">
                  <img src={logo.src} alt="" class="h-full w-full object-contain" />
                </span>
              )
            )
          }
          <h2 class="text-[length:var(--text-h4)]">{course.data.name}</h2>
        </div>
        <dl class="mt-6 space-y-4 text-[length:var(--text-small)]">
          <div class="flex items-center justify-between">
            <dt class="text-neutral-500">Format</dt>
            <dd><Badge format={session.data.format} /></dd>
          </div>
          <div class="flex items-center justify-between">
            <dt class="text-neutral-500">Date</dt>
            <dd class="font-semibold">
              {formatSessionDate(session, course)}
            </dd>
          </div>
          <div class="flex items-center justify-between">
            <dt class="text-neutral-500">Location</dt>
            <dd class="font-semibold">{session.data.location}</dd>
          </div>
          {
            trainer && (
              <div class="flex items-center justify-between">
                <dt class="text-neutral-500">Trainer</dt>
                <dd class="font-semibold">{trainer.data.name}</dd>
              </div>
            )
          }
          {
            session.data.notes && (
              <div class="rounded-[var(--radius-control)] bg-surface p-3 text-[length:var(--text-caption)] text-neutral-500">
                {session.data.notes}
              </div>
            )
          }
        </dl>
        <div
          class="mt-6 border-t border-neutral-200 pt-4"
          id="order-total-block"
          data-unit-price={unitPrice}
          data-bulk-offer={hasBulkOffer ? "true" : "false"}
        >
          <div class="flex items-center justify-between text-[length:var(--text-h4)] font-bold">
            <span>Total</span>
            <span id="order-total">{session.data.price}</span>
          </div>
          <p class="mt-1 text-[length:var(--text-caption)] text-neutral-500">Prices exclude VAT (MwSt.)</p>
          <p
            id="discount-note"
            class="mt-2 inline-block rounded-[var(--radius-pill)] bg-lime/20 px-2.5 py-1 text-[length:var(--text-caption)] font-semibold text-ink"
            hidden
          ></p>
          {session.data.offer && <p class="mt-1 text-[length:var(--text-caption)] text-neutral-500">{session.data.offer}</p>}
        </div>
      </div>

      <form
        name="registration"
        method="POST"
        data-netlify="true"
        data-netlify-honeypot="bot-field"
        action="/training/register/thank-you"
        class="min-w-0 space-y-5"
        id="registration-form"
      >
        <input type="hidden" name="form-name" value="registration" />
        <input type="hidden" name="course" value={`${course.data.name} (${session.id})`} />
        <input type="hidden" name="total" id="total-field" value={session.data.price} />
        <p class="hidden">
          <label>
            Don't fill this out if you're human: <input name="bot-field" />
          </label>
        </p>

        <p class="eyebrow text-neutral-500">Your details</p>

        <div>
          <label for="seats" class="block text-[length:var(--text-small)] font-medium">Number of seats</label>
          <select
            id="seats"
            name="seats"
            class="mt-1 w-full rounded-[var(--radius-control)] border border-neutral-300 bg-surface px-4 py-2.5 sm:w-40"
          >
            {Array.from({ length: 6 }, (_, i) => i + 1).map((n) => <option value={n}>{n}</option>)}
          </select>
        </div>

        <div>
          <p class="eyebrow text-neutral-500">Who's attending?</p>
          <div class="mt-4 space-y-4">
            {
              Array.from({ length: 6 }, (_, i) => i + 1).map((n) => (
                <div data-attendee-block data-attendee-index={n} hidden={n > 1} class="grid gap-4 sm:grid-cols-2">
                  <p class="text-[length:var(--text-caption)] font-semibold text-neutral-500 sm:col-span-2">
                    Attendee {n}
                  </p>
                  <div>
                    <label for={`attendee-name-${n}`} class="block text-[length:var(--text-small)] font-medium">
                      Attendee {n} name
                    </label>
                    <input
                      id={`attendee-name-${n}`}
                      name={`attendee-name-${n}`}
                      type="text"
                      required={n === 1}
                      class="mt-1 w-full rounded-[var(--radius-control)] border border-neutral-300 px-4 py-2.5"
                    />
                  </div>
                  <div>
                    <label for={`attendee-email-${n}`} class="block text-[length:var(--text-small)] font-medium">
                      Attendee {n} email
                    </label>
                    <input
                      id={`attendee-email-${n}`}
                      name={`attendee-email-${n}`}
                      type="email"
                      required={n === 1}
                      class="mt-1 w-full rounded-[var(--radius-control)] border border-neutral-300 px-4 py-2.5"
                    />
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <div>
          <p class="eyebrow text-neutral-500">Who's registering?</p>
          <p class="mt-2 text-[length:var(--text-caption)] text-neutral-500">
            Defaults to the first attendee — change this if someone else is booking.
          </p>
          <div class="mt-4 grid gap-5 sm:grid-cols-2">
            <div>
              <label for="name" class="block text-[length:var(--text-small)] font-medium">Your name</label>
              <input
                id="name"
                name="name"
                type="text"
                required
                class="mt-1 w-full rounded-[var(--radius-control)] border border-neutral-300 px-4 py-2.5"
              />
            </div>
            <div>
              <label for="email" class="block text-[length:var(--text-small)] font-medium">Your email</label>
              <input
                id="email"
                name="email"
                type="email"
                required
                class="mt-1 w-full rounded-[var(--radius-control)] border border-neutral-300 px-4 py-2.5"
              />
            </div>
          </div>
        </div>

        <p class="eyebrow text-neutral-500">Postal address</p>

        <div>
          <label for="address" class="block text-[length:var(--text-small)] font-medium">Street and number</label>
          <input
            id="address"
            name="address"
            type="text"
            required
            class="mt-1 w-full rounded-[var(--radius-control)] border border-neutral-300 px-4 py-2.5"
          />
        </div>

        <div class="grid gap-5 sm:grid-cols-3">
          <div>
            <label for="postcode" class="block text-[length:var(--text-small)] font-medium">Postcode</label>
            <input
              id="postcode"
              name="postcode"
              type="text"
              required
              class="mt-1 w-full rounded-[var(--radius-control)] border border-neutral-300 px-4 py-2.5"
            />
          </div>
          <div>
            <label for="state" class="block text-[length:var(--text-small)] font-medium">State</label>
            <input
              id="state"
              name="state"
              type="text"
              required
              class="mt-1 w-full rounded-[var(--radius-control)] border border-neutral-300 px-4 py-2.5"
            />
          </div>
          <div>
            <label for="country" class="block text-[length:var(--text-small)] font-medium">Country</label>
            <select
              id="country"
              name="country"
              required
              class="mt-1 w-full rounded-[var(--radius-control)] border border-neutral-300 bg-surface px-4 py-2.5"
            >
              {
                countries.map((country) => (
                  <option value={country} selected={country === "Germany"}>
                    {country}
                  </option>
                ))
              }
            </select>
          </div>
        </div>

        <p class="eyebrow text-neutral-500">Billing details</p>

        <div>
          <label for="company" class="block text-[length:var(--text-small)] font-medium">Company (optional)</label>
          <input
            id="company"
            name="company"
            type="text"
            class="mt-1 w-full rounded-[var(--radius-control)] border border-neutral-300 px-4 py-2.5"
          />
        </div>

        <div>
          <label for="vat-id" class="block text-[length:var(--text-small)] font-medium">VAT ID (optional)</label>
          <input
            id="vat-id"
            name="vat-id"
            type="text"
            class="mt-1 w-full rounded-[var(--radius-control)] border border-neutral-300 px-4 py-2.5"
          />
        </div>

        <div>
          <label for="discount-code" class="block text-[length:var(--text-small)] font-medium">Discount code (optional)</label>
          <input
            id="discount-code"
            name="discount-code"
            type="text"
            class="mt-1 w-full rounded-[var(--radius-control)] border border-neutral-300 px-4 py-2.5"
          />
        </div>

        <div>
          <label for="notes" class="block text-[length:var(--text-small)] font-medium">Anything we should know?</label>
          <textarea
            id="notes"
            name="notes"
            rows="4"
            class="mt-1 w-full rounded-[var(--radius-control)] border border-neutral-300 px-4 py-2.5"
          ></textarea>
        </div>
        <label class="flex items-start gap-2 text-[length:var(--text-caption)] text-neutral-600">
          <input type="checkbox" required class="mt-1" />
          I agree to my data being used to process this registration, in line with the privacy policy.
        </label>
        <button
          type="submit"
          class="w-full rounded-[var(--radius-control)] bg-ink px-6 py-3 font-semibold text-surface sm:w-auto"
        >
          Confirm registration
        </button>
      </form>
    </div>
  </Section>

  <script>
    const seatsSelect = document.getElementById("seats") as HTMLSelectElement;
    const attendeeBlocks = Array.from(
      document.querySelectorAll<HTMLDivElement>("[data-attendee-block]")
    );

    const orderTotalBlock = document.getElementById("order-total-block") as HTMLDivElement;
    const orderTotalEl = document.getElementById("order-total") as HTMLSpanElement;
    const discountNoteEl = document.getElementById("discount-note") as HTMLParagraphElement;
    const totalField = document.getElementById("total-field") as HTMLInputElement;
    const unitPrice = parseFloat(orderTotalBlock.dataset.unitPrice ?? "0");
    const hasBulkOffer = orderTotalBlock.dataset.bulkOffer === "true";
    const currencyFormatter = new Intl.NumberFormat("en-GB", {
      style: "currency",
      currency: "EUR",
      maximumFractionDigits: 0,
    });

    function updateTotal(seats: number) {
      // Every 3rd seat is free under the "3 seats for the price of 2" offer.
      const freeSeats = hasBulkOffer ? Math.floor(seats / 3) : 0;
      const payableSeats = seats - freeSeats;
      const total = payableSeats * unitPrice;
      const formattedTotal = currencyFormatter.format(total);

      orderTotalEl.textContent = formattedTotal;
      totalField.value = formattedTotal;

      if (freeSeats > 0) {
        const savings = currencyFormatter.format(freeSeats * unitPrice);
        discountNoteEl.textContent = `Includes ${freeSeats} free seat${freeSeats > 1 ? "s" : ""} (3-for-2 offer) — you save ${savings}`;
        discountNoteEl.hidden = false;
      } else {
        discountNoteEl.hidden = true;
      }
    }

    function updateAttendeeBlocks() {
      const seats = parseInt(seatsSelect.value, 10);
      attendeeBlocks.forEach((block, i) => {
        block.hidden = i >= seats;
      });
      updateTotal(seats);
    }

    seatsSelect.addEventListener("change", updateAttendeeBlocks);
    updateAttendeeBlocks();

    // Mirror attendee 1's details into the booking-contact fields until the
    // booker explicitly edits them themselves.
    const attendee1Name = document.getElementById("attendee-name-1") as HTMLInputElement;
    const attendee1Email = document.getElementById("attendee-email-1") as HTMLInputElement;
    const bookerName = document.getElementById("name") as HTMLInputElement;
    const bookerEmail = document.getElementById("email") as HTMLInputElement;
    let bookerNameTouched = false;
    let bookerEmailTouched = false;

    attendee1Name.addEventListener("input", () => {
      if (!bookerNameTouched) bookerName.value = attendee1Name.value;
    });
    attendee1Email.addEventListener("input", () => {
      if (!bookerEmailTouched) bookerEmail.value = attendee1Email.value;
    });
    bookerName.addEventListener("input", () => {
      bookerNameTouched = true;
    });
    bookerEmail.addEventListener("input", () => {
      bookerEmailTouched = true;
    });
  </script>
</BaseLayout>
