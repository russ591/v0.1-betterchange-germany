---
import { getCollection, getEntry } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import Badge from "@/components/Badge.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { formatSessionDate } from "@/lib/dates";
import { certificationLogos } from "@/data/certifications";
import { courseBadges } from "@/data/courseBadges";
import { toPathSegment } from "@/lib/urlSlug";

export async function getStaticPaths() {
  const sessions = await getCollection("training-schedules");
  return sessions.map((session) => ({
    params: { session: session.id },
    props: { session },
  }));
}

const { session } = Astro.props;
const course = await getEntry(session.data.course);
const category = await getEntry(course.data.category);
const trainer = session.data.trainer ? await getEntry(session.data.trainer) : undefined;

const unitPrice = parseFloat(session.data.price.replace(/[^0-9.]/g, "")) || 0;
const hasBulkOffer = /seats? for the price of/i.test(session.data.offer ?? "");
const isSoldOut = session.data.status === "sold-out";

// Exclusive end date for an all-day "Add to calendar" event — Google
// Calendar's all-day range end is the day AFTER the event actually ends.
// In-person sessions span course.data.durationDays consecutive days;
// live-online/self-paced don't have a reliable end (live-online runs as
// separate half-days across weeks), so those just get a single-day event
// on the start date.
const calendarEndDate = session.data.date
  ? new Date(
      session.data.date.getTime() +
        (session.data.format === "in-person" ? course.data.durationDays : 1) * 86_400_000
    )
  : undefined;

const logo = category.data.certificationBody ? certificationLogos[category.data.certificationBody] : undefined;
const badge = courseBadges[course.id];

const countries = [
  "Germany",
  "Austria",
  "Belgium",
  "Croatia",
  "Czech Republic",
  "Denmark",
  "Estonia",
  "Finland",
  "France",
  "Greece",
  "Hungary",
  "Ireland",
  "Italy",
  "Latvia",
  "Lithuania",
  "Luxembourg",
  "Netherlands",
  "Norway",
  "Poland",
  "Portugal",
  "Romania",
  "Slovakia",
  "Slovenia",
  "Spain",
  "Sweden",
  "Switzerland",
  "United Kingdom",
  "United States",
  "Other",
];
---

<BaseLayout
  title={`Register — ${course.data.name}`}
  description={`Register for ${course.data.name} — ${session.data.format}, ${session.data.location}.`}
>
  <Breadcrumbs
    items={[
      { label: "Training", href: "/training" },
      { label: category.data.name, href: `/training/${category.id}` },
      { label: course.data.name, href: `/training/${category.id}/${toPathSegment(course.data.urlSlug ?? course.id)}` },
      { label: "Register" },
    ]}
  />

  <Section eyebrow="Register" class="bg-mist-light">
    <h1 class="text-[length:var(--text-h1)] leading-[var(--text-h1--line-height)]">{course.data.name}</h1>
    <p class="mt-4 text-[length:var(--text-small)] text-neutral-500">
      <a href={`/training/${course.data.category.id}/${toPathSegment(course.data.urlSlug ?? course.id)}`} class="hover:underline">
        &larr; Back to course details
      </a>
    </p>
    {
      category.data.certificationBody && (
        <div class="mt-7 inline-flex items-center gap-3 rounded-[var(--radius-pill)] border border-neutral-200 bg-surface px-4 py-2.5">
          {logo ? (
            <img src={logo.src} alt={logo.alt} class="h-4 w-auto object-contain" />
          ) : (
            <span class="text-[length:var(--text-caption)] font-semibold text-neutral-500">
              {category.data.certificationBody}
            </span>
          )}
          {badge && (
            <>
              <span aria-hidden="true" class="h-5 w-px bg-neutral-200" />
              <Image
                src={badge}
                alt={`${course.data.certification ?? course.data.code} certification`}
                width={56}
                height={56}
                class="h-7 w-7 rounded-full"
              />
            </>
          )}
          <span class="text-[length:var(--text-caption)] text-neutral-500">
            Certified by <span class="font-semibold text-ink">{category.data.certificationBody}</span>
          </span>
        </div>
      )
    }
  </Section>

  <Section>
    <div class="grid gap-10 lg:grid-cols-[1fr_1.3fr]">
      <div class="min-w-0 rounded-[var(--radius-card)] border border-neutral-200 bg-mist-light p-6">
        <p class="eyebrow text-neutral-500">Order summary</p>
        <div class="mt-2 flex items-center gap-3">
          {
            badge ? (
              <Image src={badge} alt="" width={48} height={48} class="h-8 w-8 shrink-0 rounded-full" />
            ) : (
              logo && (
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-neutral-200 bg-surface p-1.5">
                  <img src={logo.src} alt="" class="h-full w-full object-contain" />
                </span>
              )
            )
          }
          <h2 class="text-[length:var(--text-h4)]">{course.data.name}</h2>
        </div>
        <dl class="mt-6 space-y-4 text-[length:var(--text-small)]">
          <div class="flex items-center justify-between">
            <dt class="text-neutral-500">Format</dt>
            <dd><Badge format={session.data.format} /></dd>
          </div>
          <div class="flex items-center justify-between">
            <dt class="text-neutral-500">Date</dt>
            <dd class="font-semibold">
              {formatSessionDate(session, course)}
            </dd>
          </div>
          <div class="flex items-center justify-between">
            <dt class="text-neutral-500">Location</dt>
            <dd class="font-semibold">{session.data.location}</dd>
          </div>
          {
            trainer && (
              <div class="flex items-center justify-between">
                <dt class="text-neutral-500">Trainer</dt>
                <dd class="font-semibold">{trainer.data.name}</dd>
              </div>
            )
          }
          {
            session.data.notes && (
              <div class="rounded-[var(--radius-control)] bg-surface p-3 text-[length:var(--text-caption)] text-neutral-500">
                {session.data.notes}
              </div>
            )
          }
          {
            isSoldOut && (
              <div class="flex items-center justify-between">
                <dt class="text-neutral-500">Price</dt>
                <dd class="font-semibold">{session.data.price}</dd>
              </div>
            )
          }
        </dl>

        {
          // Always rendered (hidden, not removed, when sold out) — the
          // page's own script unconditionally reads #order-total-block's
          // dataset on load, so omitting this markup entirely for a
          // sold-out session throws and kills the whole script, including
          // the unrelated waitlist form's submit handler below.
        }
        <div class="mt-6 border-t border-neutral-200 pt-4" hidden={isSoldOut}>
          <button
            type="button"
            id="toggle-discount"
            class="cursor-pointer text-[length:var(--text-caption)] font-semibold text-ink underline decoration-neutral-300 underline-offset-2 transition-colors hover:decoration-ink"
          >
            + Have a discount code?
          </button>
          <div id="discount-code-panel" class="mt-2" hidden>
            <div class="flex gap-2">
              <input
                id="discount-code"
                name="discount-code"
                type="text"
                placeholder="Enter code"
                class="w-full rounded-[var(--radius-control)] border border-neutral-300 bg-surface px-3 py-2 text-[length:var(--text-small)]"
              />
              <button
                type="button"
                id="apply-discount-code"
                class="shrink-0 cursor-pointer rounded-[var(--radius-control)] border border-neutral-300 bg-surface px-3 py-2 text-[length:var(--text-small)] font-semibold text-ink transition-colors hover:bg-mist-light"
              >
                Apply
              </button>
            </div>
            <p id="discount-code-feedback" class="mt-1 text-[length:var(--text-caption)]" hidden></p>
          </div>
        </div>

        <div
          class="mt-4 border-t border-neutral-200 pt-4"
          id="order-total-block"
          data-unit-price={unitPrice}
          data-bulk-offer={hasBulkOffer ? "true" : "false"}
          hidden={isSoldOut}
        >
          <div class="flex items-center justify-between text-[length:var(--text-body)] text-neutral-600">
            <span>Price</span>
            <span>{session.data.price}</span>
          </div>
          <div class="mt-1 flex items-center justify-between text-[length:var(--text-body)] text-neutral-600">
            <span>Seats</span>
            <span id="order-seats">1</span>
          </div>
          <div class="mt-1 flex items-center justify-between text-[length:var(--text-body)] text-neutral-600">
            <span>Subtotal</span>
            <span id="order-subtotal">{session.data.price}</span>
          </div>
          <div
            id="offer-line"
            class="mt-1 flex items-center justify-between text-[length:var(--text-body)] text-neutral-600"
            hidden
          >
            <span>Offer (3-for-2)</span>
            <span id="order-offer-amount"></span>
          </div>
          <div
            id="discount-code-line"
            class="mt-1 flex items-center justify-between text-[length:var(--text-body)] text-neutral-600"
            hidden
          >
            <span id="discount-code-label">Discount code</span>
            <span id="order-discount-amount"></span>
          </div>
          <div class="mt-2 flex items-center justify-between border-t border-neutral-200 pt-2 text-[length:var(--text-h4)] font-bold">
            <span>Total</span>
            <span id="order-total">{session.data.price}</span>
          </div>
          <p class="mt-1 text-[length:var(--text-caption)] text-neutral-500">Prices exclude VAT (MwSt.)</p>
          {session.data.offer && <p class="mt-1 text-[length:var(--text-caption)] text-neutral-500">{session.data.offer}</p>}
        </div>
      </div>

      {
        // Always rendered (hidden, not removed, when not sold out) so
        // Netlify's build-time form detection reliably knows about the
        // "waitlist" form even in a build where no session happens to be
        // sold out — the same pattern as the registration form below.
      }
      <form
        name="waitlist"
        method="POST"
        data-netlify="true"
        data-netlify-honeypot="bot-field"
        id="waitlist-form"
        class="min-w-0 space-y-5"
        hidden={!isSoldOut}
      >
        <input type="hidden" name="form-name" value="waitlist" />
          <input type="hidden" name="course" value={course.data.name} />
          <input type="hidden" name="session-date" value={formatSessionDate(session, course)} />
          <input type="hidden" name="location" value={session.data.location} />
          <p class="hidden">
            <label>
              Don't fill this out if you're human: <input name="bot-field" />
            </label>
          </p>

          <div class="rounded-[var(--radius-card)] bg-de-red/10 p-4">
            <p class="font-semibold text-de-red">This session is sold out</p>
            <p class="mt-1 text-[length:var(--text-small)] text-neutral-600">
              All seats for {formatSessionDate(session, course)} are taken. Join the waitlist and we'll email you
              personally the moment a spot opens up.
            </p>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="waitlist-name" class="block text-[length:var(--text-small)] font-medium">Your name</label>
              <input
                id="waitlist-name"
                name="name"
                type="text"
                required
                class="mt-1 w-full rounded-[var(--radius-control)] border border-neutral-300 px-4 py-2.5"
              />
            </div>
            <div>
              <label for="waitlist-email" class="block text-[length:var(--text-small)] font-medium">Your email</label>
              <input
                id="waitlist-email"
                name="email"
                type="email"
                required
                class="mt-1 w-full rounded-[var(--radius-control)] border border-neutral-300 px-4 py-2.5"
              />
            </div>
          </div>
          <div>
            <label for="waitlist-notes" class="block text-[length:var(--text-small)] font-medium">Anything we should know? (optional)</label>
            <textarea
              id="waitlist-notes"
              name="notes"
              rows="3"
              class="mt-1 w-full rounded-[var(--radius-control)] border border-neutral-300 px-4 py-2.5"
            ></textarea>
          </div>
          <p id="waitlist-error" class="text-[length:var(--text-small)] text-de-red" hidden></p>
          <button
            type="submit"
            id="waitlist-submit"
            class="w-full cursor-pointer rounded-[var(--radius-control)] bg-ink px-6 py-3 font-semibold text-surface transition-colors hover:bg-neutral-800 sm:w-auto"
          >
            Join the waitlist
          </button>
      </form>
      <p
        id="waitlist-success"
        class="min-w-0 rounded-[var(--radius-card)] bg-lime/15 p-4 text-[length:var(--text-small)] text-ink"
        hidden
      >
        You're on the list — we'll email you the moment a seat opens up.
      </p>

      <form
        name="registration"
        method="POST"
        data-netlify="true"
        data-netlify-honeypot="bot-field"
        action="/training/register/thank-you"
        id="registration-form"
        class="min-w-0 space-y-5"
        hidden={isSoldOut}
      >
        <input type="hidden" name="form-name" value="registration" />
        <input type="hidden" name="course" value={course.data.name} />
        <input type="hidden" name="session-date" value={formatSessionDate(session, course)} />
        <input type="hidden" name="session-date-iso" value={session.data.date?.toISOString() ?? ""} />
        <input type="hidden" name="session-end-date-iso" value={calendarEndDate?.toISOString() ?? ""} />
        <input type="hidden" name="location" value={session.data.location} />
        <input type="hidden" name="total" id="total-field" value={session.data.price} />
        <p class="hidden">
          <label>
            Don't fill this out if you're human: <input name="bot-field" />
          </label>
        </p>

        <div>
          <div class="flex items-center justify-between">
            <p class="eyebrow text-neutral-500">Attendees</p>
            <div class="flex items-center gap-2">
              <label for="seats" class="text-[length:var(--text-caption)] text-neutral-500">Seats</label>
              <select
                id="seats"
                name="seats"
                class="rounded-[var(--radius-control)] border border-neutral-300 bg-surface px-2 py-1 text-[length:var(--text-small)]"
              >
                {Array.from({ length: 6 }, (_, i) => i + 1).map((n) => <option value={n}>{n}</option>)}
              </select>
            </div>
          </div>
          <div class="mt-3 divide-y divide-neutral-200 rounded-[var(--radius-control)] border border-neutral-200">
            {
              Array.from({ length: 6 }, (_, i) => i + 1).map((n) => (
                <div
                  data-attendee-block
                  data-attendee-index={n}
                  hidden={n > 1}
                  class="grid grid-cols-[auto_1fr_1fr] items-center gap-3 p-3"
                >
                  <span class="flex h-6 w-6 items-center justify-center rounded-full bg-mist-light text-[length:var(--text-caption)] font-semibold text-neutral-600">
                    {n}
                  </span>
                  <input
                    id={`attendee-name-${n}`}
                    name={`attendee-name-${n}`}
                    type="text"
                    placeholder="Name"
                    aria-label={`Attendee ${n} name`}
                    required={n === 1}
                    class="w-full rounded-[var(--radius-control)] border border-neutral-300 px-3 py-2 text-[length:var(--text-small)]"
                  />
                  <input
                    id={`attendee-email-${n}`}
                    name={`attendee-email-${n}`}
                    type="email"
                    placeholder="Email"
                    aria-label={`Attendee ${n} email`}
                    required={n === 1}
                    class="w-full rounded-[var(--radius-control)] border border-neutral-300 px-3 py-2 text-[length:var(--text-small)]"
                  />
                </div>
              ))
            }
          </div>
        </div>

        <div>
          <p class="eyebrow text-neutral-500">Your details</p>
          <p class="mt-2 text-[length:var(--text-caption)] text-neutral-500">
            Defaults to the first attendee — change this if someone else is booking.
          </p>
          <div class="mt-3 grid gap-4 sm:grid-cols-2">
            <div>
              <label for="name" class="block text-[length:var(--text-small)] font-medium">Your name</label>
              <input
                id="name"
                name="name"
                type="text"
                required
                class="mt-1 w-full rounded-[var(--radius-control)] border border-neutral-300 px-4 py-2.5"
              />
            </div>
            <div>
              <label for="email" class="block text-[length:var(--text-small)] font-medium">Your email</label>
              <input
                id="email"
                name="email"
                type="email"
                required
                class="mt-1 w-full rounded-[var(--radius-control)] border border-neutral-300 px-4 py-2.5"
              />
            </div>
            <div>
              <label for="address" class="block text-[length:var(--text-small)] font-medium">Street and number</label>
              <input
                id="address"
                name="address"
                type="text"
                required
                class="mt-1 w-full rounded-[var(--radius-control)] border border-neutral-300 px-4 py-2.5"
              />
            </div>
            <div>
              <label for="postcode" class="block text-[length:var(--text-small)] font-medium">Postcode</label>
              <input
                id="postcode"
                name="postcode"
                type="text"
                required
                class="mt-1 w-full rounded-[var(--radius-control)] border border-neutral-300 px-4 py-2.5"
              />
            </div>
            <div>
              <label for="state" class="block text-[length:var(--text-small)] font-medium">State</label>
              <input
                id="state"
                name="state"
                type="text"
                required
                class="mt-1 w-full rounded-[var(--radius-control)] border border-neutral-300 px-4 py-2.5"
              />
            </div>
            <div>
              <label for="country" class="block text-[length:var(--text-small)] font-medium">Country</label>
              <select
                id="country"
                name="country"
                required
                class="mt-1 w-full rounded-[var(--radius-control)] border border-neutral-300 bg-surface px-4 py-2.5"
              >
                {
                  countries.map((country) => (
                    <option value={country} selected={country === "Germany"}>
                      {country}
                    </option>
                  ))
                }
              </select>
            </div>
            <div>
              <label for="company" class="block text-[length:var(--text-small)] font-medium">Company (optional)</label>
              <input
                id="company"
                name="company"
                type="text"
                class="mt-1 w-full rounded-[var(--radius-control)] border border-neutral-300 px-4 py-2.5"
              />
            </div>
            <div>
              <label for="vat-id" class="block text-[length:var(--text-small)] font-medium">VAT ID (optional)</label>
              <input
                id="vat-id"
                name="vat-id"
                type="text"
                class="mt-1 w-full rounded-[var(--radius-control)] border border-neutral-300 px-4 py-2.5"
              />
            </div>
          </div>
        </div>

        <div>
          <label for="notes" class="block text-[length:var(--text-small)] font-medium">Anything we should know? (optional)</label>
          <textarea
            id="notes"
            name="notes"
            rows="3"
            class="mt-1 w-full rounded-[var(--radius-control)] border border-neutral-300 px-4 py-2.5"
          ></textarea>
        </div>
        <label class="flex items-start gap-2 text-[length:var(--text-caption)] text-neutral-600">
          <input type="checkbox" required class="mt-1" />
          I agree to my data being used to process this registration, in line with the privacy policy.
        </label>
        <button
          type="submit"
          class="w-full cursor-pointer rounded-[var(--radius-control)] bg-ink px-6 py-3 font-semibold text-surface transition-colors hover:bg-neutral-800 sm:w-auto"
        >
          Confirm registration
        </button>
      </form>
    </div>
  </Section>

  <script>
    const seatsSelect = document.getElementById("seats") as HTMLSelectElement;
    const attendeeBlocks = Array.from(
      document.querySelectorAll<HTMLDivElement>("[data-attendee-block]")
    );

    const orderTotalBlock = document.getElementById("order-total-block") as HTMLDivElement;
    const orderSeatsEl = document.getElementById("order-seats") as HTMLSpanElement;
    const orderSubtotalEl = document.getElementById("order-subtotal") as HTMLSpanElement;
    const orderTotalEl = document.getElementById("order-total") as HTMLSpanElement;
    const offerLineEl = document.getElementById("offer-line") as HTMLDivElement;
    const offerAmountEl = document.getElementById("order-offer-amount") as HTMLSpanElement;
    const discountCodeLineEl = document.getElementById("discount-code-line") as HTMLDivElement;
    const discountCodeLabelEl = document.getElementById("discount-code-label") as HTMLSpanElement;
    const discountAmountEl = document.getElementById("order-discount-amount") as HTMLSpanElement;
    const totalField = document.getElementById("total-field") as HTMLInputElement;
    const discountCodeInput = document.getElementById("discount-code") as HTMLInputElement;
    const applyDiscountButton = document.getElementById("apply-discount-code") as HTMLButtonElement;
    const discountFeedbackEl = document.getElementById("discount-code-feedback") as HTMLParagraphElement;
    const toggleDiscountButton = document.getElementById("toggle-discount") as HTMLButtonElement;
    const discountCodePanel = document.getElementById("discount-code-panel") as HTMLDivElement;
    const unitPrice = parseFloat(orderTotalBlock.dataset.unitPrice ?? "0");
    const hasBulkOffer = orderTotalBlock.dataset.bulkOffer === "true";
    const currencyFormatter = new Intl.NumberFormat("en-GB", {
      style: "currency",
      currency: "EUR",
      maximumFractionDigits: 0,
    });

    // Purely a live preview for the customer — the actual discount is
    // applied server-side (netlify/functions/lib/discount.js) against the
    // pre-discount total submitted in the hidden "total" field, via
    // Lexware's own line-item discount. Never bake this into totalField.
    let appliedDiscount: { type: "percentage" | "fixed"; value: number } | null = null;

    // Two discounts can stack, applied in order: the automatic 3-for-2
    // seat offer first, then a discount code on top of what's left —
    // each shown as its own line so the cascade from the gross subtotal
    // down to the final total is never a single opaque jump.
    function updateTotal(seats: number) {
      orderSeatsEl.textContent = String(seats);

      const grossSubtotal = seats * unitPrice;
      orderSubtotalEl.textContent = currencyFormatter.format(grossSubtotal);

      // Every 3rd seat is free under the "3 seats for the price of 2" offer.
      const freeSeats = hasBulkOffer ? Math.floor(seats / 3) : 0;
      const offerAmount = freeSeats * unitPrice;
      if (offerAmount > 0) {
        offerAmountEl.textContent = `-${currencyFormatter.format(offerAmount)}`;
        offerLineEl.hidden = false;
      } else {
        offerLineEl.hidden = true;
      }

      const afterOffer = grossSubtotal - offerAmount;
      // The hidden "total" field is what the server applies a discount
      // code's percentage against (via Lexware's line-item discount) —
      // post-offer, pre-code, matching this same cascade server-side.
      totalField.value = currencyFormatter.format(afterOffer);

      let discountAmount = 0;
      if (appliedDiscount) {
        discountAmount =
          appliedDiscount.type === "fixed"
            ? Math.min(appliedDiscount.value, afterOffer)
            : afterOffer * (appliedDiscount.value / 100);
      }
      if (discountAmount > 0) {
        discountCodeLabelEl.textContent =
          appliedDiscount!.type === "fixed"
            ? "Discount code"
            : `Discount code (${appliedDiscount!.value}%)`;
        discountAmountEl.textContent = `-${currencyFormatter.format(discountAmount)}`;
        discountCodeLineEl.hidden = false;
      } else {
        discountCodeLineEl.hidden = true;
      }

      orderTotalEl.textContent = currencyFormatter.format(afterOffer - discountAmount);
    }

    function showDiscountFeedback(message: string, tone: "success" | "error") {
      discountFeedbackEl.textContent = message;
      discountFeedbackEl.hidden = false;
      discountFeedbackEl.classList.toggle("text-ink", tone === "success");
      discountFeedbackEl.classList.toggle("font-semibold", tone === "success");
      discountFeedbackEl.classList.toggle("text-de-red", tone === "error");
    }

    // Codes are looked up server-side (checked against Netlify Blobs via
    // check-discount-code.js) rather than shipped to the client as a full
    // list — so a visitor can only ever learn whether the one code they
    // typed is valid, never enumerate every code Russell has issued.
    async function applyDiscountCode() {
      const entered = discountCodeInput.value.trim().toUpperCase();
      if (!entered) {
        appliedDiscount = null;
        discountFeedbackEl.hidden = true;
        updateTotal(parseInt(seatsSelect.value, 10));
        return;
      }

      applyDiscountButton.disabled = true;
      applyDiscountButton.textContent = "Checking…";
      try {
        const res = await fetch("/.netlify/functions/check-discount-code", {
          method: "POST",
          body: JSON.stringify({ code: entered }),
        });
        const result = await res.json();
        if (result.valid) {
          appliedDiscount = { type: result.discountType, value: result.value };
          const amountText =
            result.discountType === "fixed"
              ? currencyFormatter.format(result.value) + " off"
              : `${result.value}% off`;
          showDiscountFeedback(`Discount code ${entered} applied — ${amountText}`, "success");
        } else {
          appliedDiscount = null;
          showDiscountFeedback("Code not recognized", "error");
        }
      } catch {
        appliedDiscount = null;
        showDiscountFeedback("Couldn't check that code — try again", "error");
      } finally {
        applyDiscountButton.disabled = false;
        applyDiscountButton.textContent = "Apply";
      }
      updateTotal(parseInt(seatsSelect.value, 10));
    }

    applyDiscountButton.addEventListener("click", applyDiscountCode);
    discountCodeInput.addEventListener("keydown", (event) => {
      if (event.key === "Enter") {
        event.preventDefault();
        applyDiscountCode();
      }
    });
    // Typing after a code was applied invalidates that preview until
    // "Apply" is pressed again — otherwise the discount shown could go
    // stale relative to whatever's now in the field.
    discountCodeInput.addEventListener("input", () => {
      if (appliedDiscount !== null || !discountFeedbackEl.hidden) {
        appliedDiscount = null;
        discountFeedbackEl.hidden = true;
        updateTotal(parseInt(seatsSelect.value, 10));
      }
    });

    // Discount code lives collapsed in the order summary until asked for,
    // so it doesn't take up space in the main form for the common case of
    // nobody having one.
    toggleDiscountButton.addEventListener("click", () => {
      discountCodePanel.hidden = !discountCodePanel.hidden;
      toggleDiscountButton.hidden = !discountCodePanel.hidden;
      if (!discountCodePanel.hidden) discountCodeInput.focus();
    });

    function updateAttendeeBlocks() {
      const seats = parseInt(seatsSelect.value, 10);
      attendeeBlocks.forEach((block, i) => {
        block.hidden = i >= seats;
      });
      updateTotal(seats);
    }

    seatsSelect.addEventListener("change", updateAttendeeBlocks);
    updateAttendeeBlocks();

    // Mirror attendee 1's details into the booking-contact fields until the
    // booker explicitly edits them themselves.
    const attendee1Name = document.getElementById("attendee-name-1") as HTMLInputElement;
    const attendee1Email = document.getElementById("attendee-email-1") as HTMLInputElement;
    const bookerName = document.getElementById("name") as HTMLInputElement;
    const bookerEmail = document.getElementById("email") as HTMLInputElement;
    let bookerNameTouched = false;
    let bookerEmailTouched = false;

    attendee1Name.addEventListener("input", () => {
      if (!bookerNameTouched) bookerName.value = attendee1Name.value;
    });
    attendee1Email.addEventListener("input", () => {
      if (!bookerEmailTouched) bookerEmail.value = attendee1Email.value;
    });
    bookerName.addEventListener("input", () => {
      bookerNameTouched = true;
    });
    bookerEmail.addEventListener("input", () => {
      bookerEmailTouched = true;
    });

    // Intercepted via fetch (rather than a normal form POST) so a
    // successful join can show the inline "you're on the list" message
    // without navigating away — the sold-out registration page is often
    // reached from a bookmarked/shared link, so staying put matters more
    // here than it would for a one-time registration.
    const waitlistForm = document.getElementById("waitlist-form") as HTMLFormElement;
    const waitlistSubmitButton = document.getElementById("waitlist-submit") as HTMLButtonElement;
    const waitlistErrorEl = document.getElementById("waitlist-error") as HTMLParagraphElement;
    const waitlistSuccessEl = document.getElementById("waitlist-success") as HTMLParagraphElement;

    waitlistForm.addEventListener("submit", async (event) => {
      event.preventDefault();
      waitlistErrorEl.hidden = true;
      waitlistSubmitButton.disabled = true;
      waitlistSubmitButton.textContent = "Joining…";

      try {
        const body = new URLSearchParams(new FormData(waitlistForm) as any).toString();
        const res = await fetch("/", {
          method: "POST",
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body,
        });
        if (!res.ok) throw new Error(`Request failed (${res.status})`);

        waitlistForm.hidden = true;
        waitlistSuccessEl.hidden = false;
      } catch {
        waitlistErrorEl.textContent = "Couldn't join the waitlist — check your connection and try again.";
        waitlistErrorEl.hidden = false;
        waitlistSubmitButton.disabled = false;
        waitlistSubmitButton.textContent = "Join the waitlist";
      }
    });
  </script>
</BaseLayout>
