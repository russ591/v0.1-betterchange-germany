---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import RegisterPageContent from "@/components/pages/RegisterPageContent.astro";

export async function getStaticPaths() {
  // Externally-fulfilled sessions (isExternal: true) have no internal
  // registration page at all -- their "Register" links point straight to
  // externalUrl instead (see @/lib/registrationLink), so this page is
  // never linked to for them and shouldn't exist to be found either.
  const sessions = (await getCollection("training-schedules")).filter((s) => !s.data.isExternal);
  return sessions.map((session) => ({
    params: { session: session.id },
    props: { session },
  }));
}

const { session } = Astro.props;
const course = await getEntry(session.data.course);
const category = await getEntry(course.data.category);

// Distinguishes each dated session's <title> from its siblings for the
// same course (previously every session shared one identical title,
// including across genuinely different dates) -- self-paced sessions
// have no date, so location ("Online") already distinguishes those.
const sessionLabel = session.data.date
  ? session.data.date.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" })
  : session.data.location;
---

<BaseLayout
  title={`Register, ${course.data.name}, ${sessionLabel}`}
  description={`Register for ${course.data.name}, ${session.data.format}, ${session.data.location}.`}
  translations={{
    en: `/training/register/${session.id}`,
    de: `/de/training/register/${session.id}`,
  }}
>
  <RegisterPageContent session={session} course={course} category={category} />
</BaseLayout>
