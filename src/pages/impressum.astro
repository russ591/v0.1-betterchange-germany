---
import { getEntry, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";

const entry = await getEntry("legal-pages", "impressum");
const { Content } = await render(entry!);
---

<BaseLayout title="Impressum" description="Legal notice for Better Change Germany.">
  <Breadcrumbs items={[{ label: "Impressum" }]} />

  <Section eyebrow="Legal" heading="Impressum">
    <div class="article-body max-w-2xl text-[length:var(--text-body)] text-neutral-700">
      <Content />
    </div>
  </Section>
</BaseLayout>
