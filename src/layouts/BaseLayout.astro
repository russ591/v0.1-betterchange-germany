---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { resolveLocale } from "@/i18n/utils";
import "@/styles/global.css";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  /** Extra JSON-LD object(s) for this specific page (Course, Article, etc.),
   * rendered alongside the sitewide Organization schema below. */
  jsonLd?: object | object[];
  /** Keeps a page out of search results — the /admin dashboard. */
  noindex?: boolean;
  /** Present only on pages that have a German/English counterpart -- maps
   * each available locale to that locale's absolute path for this same
   * page. Drives both the hreflang tags below and the header's language
   * switcher. Omitted entirely on pages that don't have a translation
   * (Insights, individual coach profile pages, legal pages, ...). */
  translations?: Partial<Record<"en" | "de", string>>;
}

const { title, description, ogImage = "/og-image.png", jsonLd, noindex = false, translations } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const pageTitle = `${title} · Better Change`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
const jsonLdBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

// Real, verifiable facts only -- no invented street address or phone number
// (the Impressum migration still owes us those), no social links beyond
// coaches' individual profiles which aren't the company's own presence.
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Better Change",
  url: Astro.site?.toString(),
  logo: new URL("/logo.png", Astro.site).toString(),
  description:
    "A European network of practitioners delivering agile training, coaching and organisational transformation.",
  email: "office@betterchange-consulting.de",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Berlin",
    addressCountry: "DE",
  },
};
---

<!doctype html>
<html lang={locale === "de" ? "de" : "en-GB"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {
      // hreflang: tells search engines the English and German URLs are
      // linked translations of the same page, not duplicate content.
      // x-default points at English since that's this site's default
      // locale for a visitor with no language preference match.
      translations &&
        Object.entries(translations).map(([lang, href]) => (
          <link rel="alternate" hreflang={lang} href={new URL(href, Astro.site)} />
        ))
    }
    {translations?.en && <link rel="alternate" hreflang="x-default" href={new URL(translations.en, Astro.site)} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Better Change" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={locale === "de" ? "de_DE" : "en_GB"} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} is:inline />
    {jsonLdBlocks.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} is:inline />)}
  </head>
  <body class="flex min-h-screen flex-col bg-surface text-ink">
    <Header translations={translations} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
